---
// CT PRO - Super Admin Panel (Updated)
---
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CT PRO - Admin Panel</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Rajdhani:wght@500;700&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
        :root {
            --gold: #d4af37; --bg: #060608; --card: #0f0f12; --card2: #14141a;
            --border: #1e1e28; --border2: #2a2a38; --success: #22c55e;
            --danger: #ef4444; --text: #e8e8f0; --muted: #666680;
        }
        body { font-family: 'Rajdhani', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; overflow-x: hidden; }
        .container { max-width: 1100px; margin: 0 auto; padding: 16px; position: relative; z-index: 1; }
        .topbar { display: flex; align-items: center; justify-content: space-between; background: var(--card); border: 1px solid var(--border2); border-radius: 12px; padding: 12px 18px; margin-bottom: 20px; }
        .logo-box { background: var(--gold); color: #000; font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; padding: 5px 10px; border-radius: 6px; }
        .tabs { display: flex; gap: 6px; margin-bottom: 20px; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 5px; overflow-x: auto; }
        .tab { flex: 1; min-width: 100px; padding: 9px 14px; border-radius: 7px; border: none; background: transparent; color: var(--muted); font-weight: 700; cursor: pointer; }
        .tab.active { background: var(--gold); color: #000; }
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 20px; }
        .stat-card { background: var(--card); border: 1px solid var(--border2); border-radius: 12px; padding: 14px 16px; }
        .stat-value { font-family: 'JetBrains Mono', monospace; font-size: 26px; font-weight: 700; color: var(--gold); }
        .panel { display: none; }
        .panel.active { display: block; }
        .tbl-wrap { overflow-x: auto; border-radius: 10px; border: 1px solid var(--border); }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        thead th { background: var(--card2); color: var(--gold); padding: 10px 12px; text-align: left; }
        tbody td { padding: 10px 12px; border-bottom: 1px solid var(--border); }
        .action-btn { padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; border: 1px solid; transition: 0.2s; }
        .btn-block { background: rgba(239,68,68,0.1); color: var(--danger); border-color: rgba(239,68,68,0.3); }
        .btn-unblock { background: rgba(34,197,94,0.1); color: var(--success); border-color: rgba(34,197,94,0.3); }
        #loadingScreen { position: fixed; inset: 0; background: var(--bg); z-index: 999; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        #blockScreen { display: none; position: fixed; inset: 0; background: #000; z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: var(--danger); text-align: center; }
        .limit-input { background: var(--bg); border: 1px solid var(--border2); color: var(--gold); width: 60px; text-align: center; border-radius: 6px; padding: 4px; }
    </style>
</head>
<body>

<div id="blockScreen">
    <div style="font-size:80px;">🚫</div>
    <h1>ACCESS DENIED</h1>
    <p>Sirf Admin access kar sakta hai.</p>
</div>

<div id="loadingScreen">
    <div style="font-size: 32px; color: var(--gold); font-family: 'JetBrains Mono'; font-weight: bold;">CT PRO</div>
    <p style="color: var(--muted); margin-top: 10px;">VERIFYING ADMIN STATUS...</p>
</div>

<div class="container" id="adminApp" style="display:none;">
    <div class="topbar">
        <div class="logo-box">CT PRO ADMIN</div>
        <div style="display:flex; gap:8px;">
            <button class="action-btn" onclick="location.href='/'">← Home</button>
            <button class="action-btn btn-block" id="logoutBtn">Logout</button>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat-card"><div style="font-size: 11px;">TOTAL USERS</div><div class="stat-value" id="statUsers">--</div></div>
        <div class="stat-card"><div style="font-size: 11px;">ACTIVE</div><div class="stat-value" id="statActive" style="color:var(--success);">--</div></div>
        <div class="stat-card"><div style="font-size: 11px;">PENDING IDs</div><div class="stat-value" id="statPending" style="color:#f59e0b;">--</div></div>
    </div>

    <div class="tabs">
        <button class="tab active" onclick="switchTab('users')">👥 Users</button>
        <button class="tab" onclick="switchTab('logs')">📋 Logs</button>
        <button class="tab" onclick="switchTab('export')">📥 Export</button>
    </div>

    <div class="panel active" id="panel-users">
        <div class="tbl-wrap">
            <table>
                <thead>
                    <tr><th>Email</th><th>Limit</th><th>Status</th><th>Device</th><th>Action</th></tr>
                </thead>
                <tbody id="userTableBody"></tbody>
            </table>
        </div>
    </div>

    <div class="panel" id="panel-logs">
        <div id="logList"></div>
    </div>

    <div class="panel" id="panel-export" style="padding: 20px; text-align: center;">
        <button class="action-btn" style="background:var(--gold); color:black; padding: 15px 30px; font-size: 16px;" onclick="exportUsers()">📥 DOWNLOAD USER LIST (CSV)</button>
    </div>
</div>

<script is:inline>
window.addEventListener('DOMContentLoaded', async () => {
    const ADMIN_EMAIL = 'agurjeet768@gmail.com';
    const SB_URL = 'https://ihcmbsvsfwakmmmymtxq.supabase.co';
    const SB_KEY = 'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE';
    const GITHUB_RAW = 'https://raw.githubusercontent.com/agurjeet768-tech/loan-dashboard/main/src/pages/pending_ids.json';

    // Wait for Supabase to be defined
    while (typeof window.supabase === 'undefined') { await new Promise(r => setTimeout(r, 100)); }
    const sb = window.supabase.createClient(SB_URL, SB_KEY);

    // Security Check
    const { data: sess } = await sb.auth.getSession();
    if (!sess?.session || sess.session.user.email !== ADMIN_EMAIL) {
        document.getElementById('loadingScreen').style.display = 'none';
        document.getElementById('blockScreen').style.display = 'flex';
        return;
    }

    document.getElementById('loadingScreen').style.display = 'none';
    document.getElementById('adminApp').style.display = 'block';

    // Functions
    async function loadData() {
        const { data: users } = await sb.from('ContractTrack').select('*').order('created_at', {ascending: false});
        if (users) {
            document.getElementById('statUsers').innerText = users.length;
            document.getElementById('statActive').innerText = users.filter(u => !u.is_blocked).length;
            renderUsers(users);
        }

        try {
            const r = await fetch(GITHUB_RAW + '?t=' + Date.now());
            const pData = await r.json();
            document.getElementById('statPending').innerText = Object.keys(pData).length;
        } catch(e) { document.getElementById('statPending').innerText = '0'; }
    }

    function renderUsers(users) {
        const tbody = document.getElementById('userTableBody');
        tbody.innerHTML = users.map(u => `
            <tr>
                <td style="font-weight:bold;">${u.email}</td>
                <td><input type="number" class="limit-input" id="lim-${u.email}" value="${u.limit_left || 0}" onchange="updateLimit('${u.email}', this.value)"></td>
                <td><span style="color:${u.is_blocked ? 'red':'green'}">${u.is_blocked ? 'BLOCKED':'ACTIVE'}</span></td>
                <td style="font-size:10px; color:#666;">${(u.device_id || 'N/A').substring(0,10)}</td>
                <td>
                    <button class="action-btn ${u.is_blocked ? 'btn-unblock':'btn-block'}" onclick="toggleBlock('${u.email}', ${!u.is_blocked})">
                        ${u.is_blocked ? 'Unblock':'Block'}
                    </button>
                </td>
            </tr>
        `).join('');
    }

    window.updateLimit = async (email, val) => {
        await sb.from('ContractTrack').update({ limit_left: parseInt(val) }).eq('email', email);
        alert('Limit Updated for ' + email);
    };

    window.toggleBlock = async (email, status) => {
        await sb.from('ContractTrack').update({ is_blocked: status }).eq('email', email);
        loadData();
    };

    window.switchTab = (name) => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        event.target.classList.add('active');
        document.getElementById('panel-' + name).classList.add('active');
        if(name === 'logs') loadLogs();
    };

    async function loadLogs() {
        const { data: logs } = await sb.from('search_logs').select('*').order('created_at', {ascending: false}).limit(100);
        document.getElementById('logList').innerHTML = logs.map(l => `
            <div style="background:var(--card); padding:10px; border-radius:8px; margin-bottom:5px; border-left:3px solid var(--gold); display:flex; justify-content:space-between;">
                <div><b>${l.search_query}</b><br><small>${l.email}</small></div>
                <div style="font-size:11px; color:var(--muted);">${new Date(l.created_at).toLocaleString('en-IN')}</div>
            </div>
        `).join('');
    }

    window.exportUsers = async () => {
        const { data } = await sb.from('ContractTrack').select('*');
        const csv = "Email,Limit,Blocked\n" + data.map(u => `${u.email},${u.limit_left},${u.is_blocked}`).join("\n");
        const blob = new Blob([csv], { type: 'text/csv' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `CT_Users_${new Date().toISOString().slice(0,10)}.csv`;
        a.click();
    };

    document.getElementById('logoutBtn').onclick = async () => { await sb.auth.signOut(); location.href='/'; };

    loadData();
});
</script>
</body>
</html>
