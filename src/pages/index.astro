---
// index.astro
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ContractTrack - Professional Lookup</title>
    <style>
        :root {
            --gold: #d4af37;
            --dark-bg: #121212;
            --card-bg: #1e1e1e;
            --text-main: #ffffff;
            --text-sub: #a0a0a0;
            --border: #2d2d2d;
            --success: #22c55e;
        }

        body { 
            font-family: 'Inter', system-ui, sans-serif; 
            background-color: var(--dark-bg); 
            color: var(--text-main);
            margin: 0;
            padding: 15px;
        }

        .container { max-width: 800px; margin: 0 auto; }

        /* Header */
        .header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 25px;
            padding: 10px 0;
        }
        .logo-box { background: var(--gold); color: black; padding: 8px; border-radius: 8px; font-weight: 900; }

        /* Search Input Area */
        .search-container {
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
            margin-bottom: 20px;
        }
        label { display: block; margin-bottom: 10px; font-size: 13px; color: var(--gold); font-weight: 600; text-transform: uppercase; }
        textarea {
            width: 100%;
            background: #121212;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: white;
            padding: 12px;
            font-family: inherit;
            margin-bottom: 12px;
            box-sizing: border-box;
            outline: none;
        }
        textarea:focus { border-color: var(--gold); }
        .btn-fetch {
            width: 100%;
            background: var(--gold);
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-weight: 800;
            cursor: pointer;
            text-transform: uppercase;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 25px;
        }
        .stat-card {
            background: var(--card-bg);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }
        .stat-card small { color: var(--text-sub); font-size: 11px; text-transform: uppercase; display: block; }
        .stat-card div { font-size: 22px; font-weight: 800; margin-top: 5px; color: var(--gold); }

        /* Table Section */
        .table-wrapper {
            background: var(--card-bg);
            border-radius: 12px;
            border: 1px solid var(--border);
            overflow-x: auto;
        }
        table { width: 100%; border-collapse: collapse; min-width: 600px; }
        th { background: #252525; padding: 12px; text-align: left; font-size: 11px; color: var(--gold); text-transform: uppercase; }
        td { padding: 14px 12px; border-bottom: 1px solid var(--border); font-size: 13px; }
        .today-mark { background: rgba(34, 197, 94, 0.1); color: var(--success); font-weight: bold; }
        
        .loading { display: none; text-align: center; padding: 20px; color: var(--gold); font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo-box">CT</div>
            <h2 style="margin:0; font-size: 1.4rem;">ContractTrack Pro</h2>
        </div>

        <div class="search-container">
            <label>Contract Numbers Enter Karein</label>
            <textarea id="contractsInput" rows="4" placeholder="Example: 10521258, 9631990, 8703919"></textarea>
            <button id="fetchBtn" class="btn-fetch">Fetch Receipts</button>
        </div>

        <div id="loader" class="loading">Processing API Requests...</div>

        <div class="stats-grid">
            <div class="stat-card"><small>Total Processed</small><div id="totalCount">0</div></div>
            <div class="stat-card"><small>Total Amount</small><div id="totalAmount">₹0</div></div>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Contract No</th>
                        <th>Customer Name</th>
                        <th>Date Received</th>
                        <th>Receipt No</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody id="resultsBody">
                    </tbody>
            </table>
        </div>
    </div>

    <script>
        const fetchBtn = document.getElementById('fetchBtn');
        const inputField = document.getElementById('contractsInput');
        const resultsBody = document.getElementById('resultsBody');
        const loader = document.getElementById('loader');
        const totalCountDisp = document.getElementById('totalCount');
        const totalAmountDisp = document.getElementById('totalAmount');

        fetchBtn.addEventListener('click', async () => {
            const rawValue = inputField.value.trim();
            if (!rawValue) return alert("Please enter contract numbers!");

            // UI Updates
            loader.style.display = 'block';
            resultsBody.innerHTML = '';
            fetchBtn.innerText = "FETCHING...";
            fetchBtn.disabled = true;

            try {
                const response = await fetch(`https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${encodeURIComponent(rawValue)}`);
                const data = await response.json();

                let html = '';
                let totalAmt = 0;
                const today = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');

                data.forEach(item => {
                    // Amount ko number mein badalna (comma hata kar)
                    const amtValue = parseFloat(item.amount.toString().replace(/,/g, '')) || 0;
                    totalAmt += amtValue;

                    const isToday = item.date === today;
                    
                    html += `
                        <tr class="${isToday ? 'today-mark' : ''}">
                            <td>${item.contract}</td>
                            <td style="font-weight:600;">${item.name}</td>
                            <td>${isToday ? 'TODAY' : item.date}</td>
                            <td style="color:var(--text-sub);">${item.receipt_no}</td>
                            <td style="color:var(--gold); font-weight:800;">₹${item.amount}</td>
                        </tr>
                    `;
                });

                resultsBody.innerHTML = html || '<tr><td colspan="5" style="text-align:center;">No data found.</td></tr>';
                totalCountDisp.innerText = data.length;
                totalAmountDisp.innerText = '₹' + totalAmt.toLocaleString('en-IN');

            } catch (err) {
                alert("API Error! Check your Hugging Face Space.");
                console.error(err);
            } finally {
                loader.style.display = 'none';
                fetchBtn.innerText = "FETCH RECEIPTS";
                fetchBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
