<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ContractTrack Pro</title>
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0; padding: 0; }
        :root { --gold: #d4af37; --bg: #000; --card: #151515; --border: #222; --success: #22c55e; --red: #ff4444; }
        body { font-family: Arial, sans-serif; background: var(--bg); color: #fff; padding: 12px; overflow-x: hidden; }
        .container { max-width: 800px; margin: 0 auto; width: 100%; }
        .header { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; }
        .logo { background: var(--gold); color: #000; padding: 4px 8px; border-radius: 4px; font-weight: 900; }
        .input-card { background: var(--card); padding: 12px; border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 15px; }
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-family: monospace; font-size: 14px; resize: vertical; }
        textarea:focus { outline: none; border-color: var(--gold); }
        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 14px; border-radius: 8px; font-weight: 900; cursor: pointer; margin-top: 10px; text-transform: uppercase; font-size: 15px; }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }
        .report-box { background: #0c0c0c; border: 1px solid #333; padding: 12px; border-radius: 10px; margin-bottom: 15px; font-size: 13px; }
        .report-header { color: var(--gold); font-weight: bold; margin-bottom: 8px; border-bottom: 1px dashed #333; padding-bottom: 5px; font-size: 12px; text-transform: uppercase; }
        .report-stats { display: flex; justify-content: space-between; margin-bottom: 8px; }
        .failed-badge { background: rgba(255,77,77,0.1); color: #ff4d4d; border: 1px solid #ff4d4d; padding: 3px 6px; border-radius: 4px; font-size: 11px; margin: 2px; display: inline-block; font-family: monospace; }
        .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; }
        .s-card { background: var(--card); padding: 12px; border-radius: 10px; border: 2px solid var(--gold); text-align: center; }
        .s-card small { color: var(--gold); font-size: 10px; text-transform: uppercase; font-weight: bold; }
        .filters-container { display: grid; grid-template-columns: 2fr 1fr; gap: 10px; margin-bottom: 10px; }
        .filter-input { width: 100%; background: var(--card); border: 2px solid var(--gold); color: #fff; padding: 12px; border-radius: 8px; font-size: 14px; outline: none; }
        input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; }
        .section-title { color: var(--gold); font-size: 14px; font-weight: 900; margin: 20px 0 10px 0; text-transform: uppercase; border-bottom: 1px dashed var(--gold); padding-bottom: 8px; }
        .item-card { background: var(--card); border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 12px; overflow: hidden; }
        .item-main { padding: 14px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; cursor: pointer; }
        .deep-details { padding: 15px; background: #080808; border-top: 1px dashed var(--gold); font-size: 13px; }
        .d-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid #1a1a1a; }
        .d-row:last-child { border-bottom: none; }
        .d-row b { color: var(--gold); text-align: right; }
        .today-badge { background: var(--success); color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 900; display: inline-block; }
        .date-text { color: var(--success); font-weight: bold; font-size: 13px; text-align: center; }
        .loader { display: none; text-align: center; color: var(--gold); padding: 20px; font-weight: bold; }
        .share-btn { width: 100%; margin-top: 12px; background: var(--gold); color: #000; font-weight: 900; border: none; padding: 12px; border-radius: 6px; cursor: pointer; text-transform: uppercase; }
        .auth-wrapper { display: flex; justify-content: center; align-items: center; min-height: 90vh; }
        .auth-card { width: 100%; max-width: 400px; background: var(--card); border: 2px solid var(--gold); border-radius: 20px; padding: 30px 25px; text-align: center; }
        .auth-input { width: 100%; padding: 14px; margin-top: 12px; border-radius: 10px; border: 1px solid #444; background: #000; color: #fff; font-size: 16px; outline: none; display: block; }
        .auth-input:focus { border-color: var(--gold); }
        .msg { margin-top: 14px; padding: 12px; border-radius: 8px; font-size: 14px; display: none; text-align: left; }
        .msg.error { background: #2a0000; color: #ff6666; border: 1px solid #ff3333; }
        .msg.success { background: #002a10; color: #00ff99; border: 1px solid #00ff99; }
        .top-nav { display: flex; justify-content: space-between; align-items: center; background: #0a0a0a; padding: 15px; border-radius: 12px; border: 1px solid #333; margin-bottom: 20px; font-size: 13px; }
        .limit-badge { background: #002a10; color: var(--success); padding: 4px 8px; border-radius: 5px; font-weight: bold; border: 1px solid var(--success); }
        .admin-box { display: none; margin-bottom: 20px; padding: 14px 18px; border: 1px solid rgba(212,175,55,0.4); border-radius: 12px; background: #0d0b00; }
        .admin-box-inner { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
        .logout-btn { background: var(--red); color: #fff; border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 13px; }
        .admin-goto-btn { background: var(--gold); color: #000; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 900; font-size: 13px; cursor: pointer; }
        #blockScreen { display: none; position: fixed; inset: 0; background: #000; z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: var(--red); text-align: center; gap: 12px; }
        .spinner { display: inline-block; width: 20px; height: 20px; border: 3px solid #333; border-top-color: var(--gold); border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: middle; margin-right: 8px; }
        @keyframes spin { to { transform: rotate(360deg); } }
        @media (max-width: 480px) {
            .item-main { grid-template-columns: 1.2fr 1fr 1fr; gap: 5px; padding: 10px; }
            .filters-container { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<!-- BLOCK SCREEN -->
<div id="blockScreen">
    <div style="font-size:80px;">🚫</div>
    <h2>ACCESS DENIED</h2>
    <p>Aapka account block hai.</p>
</div>

<!-- AUTH PAGE -->
<div class="container" id="authSection">
    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="logo" style="font-size:28px; display:inline-block; margin-bottom:16px; padding: 8px 14px;">CT PRO</div>
            <p id="authHeading" style="color:#888; font-size:14px; margin-bottom:8px;">Security Verification</p>

            <input type="email" id="emailInput" class="auth-input" placeholder="📧 Email Address">
            <input type="password" id="passInput" class="auth-input" placeholder="🔒 Password">

            <div id="msgBox" class="msg"></div>

            <button id="submitBtn" class="btn" style="margin-top:16px;">ENTER SYSTEM</button>

            <p style="margin-top:18px; font-size:14px; color:#666;">
                <span id="toggleText">Naye user hain?</span>
                <button id="toggleBtn" style="background:none; border:none; color:var(--gold); cursor:pointer; font-size:14px; font-weight:bold; text-decoration:underline; padding:0; margin-left:4px;">Register Karein</button>
            </p>
        </div>
    </div>
</div>

<!-- MAIN APP -->
<div class="container" id="mainApp" style="display:none;">

    <div class="top-nav">
        <div>
            <div style="color:#888; font-size:11px;">Logged in:</div>
            <div id="dispEmail" style="font-weight:bold; font-size:13px;"></div>
            <div style="margin-top:4px;">
                <span style="color:#888; font-size:11px;">Limit: </span>
                <span id="dispLimit" class="limit-badge">0</span>
            </div>
        </div>
        <button class="logout-btn" id="logoutBtn">LOGOUT</button>
    </div>

    <div class="admin-box" id="adminBox">
        <div class="admin-box-inner">
            <div>
                <div style="color:var(--gold); font-weight:900; font-size:14px;">👑 Admin Control Panel</div>
                <div style="color:#666; font-size:12px; margin-top:3px;">Users, Logs, Pending IDs manage karo</div>
            </div>
            <button class="admin-goto-btn" id="adminBtn">🔐 Open Admin Panel</button>
        </div>
    </div>

    <div class="header">
        <div class="logo">CT</div>
        <h2 style="margin:0; font-size:20px;">ContractTrack Pro</h2>
    </div>

    <div class="input-card">
        <textarea id="contractsInput" rows="4" placeholder="Contract numbers daalo (ek line mein ek)&#10;Example:&#10;MFL123456&#10;MFL789012"></textarea>
        <button class="btn" id="fetchBtn">FETCH ALL RECEIPTS</button>
    </div>

    <div id="loader" class="loader"><span class="spinner"></span>DATA FETCH HO RAHA HAI...</div>

    <div id="fetchReport" class="report-box" style="display:none;">
        <div class="report-header">📊 Fetch Report</div>
        <div class="report-stats">
            <div>Total: <b id="repTotal">0</b></div>
            <div>✅ Success: <b id="repSuccess" style="color:var(--success);">0</b></div>
            <div>❌ Failed: <b id="repFailed" style="color:#ff4d4d;">0</b></div>
        </div>
        <div id="failedBox" style="display:none; margin-top:6px; padding-top:8px; border-top:1px solid #222;">
            <div style="color:#888; font-size:11px; margin-bottom:5px;">Ye IDs nahi mile:</div>
            <div id="failedList"></div>
        </div>
    </div>

    <div class="stats">
        <div class="s-card">
            <small>Records</small>
            <div id="tCount" style="font-size:22px; font-weight:bold; margin-top:5px;">0</div>
        </div>
        <div class="s-card">
            <small>Total Amount</small>
            <div id="tAmt" style="font-size:22px; font-weight:bold; color:var(--success); margin-top:5px;">₹0</div>
        </div>
    </div>

    <div class="filters-container">
        <input type="text" id="searchInput" class="filter-input" placeholder="🔍 Name ya Contract search karo...">
        <input type="date" id="dateFilter" class="filter-input">
    </div>

    <div id="todaySection" style="display:none;">
        <div class="section-title">⭐ Aaj ke Payments</div>
        <div id="todayResults"></div>
    </div>

    <div id="otherSection" style="display:none;">
        <div class="section-title">📂 Purane Records</div>
        <div id="otherResults"></div>
    </div>

</div>

<!-- SUPABASE CDN -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>

<script is:inline>
(function() {

    // ── CONFIG ──────────────────────────────────────────
    var ADMIN_EMAIL = 'agurjeet768@gmail.com';
    var SB_URL      = 'https://ihcmbsvsfwakmmmymtxq.supabase.co';
    var SB_KEY      = 'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE';
    var HF_URL      = 'https://gauravkumar80500-loandataapi.hf.space/scrape_custom';

    var sb          = null;
    var loginMode   = true;
    var fpId        = 'fp-' + Date.now();
    window._records = [];

    // ── WAIT FOR SUPABASE ────────────────────────────────
    function tryInit() {
        if (window.supabase && window.supabase.createClient) {
            sb = window.supabase.createClient(SB_URL, SB_KEY);
            bindAll();
            checkSession();
        } else {
            setTimeout(tryInit, 200);
        }
    }

    // ── BIND ALL BUTTONS ────────────────────────────────
    function bindAll() {
        gel('submitBtn').onclick  = doAuth;
        gel('toggleBtn').onclick  = toggleMode;
        gel('logoutBtn').onclick  = doLogout;
        gel('fetchBtn').onclick   = doFetch;
        gel('adminBtn').onclick   = function() { window.location.href = '/admin'; };
        gel('searchInput').oninput  = applyFilters;
        gel('dateFilter').onchange  = applyFilters;

        // Enter key support
        gel('passInput').onkeydown = function(e) {
            if (e.key === 'Enter') doAuth();
        };
        gel('emailInput').onkeydown = function(e) {
            if (e.key === 'Enter') gel('passInput').focus();
        };

        // Fingerprint (optional - won't block if fails)
        try {
            var fpScript = document.createElement('script');
            fpScript.src = 'https://openfpcdn.io/fingerprintjs/v4';
            fpScript.onload = function() {
                FingerprintJS.load().then(function(fp) {
                    return fp.get();
                }).then(function(r) {
                    fpId = r.visitorId;
                }).catch(function(){});
            };
            document.head.appendChild(fpScript);
        } catch(e) {}
    }

    // ── HELPER: getElementById shortcut ─────────────────
    function gel(id) { return document.getElementById(id); }

    // ── SHOW / HIDE MESSAGE ──────────────────────────────
    function showMsg(type, text) {
        var el = gel('msgBox');
        el.className = 'msg ' + type;
        el.innerText = text;
        el.style.display = 'block';
    }
    function hideMsg() {
        var el = gel('msgBox');
        if (el) { el.style.display = 'none'; el.innerText = ''; }
    }

    // ── TOGGLE LOGIN / REGISTER ──────────────────────────
    function toggleMode() {
        loginMode = !loginMode;
        hideMsg();
        gel('authHeading').innerText  = loginMode ? 'Security Verification' : 'Naya Account Banayein';
        gel('submitBtn').innerText    = loginMode ? 'ENTER SYSTEM' : 'REGISTER KAREIN';
        gel('toggleText').innerText   = loginMode ? 'Naye user hain?' : 'Pehle se account hai?';
        gel('toggleBtn').innerText    = loginMode ? 'Register Karein' : 'Login Karein';
    }

    // ── AUTH ─────────────────────────────────────────────
    async function doAuth() {
        var email = gel('emailInput').value.trim();
        var pass  = gel('passInput').value.trim();
        var btn   = gel('submitBtn');

        if (!email || !pass) {
            showMsg('error', '⚠️ Email aur Password dono zaruri hain!');
            return;
        }
        if (!email.includes('@')) {
            showMsg('error', '⚠️ Sahi email format likho!');
            return;
        }

        hideMsg();
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>Wait...';

        try {
            if (loginMode) {
                var res = await sb.auth.signInWithPassword({ email: email, password: pass });
                if (res.error) throw res.error;
                var ip = await getIP();
                await sb.from('ContractTrack').update({ device_id: fpId, last_ip: ip }).eq('email', email);
                showMsg('success', '✅ Login ho gaya!');
                setTimeout(checkSession, 600);
            } else {
                var res2 = await sb.auth.signUp({ email: email, password: pass });
                if (res2.error) throw res2.error;
                var ip2 = await getIP();
                await sb.from('ContractTrack').upsert(
                    { email: email, device_id: fpId, last_ip: ip2, limit_left: 10, is_blocked: false },
                    { onConflict: 'email' }
                );
                showMsg('success', '✅ Account ban gaya! Ab login karein.');
                // Switch to login mode
                loginMode = true;
                gel('authHeading').innerText = 'Security Verification';
                gel('submitBtn').innerText   = 'ENTER SYSTEM';
                gel('toggleText').innerText  = 'Naye user hain?';
                gel('toggleBtn').innerText   = 'Register Karein';
            }
        } catch(err) {
            var m = (err && err.message) ? err.message : 'Error aa gaya!';
            if (m.includes('Invalid login') || m.includes('invalid'))  m = '❌ Email ya Password galat hai!';
            if (m.includes('already registered'))  m = '⚠️ Ye email pehle se registered hai!';
            if (m.includes('Password should'))  m = '⚠️ Password kam se kam 6 characters ka hona chahiye!';
            showMsg('error', m);
        } finally {
            btn.disabled = false;
            btn.innerText = loginMode ? 'ENTER SYSTEM' : 'REGISTER KAREIN';
        }
    }

    // ── SESSION CHECK ─────────────────────────────────────
    async function checkSession() {
        try {
            var res = await sb.auth.getSession();
            if (res.data && res.data.session) {
                var uEmail = res.data.session.user.email;
                gel('authSection').style.display = 'none';
                gel('mainApp').style.display = 'block';
                gel('dispEmail').innerText = uEmail;
                if (uEmail === ADMIN_EMAIL) gel('adminBox').style.display = 'block';

                var db = await sb.from('ContractTrack').select('*').eq('email', uEmail).single();
                if (db.data) {
                    gel('dispLimit').innerText = db.data.limit_left !== null ? db.data.limit_left : 0;
                    if (db.data.is_blocked) gel('blockScreen').style.display = 'flex';
                }
            } else {
                gel('authSection').style.display = 'block';
                gel('mainApp').style.display = 'none';
            }
        } catch(e) { console.log('Session err:', e); }
    }

    // ── LOGOUT ────────────────────────────────────────────
    function doLogout() {
        sb.auth.signOut().then(function() { location.reload(); });
    }

    // ── GET IP ────────────────────────────────────────────
    function getIP() {
        return fetch('https://api.ipify.org?format=json')
            .then(function(r) { return r.json(); })
            .then(function(d) { return d.ip; })
            .catch(function() { return 'N/A'; });
    }

    // ── HELPERS ───────────────────────────────────────────
    function gv(obj, key) {
        if (!obj) return 'N/A';
        var k = Object.keys(obj).find(function(x) {
            return x.toLowerCase() === key.toLowerCase();
        });
        return (k !== undefined && obj[k] !== null && obj[k] !== undefined) ? obj[k] : 'N/A';
    }

    function cv(val) {
        var s = String(val).toLowerCase();
        return (!val || s === 'null' || s === 'undefined' || s === 'n/a') ? 'N/A' : val;
    }

    function fmtDate(s) {
        if (!s) return '';
        var m = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
        var p = s.split('-');
        if (p.length < 3) return '';
        return p[2] + '-' + m[parseInt(p[1]) - 1] + '-' + p[0];
    }

    // ── CARD TOGGLE ───────────────────────────────────────
    window.toggleCard = function(i) {
        var d  = gel('det-' + i);
        var ic = gel('icon-' + i);
        if (!d) return;
        if (d.style.display === 'none') { d.style.display = 'block'; if(ic) ic.innerText = '▲'; }
        else { d.style.display = 'none'; if(ic) ic.innerText = '▼'; }
    };

    // ── SHARE ─────────────────────────────────────────────
    window.shareCard = function(i) {
        var item = window._records[i];
        if (!item) return;
        var txt =
            '*ContractTrack Pro*\n' +
            '👤 Name: ' + gv(item,'name') + '\n' +
            '📝 Contract: ' + gv(item,'contract') + '\n' +
            '📱 Mobile: ' + gv(item,'mobile') + '\n' +
            '💰 Amount: ₹' + gv(item,'amount') + '\n' +
            '📅 Date: ' + gv(item,'date') + '\n' +
            '🧾 Receipt: ' + gv(item,'receipt_no');
        if (navigator.share) {
            navigator.share({ title: 'CT Pro', text: txt }).catch(function(){});
        } else {
            navigator.clipboard.writeText(txt).then(function() { alert('Copied!'); });
        }
    };

    // ── FILTERS ───────────────────────────────────────────
    function applyFilters() {
        var term = gel('searchInput').value.toLowerCase();
        var selD = fmtDate(gel('dateFilter').value);
        var cnt = 0, amt = 0;
        window._records.forEach(function(item, i) {
            var card = gel('card-' + i);
            if (!card) return;
            var ok = card.innerText.toLowerCase().indexOf(term) !== -1;
            var dOk = !selD || gv(item,'date') === selD;
            if (ok && dOk) {
                card.style.display = 'block';
                cnt++;
                amt += parseFloat(String(gv(item,'amount')).replace(/,/g,'')) || 0;
            } else {
                card.style.display = 'none';
            }
        });
        gel('tCount').innerText = cnt;
        gel('tAmt').innerText   = '₹' + amt.toLocaleString('en-IN');
    }

    // ── MAIN FETCH ────────────────────────────────────────
    async function doFetch() {
        var raw = gel('contractsInput').value.trim();
        if (!raw) { alert('Pehle contract numbers daalo!'); return; }

        var btn = gel('fetchBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>FETCHING...';
        gel('loader').style.display = 'block';
        gel('fetchReport').style.display = 'none';
        gel('todaySection').style.display = 'none';
        gel('otherSection').style.display = 'none';
        gel('todayResults').innerHTML = '';
        gel('otherResults').innerHTML = '';

        try {
            var arr  = raw.split('\n').map(function(s){ return s.trim(); }).filter(Boolean);
            var uniq = arr.filter(function(v,i,a){ return a.indexOf(v)===i; });
            var need = uniq.length;

            // Session check
            var sess = await sb.auth.getSession();
            if (!sess.data || !sess.data.session) throw new Error('Login karein pehle!');
            var email = sess.data.session.user.email;

            // User DB check
            var uDb = await sb.from('ContractTrack').select('*').eq('email', email).single();
            if (uDb.error || !uDb.data) throw new Error('Database error!');
            if (uDb.data.is_blocked) { gel('blockScreen').style.display = 'flex'; return; }

            var lim = uDb.data.limit_left !== null ? parseInt(uDb.data.limit_left) : 0;
            if (lim < need) throw new Error('Limit khatam! Chahiye: ' + need + ', Bachi: ' + lim);

            // HF API call
            var apiR = await fetch(HF_URL + '?contracts=' + uniq.join(','));
            if (!apiR.ok) throw new Error('API Down! Status: ' + apiR.status);
            var data = await apiR.json();
            window._records = Array.isArray(data) ? data : [];

            // Update limit
            var newLim = lim - need;
            gel('dispLimit').innerText = newLim;

            // Save logs
            try {
                var logs = uniq.map(function(id) {
                    return { email: email, search_query: id, device_id: fpId };
                });
                await sb.from('search_logs').insert(logs);
                await sb.from('ContractTrack').update({ limit_left: newLim }).eq('email', email);
            } catch(e) { console.log('Log err:', e); }

            // Report
            var fetched = window._records.map(function(x){ return String(gv(x,'contract')).trim(); });
            var failed  = uniq.filter(function(id){ return fetched.indexOf(String(id).trim()) === -1; });

            gel('repTotal').innerText   = uniq.length;
            gel('repSuccess').innerText = window._records.length;
            gel('repFailed').innerText  = failed.length;

            if (failed.length > 0) {
                gel('failedBox').style.display = 'block';
                gel('failedList').innerHTML = failed.map(function(id){
                    return '<span class="failed-badge">' + id + '</span>';
                }).join('');
            } else {
                gel('failedBox').style.display = 'none';
            }
            gel('fetchReport').style.display = 'block';

            // Build cards
            var todayStr = new Date().toLocaleDateString('en-GB', {
                day:'2-digit', month:'short', year:'numeric'
            }).toUpperCase().replace(/ /g, '-');

            var tHtml = '', oHtml = '';

            window._records.forEach(function(item, i) {
                var nm  = gv(item,'name');
                var ct  = gv(item,'contract');
                var dt  = gv(item,'date');
                var am  = gv(item,'amount');
                var mo  = gv(item,'mobile');
                var em  = gv(item,'emi_amount');
                var ov  = gv(item,'overdue');
                var gn  = gv(item,'gu_name');
                var gm  = gv(item,'gu_mobile');
                var cn  = gv(item,'co_name');
                var cm  = gv(item,'co_mobile');
                var rc  = gv(item,'receipt_no');
                var ins = gv(item,'instr');
                var isT = (dt === todayStr);
                var emiT = (em !== 'N/A') ? '₹' + em : 'N/A';
                var ovT  = (cv(ov) !== 'N/A') ? '₹' + ov : '₹0';
                var dDisp = isT
                    ? '<span class="today-badge">TODAY ✅</span>'
                    : '<div class="date-text" style="font-size:11px;">' + (dt !== 'N/A' ? dt : '-') + '</div>';

                var card =
                    '<div class="item-card" id="card-' + i + '">' +
                        '<div class="item-main" onclick="toggleCard(' + i + ')">' +
                            '<div>' +
                                '<div style="font-weight:bold;font-size:15px;">' + nm + '</div>' +
                                '<div style="color:var(--gold);font-size:12px;margin-top:3px;font-weight:bold;">' + ct + '</div>' +
                            '</div>' +
                            '<div style="text-align:center;padding:0 8px;">' + dDisp + '</div>' +
                            '<div style="text-align:right;">' +
                                '<div style="color:var(--gold);font-weight:bold;font-size:17px;">₹' + am + '</div>' +
                                '<div style="font-size:11px;color:#777;margin-top:5px;">' +
                                    'Details <span id="icon-' + i + '">▼</span>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                        '<div id="det-' + i + '" class="deep-details" style="display:none;">' +
                            '<div class="d-row"><span>📱 Cust Mobile</span><b>' + mo + '</b></div>' +
                            '<div class="d-row"><span>💳 EMI Amount</span><b style="color:var(--success);">' + emiT + '</b></div>' +
                            '<div class="d-row"><span>⚠️ Over Dues</span><b style="color:#ff4d4d;">' + ovT + '</b></div>' +
                            '<div class="d-row"><span>👤 Guarantor</span><b>' + gn + '</b></div>' +
                            '<div class="d-row"><span>📱 GU Mobile</span><b>' + gm + '</b></div>' +
                            '<div class="d-row"><span>👥 Co-Applicant</span><b>' + cn + '</b></div>' +
                            '<div class="d-row"><span>📱 Co-App Mobile</span><b>' + cm + '</b></div>' +
                            '<div class="d-row"><span>🧾 Receipt No</span><b style="color:#aaa;">' + rc + '</b></div>' +
                            '<div class="d-row"><span>📋 Type</span><b style="color:#aaa;">' + ins + '</b></div>' +
                            '<button class="share-btn" onclick="shareCard(' + i + ')">🔗 Share Details</button>' +
                        '</div>' +
                    '</div>';

                if (isT) tHtml += card; else oHtml += card;
            });

            if (!tHtml) {
                tHtml = '<div style="text-align:center;padding:16px;color:#666;background:var(--card);border-radius:10px;border:1px dashed var(--gold);margin-bottom:12px;">⏳ Aaj koi payment nahi aaya abhi tak.</div>';
            }

            gel('todayResults').innerHTML = tHtml;
            gel('otherResults').innerHTML = oHtml;
            gel('todaySection').style.display = 'block';
            if (oHtml) gel('otherSection').style.display = 'block';

            applyFilters();

        } catch(err) {
            console.error('Fetch error:', err);
            alert('❌ Error: ' + (err.message || err));
        } finally {
            gel('loader').style.display = 'none';
            btn.disabled = false;
            btn.innerText = 'FETCH ALL RECEIPTS';
        }
    }

    // ── START ─────────────────────────────────────────────
    tryInit();

})();
</script>

</body>
</html>
