<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ContractTrack Pro</title>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="https://openfpcdn.io/fingerprintjs/v4"></script>

    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        :root { --gold: #d4af37; --bg: #000; --card: #151515; --border: #222; --success: #22c55e; --red: #ff4444; }

        body { font-family: 'Inter', sans-serif; background: var(--bg); color: #fff; margin: 0; padding: 12px; overflow-x: hidden; }
        .container { max-width: 800px; margin: 0 auto; width: 100%; }

        .header { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; }
        .logo { background: var(--gold); color: #000; padding: 4px 8px; border-radius: 4px; font-weight: 900; }

        .input-card { background: var(--card); padding: 12px; border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 15px; width: 100%; }
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-family: monospace; font-size: 14px; resize: vertical; }
        textarea:focus { outline: none; border-color: var(--gold); }

        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 14px; border-radius: 8px; font-weight: 900; cursor: pointer; margin-top: 10px; text-transform: uppercase; font-size: 15px; touch-action: manipulation; transition: transform 0.1s; }
        .btn:active { transform: scale(0.98); }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }

        .report-box { background: #0c0c0c; border: 1px solid #333; padding: 12px; border-radius: 10px; margin-bottom: 15px; font-size: 13px; }
        .report-header { color: var(--gold); font-weight: bold; margin-bottom: 8px; border-bottom: 1px dashed #333; padding-bottom: 5px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
        .report-stats { display: flex; justify-content: space-between; margin-bottom: 8px; }
        .failed-badge { background: rgba(255,77,77,0.1); color: #ff4d4d; border: 1px solid #ff4d4d; padding: 3px 6px; border-radius: 4px; font-size: 11px; margin: 2px 2px 0 0; display: inline-block; font-family: monospace; }

        .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; width: 100%; }
        .s-card { background: var(--card); padding: 12px; border-radius: 10px; border: 2px solid var(--gold); text-align: center; }
        .s-card small { color: var(--gold); font-size: 10px; text-transform: uppercase; font-weight: bold; }

        .filters-container { display: grid; grid-template-columns: 2fr 1fr; gap: 10px; margin-bottom: 10px; }
        .filter-input { width: 100%; background: var(--card); border: 2px solid var(--gold); color: #fff; padding: 12px; border-radius: 8px; font-size: 14px; outline: none; transition: 0.3s; }
        .filter-input:focus { box-shadow: 0 0 5px rgba(212,175,55,0.5); }
        input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; }

        .section-title { color: var(--gold); font-size: 14px; font-weight: 900; margin: 20px 0 10px 0; text-transform: uppercase; border-bottom: 1px dashed var(--gold); padding-bottom: 8px; letter-spacing: 0.5px; }

        .item-card { background: var(--card); border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 12px; width: 100%; overflow: hidden; box-shadow: 0 4px 10px rgba(212,175,55,0.12); }
        .item-main { padding: 14px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; cursor: pointer; touch-action: manipulation; }
        .item-main:active { background: #1a1a1a; }

        .deep-details { padding: 15px; background: #080808; border-top: 1px dashed var(--gold); font-size: 13px; }
        .d-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid #1a1a1a; }
        .d-row:last-child { border-bottom: none; }
        .d-row b { color: var(--gold); text-align: right; }

        .today-badge { background: var(--success); color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 900; display: inline-block; }
        .date-text { color: var(--success); font-weight: bold; font-size: 13px; text-align: center; }

        .loader { display: none; text-align: center; color: var(--gold); padding: 20px; font-weight: bold; letter-spacing: 1px; }
        .toggle-icon { font-size: 12px; color: var(--gold); margin-left: 5px; }
        .share-btn { width: 100%; margin-top: 12px; background: var(--gold); color: #000; font-weight: 900; border: none; padding: 12px; border-radius: 6px; cursor: pointer; text-transform: uppercase; touch-action: manipulation; }

        .auth-wrapper { display: flex; justify-content: center; align-items: center; min-height: 90vh; }
        .auth-card-inner { width: 100%; max-width: 400px; background: var(--card); border: 1px solid var(--gold); border-radius: 20px; padding: 25px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
        .auth-input { width: 100%; padding: 14px; margin-top: 10px; border-radius: 10px; border: 1px solid #333; background: black; color: white; font-size: 16px; outline: none; }
        .auth-input:focus { border-color: var(--gold); }
        .msg { margin-top: 12px; padding: 10px; border-radius: 8px; font-size: 14px; display: none; }
        .msg.error { background: #2a0000; color: #ff6666; border: 1px solid #ff3333; }
        .msg.success { background: #002a10; color: #00ff99; border: 1px solid #00ff99; }

        #blockScreen { display: none; position: fixed; inset: 0; background: black; z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: var(--red); text-align: center; gap: 12px; }

        .top-nav { display: flex; justify-content: space-between; align-items: center; background: #0a0a0a; padding: 15px; border-radius: 12px; border: 1px solid #333; margin-bottom: 20px; font-size: 13px; }
        .limit-badge { background: #002a10; color: var(--success); padding: 4px 8px; border-radius: 5px; font-weight: bold; border: 1px solid var(--success); }

        .admin-panel { display: none; margin-bottom: 20px; padding: 14px 18px; border: 1px solid rgba(212,175,55,0.4); border-radius: 12px; background: #0d0b00; }
        .admin-panel-inner { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
        .admin-title { color: var(--gold); font-weight: 900; font-size: 14px; }
        .admin-sub { color: #666; font-size: 12px; margin-top: 3px; }
        .admin-goto-btn { background: var(--gold); color: #000; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 900; font-size: 13px; cursor: pointer; text-transform: uppercase; white-space: nowrap; }

        @media (max-width: 480px) {
            .item-main { grid-template-columns: 1.2fr 1fr 1fr; gap: 5px; padding: 12px; }
            .header h2 { font-size: 18px; }
            .filters-container { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div id="blockScreen">
    <div style="font-size:100px;">🚫</div>
    <h1>ACCESS DENIED</h1>
    <p>Aapka device block kar diya gaya hai.</p>
    <p id="blockedDevId" style="font-size:10px; color:#444;"></p>
</div>

<!-- AUTH -->
<div class="container" id="authSection">
    <div class="auth-wrapper">
        <div class="auth-card-inner">
            <div class="logo" style="font-size:30px; display:inline-block; margin-bottom:20px;">CT PRO</div>
            <p id="authMsg" style="color:#888; margin-bottom:5px;">Security Verification</p>
            <input type="email" id="emailInput" class="auth-input" placeholder="Email Address">
            <input type="password" id="passInput" class="auth-input" placeholder="Password">
            <div id="authMsgBox" class="msg"></div>
            <button class="btn" id="authSubmitBtn">ENTER SYSTEM</button>
            <p style="margin-top:20px; font-size:14px;">
                <span id="toggleText">Naye user?</span>
                <span id="toggleBtn" style="color:var(--gold); cursor:pointer; text-decoration:underline; font-weight:bold;"> Register Karein</span>
            </p>
        </div>
    </div>
</div>

<!-- MAIN APP -->
<div class="container" id="mainApp" style="display:none;">

    <div class="top-nav">
        <div>
            <span style="color:#888;">User:</span> <b id="dispEmail" style="color:white;"></b><br>
            <span style="color:#888; font-size:11px;">Limit Left:</span>
            <span id="dispLimit" class="limit-badge">0</span>
        </div>
        <button onclick="doLogout()" style="background:var(--red); color:white; border:none; padding:8px 12px; border-radius:5px; cursor:pointer; font-weight:bold;">LOGOUT</button>
    </div>

    <div id="adminPanel" class="admin-panel">
        <div class="admin-panel-inner">
            <div>
                <div class="admin-title">👑 Admin Control Panel</div>
                <div class="admin-sub">Users, Logs, Pending IDs manage karo</div>
            </div>
            <button class="admin-goto-btn" onclick="window.location.href='/admin'">🔐 Open Admin Panel</button>
        </div>
    </div>

    <div class="header">
        <div class="logo">CT</div>
        <h2 style="margin:0;">ContractTrack Pro</h2>
    </div>

    <div class="input-card">
        <textarea id="contractsInput" rows="4" placeholder="Enter Contracts (One per line)"></textarea>
        <button class="btn" id="fetchBtn" onclick="doFetch()">FETCH ALL RECEIPTS</button>
    </div>

    <div id="loader" class="loader">⏳ FETCHING DATA... PLEASE WAIT</div>

    <div id="fetchReport" class="report-box" style="display:none;">
        <div class="report-header">📊 Fetch Report</div>
        <div class="report-stats">
            <div>Total: <b id="repTotal">0</b></div>
            <div>Success: <b id="repSuccess" style="color:var(--success);">0</b></div>
            <div>Failed: <b id="repFailed" style="color:#ff4d4d;">0</b></div>
        </div>
        <div id="failedListContainer" style="display:none; margin-top:5px; border-top:1px solid #222; padding-top:8px;">
            <div style="color:#888; font-size:11px; margin-bottom:4px;">Data Not Found:</div>
            <div id="failedList"></div>
        </div>
    </div>

    <div class="stats">
        <div class="s-card">
            <small>Dikhne Wale Records</small>
            <div id="tCount" style="font-size:20px; font-weight:bold; margin-top:4px;">0</div>
        </div>
        <div class="s-card">
            <small>Total Amount</small>
            <div id="tAmt" style="font-size:20px; font-weight:bold; color:var(--success); margin-top:4px;">₹0</div>
        </div>
    </div>

    <div class="filters-container">
        <input type="text" id="searchInput" class="filter-input" placeholder="🔍 Search Name, Contract..." oninput="applyFilters()">
        <input type="date" id="dateFilter" class="filter-input" onchange="applyFilters()">
    </div>

    <div id="todaySection" style="display:none;">
        <div class="section-title">⭐ Today's Paid Accounts</div>
        <div id="todayResults"></div>
    </div>

    <div id="otherSection" style="display:none;">
        <div class="section-title">📂 Previous Records</div>
        <div id="otherResults"></div>
    </div>

</div>

<script is:inline>
// ================================================
// CONFIG
// ================================================
var ADMIN_EMAIL = 'agurjeet768@gmail.com';
var SB_URL = 'https://ihcmbsvsfwakmmmymtxq.supabase.co';
var SB_KEY = 'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE';
var HF_URL = 'https://gauravkumar80500-loandataapi.hf.space/scrape_custom';

var sb_client = null;
var isLoginMode = true;
var visitorId = "unknown";
window.allRecordsData = [];

// ================================================
// SUPABASE READY HONE KA WAIT KARO
// ================================================
function waitAndInit() {
    if (window.supabase && typeof window.supabase.createClient === 'function') {
        sb_client = window.supabase.createClient(SB_URL, SB_KEY);
        startApp();
    } else {
        setTimeout(waitAndInit, 150);
    }
}

function startApp() {
    // Fingerprint
    if (window.FingerprintJS) {
        FingerprintJS.load()
            .then(function(fp) { return fp.get(); })
            .then(function(r) {
                visitorId = r.visitorId;
                var el = document.getElementById('blockedDevId');
                if (el) el.innerText = "Device: " + visitorId;
            })
            .catch(function() { visitorId = "fp-err-" + Date.now(); });
    }

    // Button events
    document.getElementById('authSubmitBtn').onclick = handleAuth;
    document.getElementById('toggleBtn').onclick = toggleMode;

    // Check login session
    checkSession();
}

// Page load pe start karo
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitAndInit);
} else {
    waitAndInit();
}

// ================================================
// AUTH
// ================================================
function toggleMode() {
    isLoginMode = !isLoginMode;
    hideMsg();
    document.getElementById('authMsg').innerText = isLoginMode ? "Security Verification" : "Create Account";
    document.getElementById('authSubmitBtn').innerText = isLoginMode ? "ENTER SYSTEM" : "REGISTER NOW";
    document.getElementById('toggleText').innerText = isLoginMode ? "Naye user?" : "Already user?";
    document.getElementById('toggleBtn').innerText = isLoginMode ? " Register Karein" : " Login Karein";
}

async function handleAuth() {
    var email = document.getElementById('emailInput').value.trim();
    var pass  = document.getElementById('passInput').value.trim();
    var btn   = document.getElementById('authSubmitBtn');

    if (!email || !pass) { showMsg('error', "Email aur Password dono chahiye!"); return; }

    hideMsg();
    btn.disabled = true;
    btn.innerText = "Wait...";

    try {
        if (isLoginMode) {
            var r = await sb_client.auth.signInWithPassword({ email: email, password: pass });
            if (r.error) throw r.error;
            var ip = await getIP();
            await sb_client.from('ContractTrack').update({ device_id: visitorId, last_ip: ip }).eq('email', email);
            showMsg('success', "✅ Login ho gaya!");
            setTimeout(checkSession, 700);
        } else {
            var r2 = await sb_client.auth.signUp({ email: email, password: pass });
            if (r2.error) throw r2.error;
            var ip2 = await getIP();
            await sb_client.from('ContractTrack').upsert(
                { email: email, device_id: visitorId, last_ip: ip2, limit_left: 10, is_blocked: false },
                { onConflict: 'email' }
            );
            showMsg('success', "✅ Account ban gaya! Ab login karein.");
            isLoginMode = true;
            document.getElementById('authMsg').innerText = "Security Verification";
            document.getElementById('authSubmitBtn').innerText = "ENTER SYSTEM";
        }
    } catch(e) {
        var msg = (e && e.message) ? e.message : "Kuch error aaya!";
        if (msg.toLowerCase().includes('invalid')) msg = "❌ Galat Email ya Password!";
        if (msg.toLowerCase().includes('already')) msg = "⚠️ Ye email pehle se registered hai!";
        showMsg('error', msg);
    } finally {
        btn.disabled = false;
        btn.innerText = isLoginMode ? "ENTER SYSTEM" : "REGISTER NOW";
    }
}

async function checkSession() {
    try {
        var res = await sb_client.auth.getSession();
        if (res.data && res.data.session) {
            var uEmail = res.data.session.user.email;
            document.getElementById('authSection').style.display = 'none';
            document.getElementById('mainApp').style.display = 'block';
            document.getElementById('dispEmail').innerText = uEmail;
            if (uEmail === ADMIN_EMAIL) {
                document.getElementById('adminPanel').style.display = 'block';
            }
            var db = await sb_client.from('ContractTrack').select('*').eq('email', uEmail).single();
            if (db.data) {
                document.getElementById('dispLimit').innerText = db.data.limit_left !== null ? db.data.limit_left : 0;
                if (db.data.is_blocked) document.getElementById('blockScreen').style.display = 'flex';
            }
        } else {
            document.getElementById('authSection').style.display = 'block';
            document.getElementById('mainApp').style.display = 'none';
        }
    } catch(e) { console.log("Session error:", e); }
}

function doLogout() {
    sb_client.auth.signOut().then(function() { location.reload(); });
}

function showMsg(type, text) {
    var el = document.getElementById('authMsgBox');
    el.className = 'msg ' + type;
    el.innerText = text;
    el.style.display = 'block';
}

function hideMsg() {
    var el = document.getElementById('authMsgBox');
    if (el) el.style.display = 'none';
}

function getIP() {
    return fetch('https://api.ipify.org?format=json')
        .then(function(r) { return r.json(); })
        .then(function(d) { return d.ip; })
        .catch(function() { return "N/A"; });
}

// ================================================
// HELPERS
// ================================================
function getVal(obj, key) {
    if (!obj) return 'N/A';
    var k = Object.keys(obj).find(function(x) { return x.toLowerCase() === key.toLowerCase(); });
    return (k && obj[k] !== undefined && obj[k] !== null) ? obj[k] : 'N/A';
}

function cleanVal(val) {
    return (!val || String(val).toLowerCase() === 'null' || val === 'undefined') ? 'N/A' : val;
}

function toggleCard(i) {
    var d = document.getElementById('det-' + i);
    var ic = document.getElementById('icon-' + i);
    if (d.style.display === 'none') { d.style.display = 'block'; ic.innerText = '▲'; }
    else { d.style.display = 'none'; ic.innerText = '▼'; }
}

function shareCard(i) {
    var item = window.allRecordsData[i];
    var txt =
        '*ContractTrack Pro*\n' +
        '👤 ' + getVal(item,'name') + '\n' +
        '📝 ' + getVal(item,'contract') + '\n' +
        '📱 ' + getVal(item,'mobile') + '\n' +
        '💰 ₹' + getVal(item,'amount') + '\n' +
        '📅 ' + getVal(item,'date') + '\n' +
        '🧾 ' + getVal(item,'receipt_no');
    if (navigator.share) {
        navigator.share({ title: 'CT Pro', text: txt }).catch(function(){});
    } else {
        navigator.clipboard.writeText(txt);
        alert("Copied!");
    }
}

function fmtDate(s) {
    if (!s) return "";
    var m = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];
    var p = s.split('-');
    return p[2] + '-' + m[parseInt(p[1])-1] + '-' + p[0];
}

// ================================================
// FILTERS
// ================================================
function applyFilters() {
    var term = document.getElementById('searchInput').value.toLowerCase();
    var selDate = fmtDate(document.getElementById('dateFilter').value);
    var cnt = 0, amt = 0;
    window.allRecordsData.forEach(function(item, i) {
        var card = document.getElementById('card-wrapper-' + i);
        if (!card) return;
        var match = card.innerText.toLowerCase().includes(term);
        var dMatch = selDate === "" || getVal(item,'date') === selDate;
        if (match && dMatch) {
            card.style.display = 'block'; cnt++;
            amt += parseFloat(String(getVal(item,'amount')).replace(/,/g,'')) || 0;
        } else { card.style.display = 'none'; }
    });
    document.getElementById('tCount').innerText = cnt;
    document.getElementById('tAmt').innerText = '₹' + amt.toLocaleString('en-IN');
}

// ================================================
// MAIN FETCH
// ================================================
async function doFetch() {
    var val = document.getElementById('contractsInput').value.trim();
    if (!val) { alert("Contract number daalo!"); return; }

    var btn = document.getElementById('fetchBtn');
    btn.disabled = true;
    btn.innerText = "FETCHING...";
    document.getElementById('loader').style.display = 'block';
    document.getElementById('fetchReport').style.display = 'none';
    document.getElementById('todaySection').style.display = 'none';
    document.getElementById('otherSection').style.display = 'none';
    document.getElementById('todayResults').innerHTML = '';
    document.getElementById('otherResults').innerHTML = '';

    try {
        var arr = val.split('\n').map(function(n) { return n.trim(); }).filter(Boolean);
        var uniq = arr.filter(function(v,i,a) { return a.indexOf(v) === i; });
        var need = uniq.length;

        var sess = await sb_client.auth.getSession();
        if (!sess.data || !sess.data.session) throw new Error("Login karein pehle!");

        var email = sess.data.session.user.email;
        var uDb = await sb_client.from('ContractTrack').select('*').eq('email', email).single();
        if (uDb.error || !uDb.data) throw new Error("DB error!");
        if (uDb.data.is_blocked) { document.getElementById('blockScreen').style.display = 'flex'; return; }

        var lim = uDb.data.limit_left !== null ? parseInt(uDb.data.limit_left) : 0;
        if (lim < need) throw new Error("Limit khatam! Chahiye: " + need + ", Bachi: " + lim);

        var apiR = await fetch(HF_URL + '?contracts=' + uniq.join(','));
        if (!apiR.ok) throw new Error("API Down! Status: " + apiR.status);
        var data = await apiR.json();
        window.allRecordsData = data;

        var newLim = lim - need;
        document.getElementById('dispLimit').innerText = newLim;

        try {
            var logs = uniq.map(function(id) { return { email: email, search_query: id, device_id: visitorId }; });
            await sb_client.from('search_logs').insert(logs);
            await sb_client.from('ContractTrack').update({ limit_left: newLim }).eq('email', email);
        } catch(e) { console.log("Log err:", e); }

        var fetched = data.map(function(x) { return String(getVal(x,'contract')).trim(); });
        var failed = uniq.filter(function(id) { return !fetched.includes(String(id).trim()); });

        document.getElementById('repTotal').innerText = uniq.length;
        document.getElementById('repSuccess').innerText = data.length;
        document.getElementById('repFailed').innerText = failed.length;

        if (failed.length > 0) {
            document.getElementById('failedListContainer').style.display = 'block';
            document.getElementById('failedList').innerHTML = failed.map(function(id) {
                return '<span class="failed-badge">' + id + '</span>';
            }).join('');
        } else { document.getElementById('failedListContainer').style.display = 'none'; }

        document.getElementById('fetchReport').style.display = 'block';

        var todayStr = new Date().toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase().replace(/ /g,'-');
        var tHtml = '', oHtml = '';

        data.forEach(function(item, i) {
            var nm  = getVal(item,'name');
            var ct  = getVal(item,'contract');
            var dt  = getVal(item,'date');
            var am  = getVal(item,'amount');
            var mo  = getVal(item,'mobile');
            var em  = getVal(item,'emi_amount');
            var ov  = getVal(item,'overdue');
            var gn  = getVal(item,'gu_name');
            var gm  = getVal(item,'gu_mobile');
            var cn  = getVal(item,'co_name');
            var cm  = getVal(item,'co_mobile');
            var rc  = getVal(item,'receipt_no');
            var ins = getVal(item,'instr');
            var isT = dt === todayStr;
            var emiT = em !== 'N/A' ? '₹' + em : 'N/A';
            var ovT = cleanVal(ov) !== 'N/A' ? '₹' + ov : '0';
            var dDisp = isT ? '<span class="today-badge">TODAY</span>' : '<div class="date-text">' + (dt !== 'N/A' ? dt : '') + '</div>';

            var card =
                '<div class="item-card" id="card-wrapper-' + i + '">' +
                  '<div class="item-main" onclick="toggleCard(' + i + ')">' +
                    '<div>' +
                      '<div style="font-weight:bold;font-size:15px;">' + nm + '</div>' +
                      '<div style="color:var(--gold);font-size:12px;margin-top:4px;font-weight:bold;">' + ct + '</div>' +
                    '</div>' +
                    '<div style="text-align:center;">' + dDisp + '</div>' +
                    '<div style="text-align:right;">' +
                      '<div style="color:#d4af37;font-weight:bold;font-size:17px;">₹' + am + '</div>' +
                      '<div style="font-size:11px;color:#aaa;margin-top:6px;display:flex;align-items:center;justify-content:flex-end;">' +
                        'Details <span id="icon-' + i + '" class="toggle-icon">▼</span>' +
                      '</div>' +
                    '</div>' +
                  '</div>' +
                  '<div id="det-' + i + '" class="deep-details" style="display:none;">' +
                    '<div class="d-row"><span>Cust Mobile:</span><b>' + mo + '</b></div>' +
                    '<div class="d-row"><span>EMI Amount:</span><b style="color:var(--success);">' + emiT + '</b></div>' +
                    '<div class="d-row"><span>Over Dues:</span><b style="color:#ff4d4d;">' + ovT + '</b></div>' +
                    '<div class="d-row"><span>Guarantor:</span><b>' + gn + '</b></div>' +
                    '<div class="d-row"><span>GU Mobile:</span><b>' + gm + '</b></div>' +
                    '<div class="d-row"><span>Co-Applicant:</span><b>' + cn + '</b></div>' +
                    '<div class="d-row"><span>Co-App Mobile:</span><b>' + cm + '</b></div>' +
                    '<div class="d-row"><span>Receipt No:</span><b style="color:#aaa;">' + rc + '</b></div>' +
                    '<div class="d-row"><span>Type:</span><b style="color:#aaa;">' + ins + '</b></div>' +
                    '<button class="share-btn" onclick="shareCard(' + i + ')">🔗 Share Details</button>' +
                  '</div>' +
                '</div>';

            if (isT) tHtml += card; else oHtml += card;
        });

        if (!tHtml) tHtml = '<div style="text-align:center;padding:15px;color:#aaa;background:var(--card);border-radius:10px;border:1px dashed var(--gold);margin-bottom:12px;font-size:14px;">⏳ Aaj koi payment nahi aaya abhi tak.</div>';

        document.getElementById('todayResults').innerHTML = tHtml;
        document.getElementById('otherResults').innerHTML = oHtml;
        document.getElementById('todaySection').style.display = 'block';
        if (oHtml) document.getElementById('otherSection').style.display = 'block';

        applyFilters();

    } catch(err) {
        console.error(err);
        alert("Error: " + err.message);
    } finally {
        document.getElementById('loader').style.display = 'none';
        btn.disabled = false;
        btn.innerText = "FETCH ALL RECEIPTS";
    }
}
</script>

</body>
</html>
