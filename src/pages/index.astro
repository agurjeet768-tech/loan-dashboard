---
// CT PRO - Simple Working Version
---
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ContractTrack Pro</title>
    <style>
        * { box-sizing: border-box; }
        :root { --gold: #d4af37; --bg: #000; --card: #151515; --border: #222; --success: #22c55e; --red: #ff4444; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: #fff; margin: 0; padding: 12px; }
        .container { max-width: 800px; margin: 0 auto; }
        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 14px; border-radius: 8px; font-weight: 900; cursor: pointer; margin-top: 10px; }
        .auth-card { max-width: 400px; margin: 50px auto; background: var(--card); border: 1px solid var(--gold); border-radius: 20px; padding: 25px; text-align: center; }
        .auth-input { width: 100%; padding: 14px; margin-top: 10px; border-radius: 10px; border: 1px solid #333; background: black; color: white; font-size: 16px; }
        .msg { margin-top: 12px; padding: 10px; border-radius: 8px; display: none; }
        .msg.error { background: #2a0000; color: #ff6666; }
        .msg.success { background: #002a10; color: #00ff99; }
        .top-nav { display: flex; justify-content: space-between; background: #0a0a0a; padding: 15px; border-radius: 12px; margin-bottom: 20px; }
        .input-card { background: var(--card); padding: 12px; border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 15px; }
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; }
        .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; }
        .s-card { background: var(--card); padding: 12px; border-radius: 10px; border: 2px solid var(--gold); text-align: center; }
        .item-card { background: var(--card); border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 12px; padding: 14px; }
        .item-main { display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .today-badge { background: var(--success); color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .loader { display: none; text-align: center; color: var(--gold); padding: 20px; }
        .limit-badge { background: #002a10; color: var(--success); padding: 4px 8px; border-radius: 5px; }
        #blockScreen { display: none; position: fixed; inset: 0; background: black; z-index: 9999; text-align: center; padding-top: 200px; color: red; }
        .filters-container { display: grid; grid-template-columns: 2fr 1fr; gap: 10px; margin-bottom: 10px; }
        .filter-input { width: 100%; background: var(--card); border: 2px solid var(--gold); color: #fff; padding: 12px; border-radius: 8px; }
        .section-title { color: var(--gold); font-size: 14px; font-weight: 900; margin: 20px 0 10px 0; }
        .deep-details { padding: 15px; background: #080808; border-top: 1px dashed var(--gold); margin-top: 10px; display: none; }
        .share-btn { width: 100%; background: var(--gold); color: #000; padding: 10px; border-radius: 6px; margin-top: 10px; cursor: pointer; }
    </style>
</head>
<body>

<div id="blockScreen"><h1>ACCESS DENIED</h1><p>Aapka device block hai.</p></div>

<!-- AUTH SECTION -->
<div id="authSection" style="display: block;">
    <div class="auth-card">
        <h2 style="color:var(--gold);">CT PRO</h2>
        <p id="authMsg" style="color:#888;">Login to Continue</p>
        <input type="email" id="email" class="auth-input" placeholder="Email">
        <input type="password" id="password" class="auth-input" placeholder="Password">
        <div id="authMessage" class="msg"></div>
        <button class="btn" id="loginBtn">LOGIN</button>
        <p style="margin-top:15px;">
            <span id="toggleAuthText">New user?</span>
            <button id="toggleAuthBtn" style="background:none; border:none; color:var(--gold); cursor:pointer; text-decoration:underline;">Register</button>
        </p>
    </div>
</div>

<!-- MAIN APP SECTION -->
<div id="mainApp" style="display: none;">
    <div class="top-nav">
        <div><b id="userEmail"></b><br>Limit: <span id="userLimit" class="limit-badge">0</span></div>
        <button id="logoutBtn" style="background:red; color:white; border:none; padding:8px 12px; border-radius:5px;">LOGOUT</button>
    </div>

    <div class="input-card">
        <textarea id="contractsInput" rows="4" placeholder="Enter Contract IDs (One per line)"></textarea>
        <button class="btn" id="fetchBtn">FETCH DATA</button>
    </div>

    <div id="loader" class="loader">LOADING...</div>

    <div class="stats">
        <div class="s-card"><small>Records</small><div id="totalCount" style="font-size:20px;">0</div></div>
        <div class="s-card"><small>Total Amount</small><div id="totalAmount" style="font-size:20px;color:var(--success);">₹0</div></div>
    </div>

    <div class="filters-container">
        <input type="text" id="searchFilter" class="filter-input" placeholder="Search...">
        <input type="date" id="dateFilter" class="filter-input">
    </div>

    <div id="todaySection"><div class="section-title">⭐ Today's Payments</div><div id="todayList"></div></div>
    <div id="otherSection"><div class="section-title">📂 Previous Records</div><div id="otherList"></div></div>
</div>

<script>
// SUPABASE CONFIG
const SUPABASE_URL = 'https://ihcmbsvsfwakmmmymtxq.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE';
const ADMIN_EMAIL = 'agurjeet768@gmail.com';

// Global variables
let supabaseClient = null;
let currentUser = null;
let allData = [];

// Function to load Supabase dynamically
function loadSupabase() {
    return new Promise((resolve, reject) => {
        if (typeof supabase !== 'undefined') {
            resolve();
            return;
        }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2';
        script.onload = () => resolve();
        script.onerror = () => reject(new Error('Failed to load Supabase'));
        document.head.appendChild(script);
    });
}

// Initialize app
async function init() {
    try {
        await loadSupabase();
        supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        await checkAuthState();
        setupEventListeners();
    } catch (error) {
        console.error('Init error:', error);
        showAuthMessage('Error loading app: ' + error.message, 'error');
    }
}

// Check authentication state
async function checkAuthState() {
    const { data } = await supabaseClient.auth.getSession();
    
    if (data?.session) {
        currentUser = data.session.user;
        await loadUserData();
        showMainApp();
    } else {
        showAuthSection();
    }
}

// Load user data from ContractTrack table
async function loadUserData() {
    const { data, error } = await supabaseClient
        .from('ContractTrack')
        .select('*')
        .eq('email', currentUser.email)
        .single();
    
    if (error && error.code === 'PGRST116') {
        // User not found, create new entry
        const { data: newUser, error: insertError } = await supabaseClient
            .from('ContractTrack')
            .insert({ email: currentUser.email, limit_left: 10, is_blocked: false })
            .select()
            .single();
        
        if (!insertError && newUser) {
            document.getElementById('userLimit').innerText = newUser.limit_left;
            if (newUser.is_blocked) showBlockScreen();
        }
    } else if (data) {
        document.getElementById('userLimit').innerText = data.limit_left;
        if (data.is_blocked) showBlockScreen();
    }
}

// Event listeners
function setupEventListeners() {
    document.getElementById('loginBtn').onclick = handleAuth;
    document.getElementById('toggleAuthBtn').onclick = toggleAuthMode;
    document.getElementById('logoutBtn').onclick = handleLogout;
    document.getElementById('fetchBtn').onclick = fetchData;
    document.getElementById('searchFilter').oninput = applyFilters;
    document.getElementById('dateFilter').onchange = applyFilters;
}

// Auth handler
let isLoginMode = true;

function toggleAuthMode() {
    isLoginMode = !isLoginMode;
    const loginBtn = document.getElementById('loginBtn');
    const toggleText = document.getElementById('toggleAuthText');
    
    if (isLoginMode) {
        loginBtn.innerText = 'LOGIN';
        toggleText.innerText = 'New user?';
        document.getElementById('authMsg').innerText = 'Login to Continue';
    } else {
        loginBtn.innerText = 'REGISTER';
        toggleText.innerText = 'Already have account?';
        document.getElementById('authMsg').innerText = 'Create New Account';
    }
}

async function handleAuth() {
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value.trim();
    
    if (!email || !password) {
        showAuthMessage('Please enter email and password', 'error');
        return;
    }
    
    const loginBtn = document.getElementById('loginBtn');
    loginBtn.disabled = true;
    loginBtn.innerText = 'Processing...';
    
    try {
        let result;
        
        if (isLoginMode) {
            result = await supabaseClient.auth.signInWithPassword({ email, password });
        } else {
            result = await supabaseClient.auth.signUp({ email, password });
            if (!result.error) {
                // Create user entry in ContractTrack
                await supabaseClient
                    .from('ContractTrack')
                    .insert({ email, limit_left: 10, is_blocked: false });
                showAuthMessage('Registration successful! Please login.', 'success');
                toggleAuthMode(); // Switch to login mode
                loginBtn.disabled = false;
                loginBtn.innerText = 'LOGIN';
                return;
            }
        }
        
        if (result.error) throw result.error;
        
        if (isLoginMode) {
            showAuthMessage('Login successful!', 'success');
            setTimeout(() => location.reload(), 1000);
        }
        
    } catch (error) {
        showAuthMessage(error.message, 'error');
    } finally {
        loginBtn.disabled = false;
        if (isLoginMode) loginBtn.innerText = 'LOGIN';
        else loginBtn.innerText = 'REGISTER';
    }
}

async function handleLogout() {
    await supabaseClient.auth.signOut();
    location.reload();
}

// UI Functions
function showAuthMessage(msg, type) {
    const msgDiv = document.getElementById('authMessage');
    msgDiv.innerText = msg;
    msgDiv.className = 'msg ' + type;
    msgDiv.style.display = 'block';
    setTimeout(() => { msgDiv.style.display = 'none'; }, 3000);
}

function showAuthSection() {
    document.getElementById('authSection').style.display = 'block';
    document.getElementById('mainApp').style.display = 'none';
    document.getElementById('blockScreen').style.display = 'none';
    document.getElementById('email').value = '';
    document.getElementById('password').value = '';
}

function showMainApp() {
    document.getElementById('authSection').style.display = 'none';
    document.getElementById('mainApp').style.display = 'block';
    document.getElementById('blockScreen').style.display = 'none';
    document.getElementById('userEmail').innerText = currentUser.email;
    
    // Show admin panel for admin
    if (currentUser.email === ADMIN_EMAIL) {
        const adminDiv = document.createElement('div');
        adminDiv.style.cssText = 'background:#1a1500; padding:10px; border-radius:10px; margin-bottom:15px; text-align:center; border:1px dashed var(--gold);';
        adminDiv.innerHTML = '<b style="color:var(--gold);">👑 ADMIN</b><br><button onclick="window.location.href=\'/admin\'" style="background:white; border:none; padding:5px 10px; border-radius:5px;">Go to Admin Panel</button>';
        const topNav = document.querySelector('.top-nav');
        topNav.parentNode.insertBefore(adminDiv, topNav.nextSibling);
    }
}

function showBlockScreen() {
    document.getElementById('authSection').style.display = 'none';
    document.getElementById('mainApp').style.display = 'none';
    document.getElementById('blockScreen').style.display = 'block';
}

// Fetch data from API
async function fetchData() {
    const input = document.getElementById('contractsInput').value.trim();
    if (!input) {
        alert('Please enter contract IDs');
        return;
    }
    
    const contracts = [...new Set(input.split('\n').map(c => c.trim()).filter(c => c))];
    
    // Check limit
    const { data: user } = await supabaseClient
        .from('ContractTrack')
        .select('limit_left')
        .eq('email', currentUser.email)
        .single();
    
    if (user.limit_left < contracts.length) {
        alert(`Limit exceeded! Need ${contracts.length}, have ${user.limit_left}`);
        return;
    }
    
    const fetchBtn = document.getElementById('fetchBtn');
    const loader = document.getElementById('loader');
    
    fetchBtn.disabled = true;
    loader.style.display = 'block';
    
    try {
        // Call API
        const response = await fetch(`https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${contracts.join(',')}`);
        const data = await response.json();
        
        allData = data;
        
        // Update limit
        const newLimit = user.limit_left - contracts.length;
        await supabaseClient
            .from('ContractTrack')
            .update({ limit_left: newLimit })
            .eq('email', currentUser.email);
        document.getElementById('userLimit').innerText = newLimit;
        
        // Log search
        for (const contract of contracts) {
            await supabaseClient
                .from('search_logs')
                .insert({ email: currentUser.email, search_query: contract });
        }
        
        renderData();
        applyFilters();
        
        // Show report
        alert(`Fetched ${data.length} out of ${contracts.length} contracts`);
        
    } catch (error) {
        console.error('Fetch error:', error);
        alert('Error: ' + error.message);
    } finally {
        fetchBtn.disabled = false;
        loader.style.display = 'none';
    }
}

// Helper to get value case-insensitively
function getValue(obj, key) {
    if (!obj) return 'N/A';
    const found = Object.keys(obj).find(k => k.toLowerCase() === key.toLowerCase());
    return found ? (obj[found] || 'N/A') : 'N/A';
}

// Render data
function renderData() {
    const today = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');
    
    let todayHtml = '';
    let otherHtml = '';
    
    allData.forEach((item, index) => {
        const name = getValue(item, 'name');
        const contract = getValue(item, 'contract');
        const amount = getValue(item, 'amount');
        const date = getValue(item, 'date');
        const mobile = getValue(item, 'mobile');
        const receipt = getValue(item, 'receipt_no');
        const isToday = date === today;
        
        const cardHtml = `
            <div class="item-card" data-date="${date}" data-name="${name.toLowerCase()}" data-contract="${contract.toLowerCase()}">
                <div class="item-main" onclick="toggleDetails(${index})">
                    <div><strong>${name}</strong><br><small style="color:var(--gold);">${contract}</small></div>
                    <div>${isToday ? '<span class="today-badge">TODAY</span>' : date}</div>
                    <div style="text-align:right;"><strong style="color:var(--gold);">₹${amount}</strong><br><small>▼</small></div>
                </div>
                <div id="details-${index}" class="deep-details">
                    <div>📱 Mobile: ${mobile}</div>
                    <div>🧾 Receipt: ${receipt}</div>
                    <div>💰 Amount: ₹${amount}</div>
                    <div>📅 Date: ${date}</div>
                    <button class="share-btn" onclick="shareDetails(${index})">📤 Share</button>
                </div>
            </div>
        `;
        
        if (isToday) {
            todayHtml += cardHtml;
        } else {
            otherHtml += cardHtml;
        }
    });
    
    if (todayHtml === '') todayHtml = '<div style="text-align:center; padding:20px; color:#888;">No payments today</div>';
    if (otherHtml === '') otherHtml = '<div style="text-align:center; padding:20px; color:#888;">No previous records</div>';
    
    document.getElementById('todayList').innerHTML = todayHtml;
    document.getElementById('otherList').innerHTML = otherHtml;
    document.getElementById('todaySection').style.display = 'block';
    document.getElementById('otherSection').style.display = 'block';
}

// Toggle details
window.toggleDetails = function(index) {
    const el = document.getElementById(`details-${index}`);
    if (el.style.display === 'none' || el.style.display === '') {
        el.style.display = 'block';
    } else {
        el.style.display = 'none';
    }
};

// Share details
window.shareDetails = function(index) {
    const item = allData[index];
    const text = `ContractTrack Details:\nName: ${getValue(item, 'name')}\nContract: ${getValue(item, 'contract')}\nMobile: ${getValue(item, 'mobile')}\nAmount: ₹${getValue(item, 'amount')}\nDate: ${getValue(item, 'date')}`;
    if (navigator.share) {
        navigator.share({ title: 'Contract Details', text: text });
    } else {
        navigator.clipboard.writeText(text);
        alert('Copied to clipboard!');
    }
};

// Apply filters
function applyFilters() {
    const searchTerm = document.getElementById('searchFilter').value.toLowerCase();
    const dateFilter = document.getElementById('dateFilter').value;
    
    let visibleCount = 0;
    let totalAmount = 0;
    
    document.querySelectorAll('.item-card').forEach(card => {
        const date = card.getAttribute('data-date');
        const name = card.getAttribute('data-name');
        const contract = card.getAttribute('data-contract');
        
        let show = true;
        
        if (searchTerm && !name.includes(searchTerm) && !contract.includes(searchTerm)) {
            show = false;
        }
        
        if (dateFilter) {
            const formattedDate = dateFilter.split('-').reverse().join('-');
            if (date !== formattedDate) {
                show = false;
            }
        }
        
        card.style.display = show ? 'block' : 'none';
        if (show) {
            visibleCount++;
            // Extract amount from card
            const amountText = card.querySelector('.item-main strong')?.innerText || '₹0';
            const amount = parseInt(amountText.replace('₹', '').replace(/,/g, '')) || 0;
            totalAmount += amount;
        }
    });
    
    document.getElementById('totalCount').innerText = visibleCount;
    document.getElementById('totalAmount').innerText = '₹' + totalAmount.toLocaleString('en-IN');
}

// Start the app
init();
</script>
</body>
</html>
