---
// index.astro - Final Design with Co-App Mobile & Gold Borders
---
<html lang="hi">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ContractTrack Pro</title>
    <style>
        :root { --gold: #d4af37; --bg: #000; --card: #151515; --border: #222; --success: #22c55e; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: #fff; margin: 0; padding: 15px; }
        .container { max-width: 800px; margin: 0 auto; }
        
        .header { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
        .logo { background: var(--gold); color: #000; padding: 4px 8px; border-radius: 4px; font-weight: 900; }

        .input-card { background: var(--card); padding: 15px; border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 20px; }
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; box-sizing: border-box; font-family: monospace; }
        textarea:focus { outline: none; border-color: var(--gold); }
        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 12px; border-radius: 8px; font-weight: 800; cursor: pointer; margin-top: 10px; text-transform: uppercase; }

        .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 25px; }
        .s-card { background: var(--card); padding: 12px; border-radius: 10px; border: 2px solid var(--gold); text-align: center; }
        .s-card small { color: var(--gold); font-size: 10px; text-transform: uppercase; font-weight: bold; }

        .item-main { padding: 15px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .item-main:active { background: #1a1a1a; }
        
        .deep-details { padding: 15px; background: #080808; border-top: 1px dashed #d4af37; font-size: 13px; }
        .d-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #1a1a1a; }
        .d-row:last-child { border-bottom: none; }
        .d-row b { color: var(--gold); }

        .today-badge { background: var(--success); color: #000; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: 900; }
        .loader { display: none; text-align: center; color: var(--gold); padding: 20px; font-weight: bold; letter-spacing: 1px; }
        .toggle-icon { font-size: 12px; color: var(--gold); margin-left: 5px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header"><div class="logo">CT</div><h2 style="margin:0;">ContractTrack Pro</h2></div>

        <div class="input-card">
            <textarea id="contractsInput" rows="5" placeholder="Enter Contracts (One per line)"></textarea>
            <button id="fetchBtn" class="btn">FETCH ALL RECEIPTS</button>
        </div>

        <div id="loader" class="loader">FETCHING DATA... PLEASE WAIT</div>

        <div class="stats">
            <div class="s-card"><small>Aaj ke Records</small><div id="tCount" style="font-size: 22px; font-weight: bold; margin-top: 5px;">0</div></div>
            <div class="s-card"><small>Aaj ka Total</small><div id="tAmt" style="font-size: 22px; font-weight: bold; color:var(--success); margin-top: 5px;">₹0</div></div>
        </div>

        <div id="results"></div>
    </div>

    <script>
        const btn = document.getElementById('fetchBtn');
        const input = document.getElementById('contractsInput');
        const resDiv = document.getElementById('results');

        window.toggleCard = function(index) {
            const detailsDiv = document.getElementById('det-' + index);
            const iconSpan = document.getElementById('icon-' + index);
            
            if (detailsDiv.style.display === 'none') {
                detailsDiv.style.display = 'block'; 
                iconSpan.innerText = '▲'; 
            } else {
                detailsDiv.style.display = 'none';  
                iconSpan.innerText = '▼'; 
            }
        };

        btn.onclick = async () => {
            const val = input.value.trim();
            if(!val) return;
            const list = val.split('\n').map(n => n.trim()).filter(n => n).join(',');
            
            document.getElementById('loader').style.display = 'block';
            resDiv.innerHTML = '';

            try {
                const r = await fetch(`https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${list}`);
                const data = await r.json();
                const today = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');
                
                let tCount = 0, tAmt = 0;

                data.forEach((item, i) => {
                    const isToday = item.date === today;
                    if(isToday) { tCount++; tAmt += parseFloat(item.amount.toString().replace(/,/g, '')) || 0; }

                    const emiAmountText = item.emi_amount !== 'N/A' ? `₹${item.emi_amount}` : 'N/A';
                    const overdueText = item.overdue !== 'N/A' ? `₹${item.overdue}` : '0';

                    const card = `
                        <div style="background: #151515; border-radius: 12px; border: 2px solid #d4af37; margin-bottom: 15px; overflow: hidden; box-shadow: 0 4px 10px rgba(212, 175, 55, 0.15);">
                            <div class="item-main" onclick="toggleCard(${i})">
                                <div>
                                    <div style="font-weight:bold; font-size: 16px;">${item.name}</div>
                                    <div style="color:#888; font-size: 12px; margin-top: 4px;">${item.contract} • ${isToday ? '<span class="today-badge">TODAY</span>' : item.date}</div>
                                </div>
                                <div style="text-align:right;">
                                    <div style="color:#d4af37; font-weight:bold; font-size: 18px;">₹${item.amount}</div>
                                    <div style="font-size:11px; color:#aaa; margin-top: 6px; display:flex; align-items:center; justify-content:flex-end;">
                                        Details <span id="icon-${i}" class="toggle-icon">▼</span>
                                    </div>
                                </div>
                            </div>
                            <div id="det-${i}" class="deep-details" style="display: none;">
                                <div class="d-row"><span>Cust Mobile:</span> <b>${item.mobile}</b></div>
                                <div class="d-row"><span>EMI Amount:</span> <b style="color:var(--success);">${emiAmountText}</b></div>
                                <div class="d-row"><span>Over Dues:</span> <b style="color:#ff4d4d;">${overdueText}</b></div>
                                <div class="d-row"><span>Guarantor:</span> <b>${item.gu_name}</b></div>
                                <div class="d-row"><span>GU Mobile:</span> <b>${item.gu_mobile}</b></div>
                                <div class="d-row"><span>Co-Applicant:</span> <b>${item.co_name}</b></div>
                                <div class="d-row"><span>Co-App Mobile:</span> <b>${item.co_mobile}</b></div>
                                <div class="d-row"><span>Receipt No:</span> <b style="color:#aaa;">${item.receipt_no}</b></div>
                                <div class="d-row"><span>Type:</span> <b style="color:#aaa;">${item.instr}</b></div>
                            </div>
                        </div>
                    `;
                    resDiv.innerHTML += card;
                });

                document.getElementById('tCount').innerText = tCount;
                document.getElementById('tAmt').innerText = "₹" + tAmt.toLocaleString('en-IN');
            } catch (err) {
                alert("Data fetch karne mein error aayi, please dobara try karein.");
            } finally {
                document.getElementById('loader').style.display = 'none';
            }
        }
    </script>
</body>
</html>
