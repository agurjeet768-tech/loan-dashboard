---
// index.astro - Dashboard with Deep Details
---
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ContractTrack Pro - Deep Data</title>
    <style>
        :root { --gold: #d4af37; --bg: #121212; --card: #1e1e1e; --border: #2d2d2d; --success: #22c55e; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: #fff; margin: 0; padding: 15px; }
        .container { max-width: 850px; margin: 0 auto; }
        
        .input-card { background: var(--card); padding: 15px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 20px; }
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; box-sizing: border-box; }
        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 12px; border-radius: 8px; font-weight: 800; cursor: pointer; margin-top: 10px; }

        .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .stat-card { background: var(--card); padding: 15px; border-radius: 10px; border: 1px solid var(--border); text-align: center; }
        .stat-card small { color: var(--gold); font-size: 10px; text-transform: uppercase; }

        /* Main List Card */
        .record-card { background: var(--card); border-radius: 12px; border: 1px solid var(--border); margin-bottom: 10px; overflow: hidden; }
        .card-main { padding: 15px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .card-main:active { background: #252525; }
        
        /* Deep Details Panel (Hidden by default) */
        .details-panel { display: none; padding: 15px; background: #181818; border-top: 1px solid var(--border); font-size: 13px; }
        .detail-row { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px dashed #333; }
        .detail-row b { color: var(--gold); }

        .today-tag { background: var(--success); color: #000; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; }
        .loader { display: none; text-align: center; color: var(--gold); padding: 10px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <h2 style="color:var(--gold);"><span style="background:var(--gold);color:black;padding:0 8px;border-radius:4px;margin-right:8px;">CT</span> ContractTrack Pro</h2>

        <div class="input-card">
            <textarea id="contractsInput" rows="4" placeholder="Paste Numbers (One per line)"></textarea>
            <button id="fetchBtn" class="btn">FETCH ALL DATA</button>
        </div>

        <div id="loader" class="loader">FETCHING DEEP RECORDS...</div>

        <div class="summary-grid">
            <div class="stat-card"><small>Aaj ke Records</small><div id="tCount">0</div></div>
            <div class="stat-card"><small>Aaj ka Total</small><div id="tAmt" style="color:var(--success);">₹0</div></div>
        </div>

        <div id="results"></div>
    </div>

    <script>
        const btn = document.getElementById('fetchBtn');
        const input = document.getElementById('contractsInput');
        const resDiv = document.getElementById('results');

        btn.onclick = async () => {
            const raw = input.value.trim();
            if(!raw) return;
            const list = raw.split('\n').map(n => n.trim()).filter(n => n).join(',');
            
            document.getElementById('loader').style.display = 'block';
            resDiv.innerHTML = '';

            try {
                const r = await fetch(`https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${list}`);
                const data = await r.json();
                const today = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');
                
                let tCount = 0, tAmt = 0;

                data.forEach((item, index) => {
                    const isToday = item.date === today;
                    if(isToday) { tCount++; tAmt += parseFloat(item.amount.toString().replace(/,/g, '')) || 0; }

                    const card = `
                        <div class="record-card">
                            <div class="card-main" onclick="document.getElementById('det-${index}').style.display = document.getElementById('det-${index}').style.display === 'block' ? 'none' : 'block'">
                                <div>
                                    <div style="font-weight:bold;">${item.name}</div>
                                    <small style="color:#888;">${item.contract} • ${isToday ? '<span class="today-tag">TODAY</span>' : item.date}</small>
                                </div>
                                <div style="text-align:right;">
                                    <div style="color:var(--gold); font-weight:bold;">₹${item.amount}</div>
                                    <small style="font-size:10px; color:#666;">View Details ▾</small>
                                </div>
                            </div>
                            <div id="det-${index}" class="details-panel">
                                <div class="detail-row"><span>Guarantor:</span> <b>${item.gu_name}</b></div>
                                <div class="detail-row"><span>GU Mobile:</span> <b>${item.gu_mobile}</b></div>
                                <div class="detail-row"><span>Co-Applicant:</span> <b>${item.co_name}</b></div>
                                <div class="detail-row"><span>Over Dues:</span> <b style="color:#ff4d4d;">₹${item.overdue}</b></div>
                                <div class="detail-row"><span>Paid EMI:</span> <b>${item.paid_emi}</b></div>
                                <div class="detail-row"><span>Receipt No:</span> <b>${item.receipt_no}</b></div>
                                <div class="detail-row"><span>Type:</span> <b>${item.instr}</b></div>
                            </div>
                        </div>
                    `;
                    resDiv.innerHTML += card;
                });

                document.getElementById('tCount').innerText = tCount;
                document.getElementById('tAmt').innerText = "₹" + tAmt.toLocaleString('en-IN');
            } finally {
                document.getElementById('loader').style.display = 'none';
            }
        }
    </script>
</body>
</html>
