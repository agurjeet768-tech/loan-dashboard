---
// index.astro - ContractTrack Pro v3.0
---
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>ContractTrack Pro</title>
    <style>
        :root {
            --gold: #d4af37;
            --gold-dim: #a88a20;
            --gold-glow: rgba(212,175,55,0.18);
            --bg: #000;
            --card: #111;
            --card2: #0a0a0a;
            --border: #1e1e1e;
            --success: #22c55e;
            --danger: #ef4444;
            --blue: #60a5fa;
            --text: #e5e5e5;
            --muted: #555;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding: 0;
            overflow-x: hidden;
        }

        /* ── Top Bar ── */
        .topbar {
            background: #0a0a0a;
            border-bottom: 1px solid #1a1a1a;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .logo {
            background: var(--gold);
            color: #000;
            width: 36px; height: 36px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 14px; flex-shrink: 0;
        }
        .topbar-title { font-size: 17px; font-weight: 700; color: #fff; }
        .topbar-sub   { font-size: 11px; color: var(--muted); margin-top: 1px; }

        /* ── Main Content ── */
        .main { max-width: 680px; margin: 0 auto; padding: 16px; }

        /* ── Input Section ── */
        .input-wrap {
            background: var(--card);
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
        }
        .input-label {
            font-size: 11px;
            color: var(--gold);
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: block;
        }
        textarea {
            width: 100%;
            background: #000;
            border: 1px solid #252525;
            color: #fff;
            padding: 12px;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            line-height: 1.6;
            resize: vertical;
            min-height: 100px;
            transition: border-color 0.2s;
        }
        textarea:focus { outline: none; border-color: var(--gold); }
        textarea::placeholder { color: #333; }

        .fetch-btn {
            width: 100%;
            margin-top: 12px;
            background: var(--gold);
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 900;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: opacity 0.15s, transform 0.1s;
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .fetch-btn:active { opacity: 0.8; transform: scale(0.99); }
        .fetch-btn:disabled { opacity: 0.5; cursor: not-allowed; }

        /* ── Stats ── */
        .stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 16px;
        }
        .stat-card {
            background: var(--card);
            border: 1px solid #1e1e1e;
            border-radius: 14px;
            padding: 14px 16px;
            text-align: center;
        }
        .stat-label {
            font-size: 10px;
            color: var(--gold);
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .stat-val {
            font-size: 26px;
            font-weight: 800;
            margin-top: 4px;
            color: #fff;
        }

        /* ── Loader ── */
        .loader {
            display: none;
            text-align: center;
            padding: 32px 0;
        }
        .loader-ring {
            width: 40px; height: 40px;
            border: 3px solid #1a1a1a;
            border-top-color: var(--gold);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 12px;
        }
        .loader-text { font-size: 12px; color: var(--muted); letter-spacing: 2px; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Section Label ── */
        .section-label {
            font-size: 11px;
            color: var(--muted);
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin: 4px 0 10px;
            display: none;
        }

        /* ── Contract Card ── */
        .c-card {
            background: var(--card);
            border: 1px solid #1e1e1e;
            border-radius: 14px;
            margin-bottom: 12px;
            overflow: hidden;
            transition: border-color 0.2s;
        }
        .c-card.today-card { border-color: rgba(212,175,55,0.35); }

        /* Card Header */
        .c-header {
            padding: 14px 16px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            cursor: pointer;
            gap: 10px;
            -webkit-tap-highlight-color: transparent;
        }
        .c-header:active { background: #161616; }

        .c-name { font-size: 15px; font-weight: 700; color: #fff; line-height: 1.3; }
        .c-meta {
            font-size: 12px;
            color: var(--muted);
            margin-top: 3px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
        }
        .c-right { text-align: right; flex-shrink: 0; }
        .c-amount { font-size: 20px; font-weight: 800; color: var(--gold); }
        .c-date   { font-size: 11px; color: var(--muted); margin-top: 4px; }

        /* Badges */
        .badge {
            display: inline-flex; align-items: center;
            padding: 2px 8px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }
        .badge-today { background: var(--success); color: #000; }
        .badge-cash  { background: #2d1a00; color: #fb923c; border: 1px solid #3d2200; }
        .badge-bank  { background: #001a3d; color: var(--blue); border: 1px solid #002255; }

        /* Quick Info Row */
        .c-quick {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            border-top: 1px solid var(--border);
        }
        .q-item {
            padding: 10px 16px;
            border-right: 1px solid var(--border);
        }
        .q-item:last-child { border-right: none; }
        .q-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .q-val   { font-size: 13px; font-weight: 600; color: #ddd; margin-top: 2px; word-break: break-all; }
        .q-val.green { color: var(--success); }

        /* Toggle Row */
        .c-toggle {
            padding: 9px 16px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            cursor: pointer;
            font-size: 11px;
            color: var(--gold);
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            -webkit-tap-highlight-color: transparent;
        }
        .c-toggle:active { background: #161616; }
        .toggle-arrow { transition: transform 0.25s; font-size: 10px; }
        .toggle-arrow.open { transform: rotate(180deg); }

        /* Details Panel */
        .c-details {
            display: none;
            border-top: 1px dashed rgba(212,175,55,0.25);
            background: var(--card2);
        }
        .d-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 11px 16px;
            border-bottom: 1px solid #0f0f0f;
        }
        .d-row:last-child { border-bottom: none; }
        .d-key  { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
        .d-val  { font-size: 13px; font-weight: 700; color: var(--gold); text-align: right; max-width: 55%; word-break: break-all; }
        .d-val.red   { color: var(--danger); }
        .d-val.white { color: #ccc; font-weight: 400; }
        .d-val.green { color: var(--success); }

        /* Error */
        .err-box {
            background: #1a0000;
            border: 1px solid #400;
            color: #f87171;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 13px;
            margin-bottom: 12px;
        }

        /* Empty State */
        .empty {
            text-align: center;
            padding: 40px 20px;
            color: var(--muted);
        }
        .empty-icon { font-size: 40px; margin-bottom: 12px; }
        .empty-text { font-size: 14px; }
    </style>
</head>
<body>

<!-- Top Bar -->
<div class="topbar">
    <div class="logo">CT</div>
    <div>
        <div class="topbar-title">ContractTrack Pro</div>
        <div class="topbar-sub">Mahindra Finance Receipt Tracker</div>
    </div>
</div>

<div class="main">

    <!-- Input -->
    <div class="input-wrap">
        <span class="input-label">Contract Numbers</span>
        <textarea id="inp" placeholder="Contract numbers yahan paste karo&#10;Ek line mein ek number&#10;&#10;10341364&#10;8721082&#10;9801882"></textarea>
        <button class="fetch-btn" id="fetchBtn">
            <span id="btnIcon">⚡</span>
            <span id="btnText">FETCH ALL RECEIPTS</span>
        </button>
    </div>

    <!-- Stats -->
    <div class="stats">
        <div class="stat-card">
            <div class="stat-label">Aaj ke Records</div>
            <div class="stat-val" id="tCount">—</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Aaj ka Total</div>
            <div class="stat-val" style="color:var(--success);" id="tAmt">—</div>
        </div>
    </div>

    <!-- Loader -->
    <div class="loader" id="loader">
        <div class="loader-ring"></div>
        <div class="loader-text">DATA SYNC HO RAHA HAI...</div>
    </div>

    <!-- Error -->
    <div id="errBox"></div>

    <!-- Results -->
    <div class="section-label" id="secLabel">RESULTS</div>
    <div id="results"></div>

</div>

<script>
const btn     = document.getElementById('fetchBtn');
const inp     = document.getElementById('inp');
const resDiv  = document.getElementById('results');
const errBox  = document.getElementById('errBox');
const loader  = document.getElementById('loader');
const secLbl  = document.getElementById('secLabel');

// Today string: "08-MAY-2026"
function todayStr() {
    return new Date().toLocaleDateString('en-GB', {
        day:'2-digit', month:'short', year:'numeric'
    }).toUpperCase().replace(/ /g,'-');
}

function safe(v) {
    const bad = [null, undefined, 'N/A','null','None','none','undefined',''];
    return bad.includes(v) || (typeof v === 'string' && !v.trim()) ? '—' : v;
}

function fmtAmt(v) {
    const n = parseFloat(String(v||'0').replace(/,/g,''));
    return isNaN(n) ? '0' : n.toLocaleString('en-IN');
}

function modeBadge(mode) {
    if (!mode || mode === 'N/A') return '';
    if (mode === 'CASH') return `<span class="badge badge-cash">💵 CASH</span>`;
    return `<span class="badge badge-bank">🏦 BANK</span>`;
}

function toggleCard(i) {
    const det   = document.getElementById('det-'+i);
    const arrow = document.getElementById('arr-'+i);
    const lbl   = document.getElementById('tlbl-'+i);
    const open  = det.style.display === 'block';
    det.style.display = open ? 'none' : 'block';
    arrow.classList.toggle('open', !open);
    lbl.textContent   = open ? 'MORE DETAILS' : 'CLOSE DETAILS';
}

function setLoading(on) {
    loader.style.display  = on ? 'block' : 'none';
    btn.disabled          = on;
    document.getElementById('btnIcon').textContent = on ? '⏳' : '⚡';
    document.getElementById('btnText').textContent = on ? 'FETCHING...' : 'FETCH ALL RECEIPTS';
}

btn.onclick = async () => {
    const val = inp.value.trim();
    if (!val) return;

    const list = val.split('\n').map(s=>s.trim()).filter(Boolean).join(',');

    setLoading(true);
    resDiv.innerHTML = '';
    errBox.innerHTML = '';
    secLbl.style.display = 'none';
    document.getElementById('tCount').textContent = '—';
    document.getElementById('tAmt').textContent   = '—';

    try {
        const r = await fetch(
            `https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${encodeURIComponent(list)}`
        );
        if (!r.ok) throw new Error(`Server error: ${r.status}`);
        const data = await r.json();

        if (!Array.isArray(data) || !data.length) {
            errBox.innerHTML = `<div class="err-box">⚠️ Koi data nahi mila. Contract numbers check karo.</div>`;
            setLoading(false);
            return;
        }

        const today = todayStr();
        let tCount = 0, tAmt = 0;
        secLbl.style.display = 'block';

        data.forEach((item, i) => {
            const isToday = item.date && item.date.toUpperCase() === today;
            const amtNum  = parseFloat(String(item.amount||'0').replace(/,/g,'')) || 0;
            if (isToday) { tCount++; tAmt += amtNum; }

            const emiTxt     = item.emi_amount && item.emi_amount !== 'N/A'
                               ? `₹${fmtAmt(item.emi_amount)}` : '—';
            const overdueTxt = item.overdue && item.overdue !== 'N/A' && item.overdue !== '0'
                               ? `₹${fmtAmt(item.overdue)}` : '₹0';

            resDiv.innerHTML += `
            <div class="c-card${isToday ? ' today-card' : ''}">

                <!-- Header -->
                <div class="c-header" onclick="toggleCard(${i})">
                    <div style="flex:1; min-width:0;">
                        <div class="c-name">${safe(item.name)}</div>
                        <div class="c-meta">
                            <span style="color:#444;">#${item.contract}</span>
                            ${modeBadge(item.payment_mode)}
                            ${isToday ? '<span class="badge badge-today">TODAY</span>' : ''}
                        </div>
                    </div>
                    <div class="c-right">
                        <div class="c-amount">₹${fmtAmt(item.amount)}</div>
                        <div class="c-date">${safe(item.date)}</div>
                    </div>
                </div>

                <!-- Quick Info: always visible -->
                <div class="c-quick">
                    <div class="q-item">
                        <div class="q-label">📱 Mobile</div>
                        <div class="q-val green">${safe(item.mobile)}</div>
                    </div>
                    <div class="q-item">
                        <div class="q-label">💳 EMI Amount</div>
                        <div class="q-val">${emiTxt}</div>
                    </div>
                </div>

                <!-- Toggle Button -->
                <div class="c-toggle" onclick="toggleCard(${i})">
                    <span id="tlbl-${i}">MORE DETAILS</span>
                    <span id="arr-${i}" class="toggle-arrow">▼</span>
                </div>

                <!-- Expandable Details -->
                <div id="det-${i}" class="c-details">
                    <div class="d-row">
                        <span class="d-key">📅 Date Received</span>
                        <span class="d-val">${safe(item.date)}</span>
                    </div>
                    <div class="d-row">
                        <span class="d-key">💳 Payment Mode</span>
                        <span class="d-val">${safe(item.payment_mode)}</span>
                    </div>
                    <div class="d-row">
                        <span class="d-key">🧾 Receipt No</span>
                        <span class="d-val white">${safe(item.receipt_no)}</span>
                    </div>
                    <div class="d-row">
                        <span class="d-key">⚠️ Over Dues</span>
                        <span class="d-val red">${overdueTxt}</span>
                    </div>
                    <div class="d-row">
                        <span class="d-key">🛡️ Guarantor</span>
                        <span class="d-val">${safe(item.gu_name)}</span>
                    </div>
                    <div class="d-row">
                        <span class="d-key">📞 GU Mobile</span>
                        <span class="d-val white">${safe(item.gu_mobile)}</span>
                    </div>
                    <div class="d-row">
                        <span class="d-key">👤 Co-Applicant</span>
                        <span class="d-val">${safe(item.co_name)}</span>
                    </div>
                    <div class="d-row">
                        <span class="d-key">📞 Co-App Mobile</span>
                        <span class="d-val white">${safe(item.co_mobile)}</span>
                    </div>
                </div>
            </div>`;
        });

        document.getElementById('tCount').textContent = tCount;
        document.getElementById('tAmt').textContent   = tCount > 0
            ? '₹' + tAmt.toLocaleString('en-IN') : '₹0';

    } catch(e) {
        errBox.innerHTML = `<div class="err-box">❌ Error: ${e.message}</div>`;
    } finally {
        setLoading(false);
    }
};
</script>
</body>
</html>
