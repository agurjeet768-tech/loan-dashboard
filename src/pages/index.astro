---
// CT PRO - Complete Working Version with Fixed Authentication
---
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ContractTrack Pro</title>

    <style is:global>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; } 
        :root { --gold: #d4af37; --bg: #000; --card: #151515; --border: #222; --success: #22c55e; --red: #ff4444; }
        
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: #fff; margin: 0; padding: 12px; overflow-x: hidden; }
        .container { max-width: 800px; margin: 0 auto; width: 100%; }
        
        .header { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; }
        .logo { background: var(--gold); color: #000; padding: 4px 8px; border-radius: 4px; font-weight: 900; }

        .input-card { background: var(--card); padding: 12px; border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 15px; width: 100%; }
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-family: monospace; font-size: 14px; }
        textarea:focus { outline: none; border-color: var(--gold); }
        
        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 14px; border-radius: 8px; font-weight: 900; cursor: pointer; margin-top: 10px; text-transform: uppercase; font-size: 15px; touch-action: manipulation; transition: transform 0.1s; }
        .btn:active { transform: scale(0.98); }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }

        .report-box { background: #0c0c0c; border: 1px solid #333; padding: 12px; border-radius: 10px; margin-bottom: 15px; font-size: 13px; }
        .report-header { color: var(--gold); font-weight: bold; margin-bottom: 8px; border-bottom: 1px dashed #333; padding-bottom: 5px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
        .report-stats { display: flex; justify-content: space-between; margin-bottom: 8px; }
        .failed-badge { background: rgba(255, 77, 77, 0.1); color: #ff4d4d; border: 1px solid #ff4d4d; padding: 3px 6px; border-radius: 4px; font-size: 11px; margin: 2px 2px 0 0; display: inline-block; font-family: monospace; }

        .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; width: 100%; }
        .s-card { background: var(--card); padding: 12px; border-radius: 10px; border: 2px solid var(--gold); text-align: center; }
        .s-card small { color: var(--gold); font-size: 10px; text-transform: uppercase; font-weight: bold; }

        .filters-container { display: grid; grid-template-columns: 2fr 1fr; gap: 10px; margin-bottom: 10px; }
        .filter-input { width: 100%; background: var(--card); border: 2px solid var(--gold); color: #fff; padding: 12px; border-radius: 8px; font-size: 14px; outline: none; transition: 0.3s; }
        .filter-input:focus { box-shadow: 0 0 5px rgba(212, 175, 55, 0.5); }
        input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; }

        .section-title { color: var(--gold); font-size: 14px; font-weight: 900; margin: 20px 0 10px 0; text-transform: uppercase; border-bottom: 1px dashed var(--gold); padding-bottom: 8px; letter-spacing: 0.5px; }

        .item-card { background: var(--card); border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 12px; width: 100%; overflow: hidden; box-shadow: 0 4px 10px rgba(212, 175, 55, 0.12); }
        .item-main { padding: 14px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; cursor: pointer; touch-action: manipulation; }
        .item-main:active { background: #1a1a1a; }
        
        .deep-details { padding: 15px; background: #080808; border-top: 1px dashed var(--gold); font-size: 13px; }
        .d-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid #1a1a1a; }
        .d-row:last-child { border-bottom: none; }
        .d-row b { color: var(--gold); text-align: right; }

        .today-badge { background: var(--success); color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 900; display: inline-block; }
        .date-text { color: var(--success); font-weight: bold; font-size: 13px; text-align: center; }
        
        .loader { display: none; text-align: center; color: var(--gold); padding: 20px; font-weight: bold; letter-spacing: 1px; }
        .toggle-icon { font-size: 12px; color: var(--gold); margin-left: 5px; }
        .share-btn { width: 100%; margin-top: 12px; background: var(--gold); color: #000; font-weight: 900; border: none; padding: 12px; border-radius: 6px; cursor: pointer; text-transform: uppercase; touch-action: manipulation; }

        /* ================= AUTH & ADMIN CSS ================= */
        .auth-wrapper { display: flex; justify-content: center; align-items: center; min-height: 90vh; }
        .auth-card-inner { width: 100%; max-width: 400px; background: var(--card); border: 1px solid var(--gold); border-radius: 20px; padding: 25px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
        .auth-input { width: 100%; padding: 14px; margin-top: 10px; border-radius: 10px; border: 1px solid #333; background: black; color: white; font-size: 16px; outline: none; }
        .auth-input:focus { border-color: var(--gold); }
        .msg { margin-top: 12px; padding: 10px; border-radius: 8px; font-size: 14px; display: none; }
        .msg.error { background: #2a0000; color: #ff6666; border: 1px solid #ff3333; }
        .msg.success { background: #002a10; color: #00ff99; border: 1px solid #00ff99; }
        .msg.info { background: #1a1400; color: var(--gold); border: 1px solid var(--gold); }
        #blockScreen { display: none; position: fixed; inset: 0; background: black; z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: var(--red); text-align: center; gap: 12px; }
        
        .top-nav { display: flex; justify-content: space-between; align-items: center; background: #0a0a0a; padding: 15px; border-radius: 12px; border: 1px solid #333; margin-bottom: 20px; font-size: 13px; }
        .limit-badge { background: #002a10; color: var(--success); padding: 4px 8px; border-radius: 5px; font-weight: bold; border: 1px solid var(--success); }
        .admin-panel { display: none; margin-bottom: 20px; padding: 15px; border: 1px dashed var(--gold); border-radius: 12px; background: #1a1500; text-align: center; }

        @media (max-width: 480px) {
            .item-main { grid-template-columns: 1.2fr 1fr 1fr; gap: 5px; padding: 12px; }
            .header h2 { font-size: 18px; }
            .share-btn { font-size: 13px; padding: 10px; }
        }
    </style>
</head>
<body>

<div id="blockScreen">
    <div style="font-size:100px;">🚫</div>
    <h1>ACCESS DENIED</h1>
    <p>Aapka device block kar diya gaya hai.</p>
    <p id="blockedDevId" style="font-size:10px; color:#444;"></p>
</div>

<div class="container" id="authSection">
    <div class="auth-wrapper">
        <div class="auth-card-inner">
            <div class="logo" style="font-size: 30px; display: inline-block; margin-bottom: 20px;">CT PRO</div>
            <p id="authMsg" style="color:#888; margin-bottom:5px;">Security Verification</p>
            
            <input type="email" id="emailInput" class="auth-input" placeholder="Email Address">
            <input type="password" id="passInput" class="auth-input" placeholder="Password">
            
            <div id="authMsgBox" class="msg"></div>
            
            <button class="btn" id="authSubmitBtn">ENTER SYSTEM</button>
            <p style="margin-top:20px; font-size:14px;">
                <span id="toggleText">Naye user?</span>
                <span id="toggleBtn" style="color:var(--gold); cursor:pointer; text-decoration:underline; font-weight:bold;">Register Karein</span>
            </p>
        </div>
    </div>
</div>

<div class="container" id="mainApp" style="display:none;">
    
    <div class="top-nav">
        <div>
            <span style="color:#888;">User:</span> <b id="dispEmail" style="color:white;"></b><br>
            <span style="color:#888; font-size:11px;">Limit Left:</span> <span id="dispLimit" class="limit-badge">0</span>
        </div>
        <div>
            <button id="logoutBtn" style="background:var(--red); color:white; border:none; padding:8px 12px; border-radius:5px; cursor:pointer; font-weight:bold;">LOGOUT</button>
        </div>
    </div>

    <div id="adminPanel" class="admin-panel">
        <p style="color:var(--gold); font-weight:bold; font-size:14px; margin-bottom:8px;">👑 ADMIN CONTROL</p>
        <button id="logsBtn" style="background:white; color:black; border:none; padding:8px 15px; border-radius:5px; cursor:pointer; font-weight:bold; font-size:12px;">OPEN ADMIN DASHBOARD</button>
    </div>

    <div class="header">
        <div class="logo">CT</div>
        <h2 style="margin:0;">ContractTrack Pro</h2>
    </div>

    <div class="input-card">
        <textarea id="contractsInput" rows="4" placeholder="Enter Contracts (One per line)"></textarea>
        <button id="fetchBtn" class="btn">FETCH ALL RECEIPTS</button>
    </div>

    <div id="loader" class="loader">FETCHING DATA... PLEASE WAIT</div>

    <div id="fetchReport" class="report-box" style="display: none;">
        <div class="report-header">📊 Fetch Report</div>
        <div class="report-stats">
            <div>Total IDs: <b id="repTotal" style="color: #fff;">0</b></div>
            <div>Success: <b id="repSuccess" style="color: var(--success);">0</b></div>
            <div>Failed: <b id="repFailed" style="color: #ff4d4d;">0</b></div>
        </div>
        <div id="failedListContainer" style="display: none; margin-top: 5px; border-top: 1px solid #222; padding-top: 8px;">
            <div style="color: #888; font-size: 11px; margin-bottom: 4px;">Data Not Found For:</div>
            <div id="failedList"></div>
        </div>
    </div>

    <div class="stats">
        <div class="s-card">
            <small id="statLabelCount">Dikhne Wale Records</small>
            <div id="tCount" style="font-size: 20px; font-weight: bold; margin-top: 4px;">0</div>
        </div>
        <div class="s-card">
            <small id="statLabelAmt">Total Amount</small>
            <div id="tAmt" style="font-size: 20px; font-weight: bold; color:var(--success); margin-top: 4px;">₹0</div>
        </div>
    </div>

    <div class="filters-container">
        <input type="text" id="searchInput" class="filter-input" placeholder="🔍 Search Name, Contract...">
        <input type="date" id="dateFilter" class="filter-input">
    </div>

    <div id="todaySection" style="display: none;">
        <div class="section-title">⭐ Today's Paid Accounts</div>
        <div id="todayResults"></div>
    </div>

    <div id="otherSection" style="display: none;">
        <div class="section-title">📂 Previous Records</div>
        <div id="otherResults"></div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://openfpcdn.io/fingerprintjs/v4"></script>

<script is:inline>
(function() {
    // Wait for Supabase to be fully loaded
    function waitForSupabase(callback) {
        if (typeof supabase !== 'undefined') {
            callback();
        } else {
            setTimeout(function() { waitForSupabase(callback); }, 100);
        }
    }

    waitForSupabase(function() {
        const ADMIN_EMAIL = 'agurjeet768@gmail.com'; 
        const sb_client = supabase.createClient('https://ihcmbsvsfwakmmmymtxq.supabase.co', 'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE');

        let isLoginMode = true;
        let visitorId = "";
        
        const btnFetch = document.getElementById('fetchBtn');
        const inputContracts = document.getElementById('contractsInput');
        const searchInput = document.getElementById('searchInput');
        const dateFilter = document.getElementById('dateFilter');
        
        // Auth listeners
        document.getElementById('authSubmitBtn').addEventListener('click', handleAuth);
        document.getElementById('toggleBtn').addEventListener('click', toggleAuthMode);
        document.getElementById('logoutBtn').addEventListener('click', function() { sb_client.auth.signOut().then(function() { location.reload(); }); });
        document.getElementById('logsBtn').addEventListener('click', function() { window.location.href = '/admin'; });

        // Fingerprint Init
        if (typeof FingerprintJS !== 'undefined') {
            FingerprintJS.load().then(function(fp) { return fp.get(); }).then(function(r) { 
                visitorId = r.visitorId; 
                var blockedDevId = document.getElementById('blockedDevId');
                if(blockedDevId) blockedDevId.innerText = "Device: " + visitorId;
            }).catch(function() { visitorId = "dev-" + Date.now(); });
        } else {
            visitorId = "dev-" + Date.now();
        }

        function fetchIP() { 
            return fetch('https://api.ipify.org?format=json').then(function(r) { return r.json(); }).then(function(d) { return d.ip; }).catch(function() { return "Private"; }); 
        }
        
        function showMsg(id, type, text) { 
            var el = document.getElementById(id); 
            el.className = 'msg ' + type; 
            el.innerText = text; 
            el.style.display = 'block'; 
        }
        
        function hideMsg(id) { 
            var el = document.getElementById(id); 
            if (el) el.style.display = 'none'; 
        }

        // ================== AUTH LOGIC ==================
        function toggleAuthMode() {
            isLoginMode = !isLoginMode;
            hideMsg('authMsgBox');
            document.getElementById('authMsg').innerText = isLoginMode ? "Security Verification" : "Create Account";
            document.getElementById('authSubmitBtn').innerText = isLoginMode ? "ENTER SYSTEM" : "REGISTER NOW";
            document.getElementById('toggleText').innerText = isLoginMode ? "Naye user?" : "Already user?";
            document.getElementById('toggleBtn').innerText = isLoginMode ? "Register Karein" : "Login Karein";
        }

        async function handleAuth() {
            var email = document.getElementById('emailInput').value.trim();
            var pass = document.getElementById('passInput').value.trim();
            var btn = document.getElementById('authSubmitBtn');
            if (!email || !pass) { showMsg('authMsgBox', 'error', "Dono details bhariye!"); return; }

            hideMsg('authMsgBox'); 
            btn.disabled = true; 
            btn.innerText = "Processing...";

            try {
                if (isLoginMode) {
                    var { data, error } = await sb_client.auth.signInWithPassword({ email: email, password: pass });
                    if (error) { throw error; }
                    var ip = await fetchIP();
                    await sb_client.from('ContractTrack').update({ device_id: visitorId, last_ip: ip }).eq('email', email);
                    showMsg('authMsgBox', 'success', "Login successful!");
                    setTimeout(function() { checkSession(); }, 800);
                } else {
                    var { data, error } = await sb_client.auth.signUp({ email: email, password: pass });
                    if (error) { throw error; }
                    var ip = await fetchIP();
                    // Check if user exists in ContractTrack, if not insert
                    var { data: existing } = await sb_client.from('ContractTrack').select('email').eq('email', email).single();
                    if (!existing) {
                        await sb_client.from('ContractTrack').insert({ email: email, device_id: visitorId, last_ip: ip, limit_left: 10, is_blocked: false });
                    } else {
                        await sb_client.from('ContractTrack').update({ device_id: visitorId, last_ip: ip }).eq('email', email);
                    }
                    showMsg('authMsgBox', 'success', "Account ban gaya! Ab login karein.");
                    // Switch to login mode after successful registration
                    isLoginMode = true;
                    document.getElementById('authMsg').innerText = "Security Verification";
                    document.getElementById('authSubmitBtn').innerText = "ENTER SYSTEM";
                    document.getElementById('toggleText').innerText = "Naye user?";
                    document.getElementById('toggleBtn').innerText = "Register Karein";
                    document.getElementById('emailInput').value = "";
                    document.getElementById('passInput').value = "";
                }
            } catch (e) {
                console.error("Auth Error:", e);
                showMsg('authMsgBox', 'error', e.message.includes('invalid') ? "Galat details." : e.message);
            } finally {
                btn.disabled = false;
                btn.innerText = isLoginMode ? "ENTER SYSTEM" : "REGISTER NOW";
            }
        }

        async function checkSession() {
            var { data } = await sb_client.auth.getSession();
            if (data && data.session) {
                document.getElementById('authSection').style.display = 'none';
                document.getElementById('mainApp').style.display = 'block'; 
                document.getElementById('dispEmail').innerText = data.session.user.email;
                if (data.session.user.email === ADMIN_EMAIL) { document.getElementById('adminPanel').style.display = 'block'; }
                
                var dbRes = await sb_client.from('ContractTrack').select('*').eq('email', data.session.user.email).single();
                if (dbRes.data) {
                    document.getElementById('dispLimit').innerText = dbRes.data.limit_left !== null ? dbRes.data.limit_left : 0;
                    if (dbRes.data.is_blocked) document.getElementById('blockScreen').style.display = 'flex';
                } else {
                    // If user not in ContractTrack, add them
                    var ip = await fetchIP();
                    await sb_client.from('ContractTrack').insert({ email: data.session.user.email, device_id: visitorId, last_ip: ip, limit_left: 10, is_blocked: false });
                    document.getElementById('dispLimit').innerText = 10;
                }
            } else {
                document.getElementById('authSection').style.display = 'block';
                document.getElementById('mainApp').style.display = 'none';
            }
        }

        // ================== APP LOGIC & SMART DATA GETTER ==================
        window.allRecordsData = [];
        
        function cleanVal(val) {
            return (!val || String(val).toLowerCase() === 'null' || val === 'undefined') ? 'N/A' : val;
        }

        // Helper to find key case-insensitively
        function getVal(obj, keyName) {
            if (!obj) return 'N/A';
            var foundKey = Object.keys(obj).find(function(k) { return k.toLowerCase() === keyName.toLowerCase(); });
            return foundKey && obj[foundKey] !== undefined && obj[foundKey] !== null ? obj[foundKey] : 'N/A';
        }

        window.toggleCard = function(index) {
            var detailsDiv = document.getElementById('det-' + index);
            var iconSpan = document.getElementById('icon-' + index);
            if (detailsDiv.style.display === 'none') { 
                detailsDiv.style.display = 'block'; 
                iconSpan.innerText = '▲'; 
            } else { 
                detailsDiv.style.display = 'none'; 
                iconSpan.innerText = '▼'; 
            }
        };

        window.shareCard = function(index) {
            var item = window.allRecordsData[index];
            var shareText = '*ContractTrack Details*\n👤 Name: ' + getVal(item,'name') + '\n📝 Contract: ' + getVal(item,'contract') + '\n📱 Mobile: ' + getVal(item,'mobile') + '\n💰 Amount Paid: ₹' + getVal(item,'amount') + '\n📅 Date: ' + getVal(item,'date') + '\n🧾 Receipt: ' + getVal(item,'receipt_no');
            if (navigator.share) { 
                navigator.share({ title: 'Details', text: shareText }).catch(function(err) { console.log(err); }); 
            } else { 
                navigator.clipboard.writeText(shareText); 
                alert("Details copied!"); 
            }
        };

        function formatFilterDate(dateStr) {
            if(!dateStr) return "";
            var months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
            var parts = dateStr.split('-');
            return parts[2] + '-' + months[parseInt(parts[1])-1] + '-' + parts[0];
        }

        function applyFilters() {
            var term = searchInput.value.toLowerCase();
            var selectedDate = formatFilterDate(dateFilter.value);
            var visibleCount = 0, visibleAmt = 0;
            
            window.allRecordsData.forEach(function(item, index) {
                var card = document.getElementById('card-wrapper-' + index);
                if (!card) return;
                var matchesSearch = card.innerText.toLowerCase().includes(term);
                var itemDate = getVal(item, 'date');
                var matchesDate = selectedDate === "" || itemDate === selectedDate;

                if (matchesSearch && matchesDate) {
                    card.style.display = 'block'; 
                    visibleCount++;
                    var amtRaw = getVal(item, 'amount');
                    visibleAmt += parseFloat(String(amtRaw).replace(/,/g, '')) || 0;
                } else { 
                    card.style.display = 'none'; 
                }
            });
            document.getElementById('tCount').innerText = visibleCount;
            document.getElementById('tAmt').innerText = "₹" + visibleAmt.toLocaleString('en-IN');
        }

        if(searchInput) searchInput.addEventListener('input', applyFilters);
        if(dateFilter) dateFilter.addEventListener('change', applyFilters);

        // ================== MAIN FETCH BUTTON ==================
        if(btnFetch) {
            btnFetch.onclick = async function() {
                var val = inputContracts.value.trim();
                if(!val) { alert("Bhai, pehle contract number toh daalo box mein!"); return; }
                
                btnFetch.disabled = true;
                btnFetch.innerText = "CHECKING SECURE CONNECTION...";
                document.getElementById('loader').style.display = 'block';

                try {
                    var rawArray = val.split('\n').map(function(n) { return n.trim(); }).filter(function(n) { return n; });
                    var uniqueArray = [...new Set(rawArray)]; 
                    var requiredLimit = uniqueArray.length;

                    var sessionData = await sb_client.auth.getSession();
                    if (!sessionData || !sessionData.session) throw new Error("Session Error! Login karein."); 
                    
                    var email = sessionData.session.user.email;
                    var userRes = await sb_client.from('ContractTrack').select('*').eq('email', email).single();
                    var user = userRes.data;
                    
                    if (userRes.error || !user) throw new Error("Database error!");
                    if (user.is_blocked) { document.getElementById('blockScreen').style.display = 'flex'; return; }
                    
                    var currentLimit = user.limit_left !== null ? parseInt(user.limit_left) : 0;
                    if (currentLimit < requiredLimit) throw new Error("Limit khatam! Aapko " + requiredLimit + " limit chahiye, bachi hai: " + currentLimit);

                    btnFetch.innerText = "FETCHING API DATA...";
                    document.getElementById('todayResults').innerHTML = '';
                    document.getElementById('otherResults').innerHTML = '';
                    document.getElementById('todaySection').style.display = 'none';
                    document.getElementById('otherSection').style.display = 'none';
                    document.getElementById('fetchReport').style.display = 'none';

                    var list = uniqueArray.join(',');
                    var r = await fetch('https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=' + list);
                    if (!r.ok) throw new Error("API Server Down (Status: " + r.status + ")");
                    
                    var data = await r.json();
                    
                    console.log("API SE YE DATA AAYA HAI:", data);
                    
                    window.allRecordsData = data; 
                    var newLimit = currentLimit - requiredLimit;
                    document.getElementById('dispLimit').innerText = newLimit;

                    try {
                        var logEntries = uniqueArray.map(function(id) { return { email: email, search_query: id, device_id: visitorId }; });
                        await sb_client.from('search_logs').insert(logEntries);
                        await sb_client.from('ContractTrack').update({ limit_left: newLimit }).eq('email', email);
                    } catch (dbErr) { console.log("Log error", dbErr); }

                    var totalRequested = uniqueArray.length;
                    var totalFetched = data.length;
                    var failedCount = totalRequested - totalFetched;
                    
                    var fetchedIds = data.map(function(item) { return String(getVal(item, 'contract')).trim(); });
                    var failedIds = uniqueArray.filter(function(id) { return !fetchedIds.includes(String(id).trim()); });

                    document.getElementById('repTotal').innerText = totalRequested;
                    document.getElementById('repSuccess').innerText = totalFetched;
                    document.getElementById('repFailed').innerText = failedCount;

                    var failedListContainer = document.getElementById('failedListContainer');
                    if (failedCount > 0) {
                        failedListContainer.style.display = 'block';
                        document.getElementById('failedList').innerHTML = failedIds.map(function(id) { return '<span class="failed-badge">' + id + '</span>'; }).join('');
                    } else { 
                        failedListContainer.style.display = 'none'; 
                    }
                    
                    document.getElementById('fetchReport').style.display = 'block';
                    
                    var todayDate = new Date();
                    var today = todayDate.toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');
                    var todayHtml = ''; 
                    var otherHtml = '';

                    data.forEach(function(item, i) {
                        var itemName = getVal(item, 'name');
                        var itemContract = getVal(item, 'contract');
                        var itemDate = getVal(item, 'date');
                        var itemAmount = getVal(item, 'amount');
                        var itemMobile = getVal(item, 'mobile');
                        var itemEmi = getVal(item, 'emi_amount');
                        var itemOverdue = getVal(item, 'overdue');
                        var itemGuName = getVal(item, 'gu_name');
                        var itemGuMobile = getVal(item, 'gu_mobile');
                        var itemCoName = getVal(item, 'co_name');
                        var itemCoMobile = getVal(item, 'co_mobile');
                        var itemReceipt = getVal(item, 'receipt_no');
                        var itemInstr = getVal(item, 'instr');

                        var isToday = itemDate === today;
                        var emiAmountText = itemEmi !== 'N/A' ? '₹' + itemEmi : 'N/A';
                        var overdueText = cleanVal(itemOverdue) !== 'N/A' ? '₹' + itemOverdue : '0';
                        var dateDisplay = isToday ? '<span class="today-badge">TODAY</span>' : '<div class="date-text">' + (itemDate !== 'N/A' ? itemDate : '') + '</div>';

                        var cardHTML = `
                            <div class="item-card" id="card-wrapper-${i}">
                                <div class="item-main" onclick="toggleCard(${i})">
                                    <div>
                                        <div style="font-weight:bold; font-size: 15px;">${itemName}</div>
                                        <div style="color:var(--gold); font-size: 12px; margin-top: 4px; font-weight:bold;">${itemContract}</div>
                                    </div>
                                    <div style="text-align:center;">${dateDisplay}</div>
                                    <div style="text-align:right;">
                                        <div style="color:#d4af37; font-weight:bold; font-size: 17px;">₹${itemAmount}</div>
                                        <div style="font-size:11px; color:#aaa; margin-top: 6px; display:flex; align-items:center; justify-content:flex-end;">
                                            Details <span id="icon-${i}" class="toggle-icon">▼</span>
                                        </div>
                                    </div>
                                </div>
                                <div id="det-${i}" class="deep-details" style="display: none;">
                                    <div class="d-row"><span>Cust Mobile:</span> <b>${itemMobile}</b></div>
                                    <div class="d-row"><span>EMI Amount:</span> <b style="color:var(--success);">${emiAmountText}</b></div>
                                    <div class="d-row"><span>Over Dues:</span> <b style="color:#ff4d4d;">${overdueText}</b></div>
                                    <div class="d-row"><span>Guarantor:</span> <b>${itemGuName}</b></div>
                                    <div class="d-row"><span>GU Mobile:</span> <b>${itemGuMobile}</b></div>
                                    <div class="d-row"><span>Co-Applicant:</span> <b>${itemCoName}</b></div>
                                    <div class="d-row"><span>Co-App Mobile:</span> <b>${itemCoMobile}</b></div>
                                    <div class="d-row"><span>Receipt No:</span> <b style="color:#aaa;">${itemReceipt}</b></div>
                                    <div class="d-row"><span>Type:</span> <b style="color:#aaa;">${itemInstr}</b></div>
                                    <button class="share-btn" onclick="shareCard(${i})">🔗 Share Details</button>
                                </div>
                            </div>
                        `;
                        if (isToday) todayHtml += cardHTML; 
                        else otherHtml += cardHTML;
                    });

                    if (todayHtml === '') {
                        todayHtml = '<div style="text-align:center; padding:15px; color:#aaa; font-style:italic; background: var(--card); border-radius: 10px; border: 1px dashed var(--gold); margin-bottom:12px; font-size: 14px;">⏳ Abhi tak aaj ki date mein kisi contract par payment nahi aaya hai.</div>';
                    }

                    document.getElementById('todayResults').innerHTML = todayHtml;
                    document.getElementById('otherResults').innerHTML = otherHtml;

                    document.getElementById('todaySection').style.display = 'block';
                    if (otherHtml !== '') document.getElementById('otherSection').style.display = 'block';
                    
                    applyFilters();

                } catch (err) {
                    console.error("Fetch Error:", err);
                    alert("Error: " + err.message);
                } finally {
                    document.getElementById('loader').style.display = 'none';
                    btnFetch.disabled = false;
                    btnFetch.innerText = "FETCH ALL RECEIPTS";
                }
            };
        }

        // Run session check on load
        checkSession();
    });
})();
</script>
</body>
</html>
