<!DOCTYPE html>
<html lang="hi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CT PRO</title>

    <!-- SUPABASE -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <!-- FINGERPRINT -->
    <script src="https://openfpcdn.io/fingerprintjs/v4"></script>

    <style>
        :root {
            --gold: #d4af37;
            --bg: #050505;
            --card: #121212;
            --red: #ff3333;
            --green: #00ff99;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .card {
            width: 95%;
            max-width: 420px;
            background: var(--card);
            border: 1px solid var(--gold);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
        }

        .logo {
            color: var(--gold);
            font-size: 35px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        input {
            width: 100%;
            padding: 14px;
            margin-top: 10px;
            border-radius: 10px;
            border: 1px solid #333;
            background: black;
            color: white;
            font-size: 16px;
        }

        .btn {
            width: 100%;
            padding: 15px;
            margin-top: 15px;
            border: none;
            border-radius: 10px;
            background: var(--gold);
            color: black;
            font-weight: bold;
            cursor: pointer;
            font-size: 16px;
        }

        .tracking {
            background: black;
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
            text-align: left;
            font-size: 13px;
            border-left: 4px solid var(--gold);
        }

        .tracking b {
            color: var(--gold);
        }

        #mainApp {
            display: none;
        }

        #blockScreen {
            display: none;
            position: fixed;
            inset: 0;
            background: black;
            z-index: 9999;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            color: red;
            text-align: center;
        }
    </style>
</head>

<body>

    <!-- BLOCK SCREEN -->
    <div id="blockScreen">

        <div style="font-size:80px;">
            🚫
        </div>

        <h1>
            ACCESS DENIED
        </h1>

        <p>
            Device Blocked
        </p>

        <p id="blockedDevId"></p>

    </div>

    <!-- MAIN CARD -->
    <div class="card">

        <div class="logo">
            CT PRO
        </div>

        <!-- LOGIN / REGISTER -->
        <div id="authBox">

            <p id="authMsg">
                Security Clearance Required
            </p>

            <input type="email"
                   id="email"
                   placeholder="Email Address">

            <input type="password"
                   id="pass"
                   placeholder="Password">

            <button class="btn"
                    id="submitBtn"
                    onclick="handleAuth()">
                ENTER SYSTEM
            </button>

            <p style="margin-top:20px; font-size:14px;">

                <span id="toggleText">
                    Naye user?
                </span>

                <span id="toggleBtn"
                      onclick="toggleMode()"
                      style="color:var(--gold);
                             cursor:pointer;
                             text-decoration:underline;">

                    Register Karein

                </span>

            </p>

        </div>

        <!-- APP -->
        <div id="mainApp">

            <div class="tracking">

                <b>WELCOME:</b>
                <span id="dispEmail"></span>
                <br><br>

                <b>IP:</b>
                <span id="dispIP"></span>
                <br><br>

                <b>DEVICE:</b>
                <span id="dispDev"></span>
                <br><br>

                <b>LIMIT:</b>
                <span id="dispLimit"
                      style="color:var(--green);">
                    0
                </span>

            </div>

            <input type="text"
                   id="searchId"
                   placeholder="Enter Contract No">

            <button class="btn"
                    onclick="runSearch()">
                START SEARCH
            </button>

            <button class="btn"
                    onclick="logout()"
                    style="background:red;color:white;">
                LOGOUT
            </button>

        </div>

    </div>

    <script>

        // ==========================
        // SUPABASE CONFIG
        // ==========================

        const SB_URL =
            'https://ihcmbsvsfwakmmmymtxq.supabase.co';

        const SB_KEY =
            'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE';

        const supabase =
            window.supabase.createClient(
                SB_URL,
                SB_KEY
            );

        // ==========================

        let isLogin = true;

        let visitorId = "";

        // ==========================
        // DEVICE SECURITY
        // ==========================

        async function startSecurity() {

            try {

                const fp =
                    await FingerprintJS.load();

                const result =
                    await fp.get();

                visitorId =
                    result.visitorId;

                document
                    .getElementById('dispDev')
                    .innerText = visitorId;

                document
                    .getElementById('blockedDevId')
                    .innerText = visitorId;

            } catch (e) {

                console.log(e);

            }

        }

        // ==========================
        // TOGGLE MODE
        // ==========================

        function toggleMode() {

            isLogin = !isLogin;

            if (isLogin) {

                document
                    .getElementById('authMsg')
                    .innerText =
                    "Security Clearance Required";

                document
                    .getElementById('submitBtn')
                    .innerText =
                    "ENTER SYSTEM";

                document
                    .getElementById('toggleText')
                    .innerText =
                    "Naye user?";

                document
                    .getElementById('toggleBtn')
                    .innerText =
                    "Register Karein";

            } else {

                document
                    .getElementById('authMsg')
                    .innerText =
                    "Create New Account";

                document
                    .getElementById('submitBtn')
                    .innerText =
                    "REGISTER";

                document
                    .getElementById('toggleText')
                    .innerText =
                    "Already account hai?";

                document
                    .getElementById('toggleBtn')
                    .innerText =
                    "Login Karein";

            }

        }

        // ==========================
        // FETCH IP
        // ==========================

        async function fetchIP() {

            try {

                const r =
                    await fetch(
                        'https://api.ipify.org?format=json'
                    );

                const d =
                    await r.json();

                document
                    .getElementById('dispIP')
                    .innerText = d.ip;

                return d.ip;

            } catch {

                return "Unknown";

            }

        }

        // ==========================
        // LOGIN / REGISTER
        // ==========================

        async function handleAuth() {

            const email =
                document
                .getElementById('email')
                .value
                .trim();

            const password =
                document
                .getElementById('pass')
                .value
                .trim();

            if (!email || !password) {

                alert("Email aur password dalo");

                return;

            }

            const ip =
                await fetchIP();

            // ======================
            // LOGIN
            // ======================

            if (isLogin) {

                const { data, error } =
                    await supabase.auth
                    .signInWithPassword({

                        email,
                        password

                    });

                console.log(data);
                console.log(error);

                if (error) {

                    alert(
                        "Login Error : " +
                        error.message
                    );

                    return;

                }

                // SAVE LOGIN INFO

                await supabase
                    .from('ContractTrack')
                    .upsert({

                        email: email,
                        device_id: visitorId,
                        last_ip: ip,
                        limit_left: 5

                    }, {

                        onConflict: 'email'

                    });

                alert("Login Successful");

                location.reload();

            }

            // ======================
            // REGISTER
            // ======================

            else {

                const { data, error } =
                    await supabase.auth
                    .signUp({

                        email,
                        password,

                        options: {
                            emailRedirectTo:
                                window.location.href
                        }

                    });

                console.log(data);
                console.log(error);

                if (error) {

                    alert(
                        "Register Error : " +
                        error.message
                    );

                    return;

                }

                // INSERT USER DATA

                const { error: dbError } =
                    await supabase
                    .from('ContractTrack')
                    .upsert({

                        email: email,
                        device_id: visitorId,
                        last_ip: ip,
                        limit_left: 5,
                        is_blocked: false

                    }, {

                        onConflict: 'email'

                    });

                console.log(dbError);

                alert(
                    "Account Ban Gaya! Ab Login Karein."
                );

                toggleMode();

            }

        }

        // ==========================
        // SEARCH
        // ==========================

        async function runSearch() {

            const id =
                document
                .getElementById('searchId')
                .value
                .trim();

            if (!id) {

                alert("Contract Number dalo");

                return;

            }

            const { data: user } =
                await supabase
                .from('ContractTrack')
                .select('*')
                .eq('device_id', visitorId)
                .single();

            if (!user) {

                alert("User data nahi mila");

                return;

            }

            if (user.limit_left <= 0) {

                alert("Limit Khatam");

                return;

            }

            alert("Searching : " + id);

            await supabase
                .from('ContractTrack')
                .update({

                    limit_left:
                        user.limit_left - 1

                })
                .eq(
                    'device_id',
                    visitorId
                );

            document
                .getElementById('dispLimit')
                .innerText =
                user.limit_left - 1;

        }

        // ==========================
        // LOGOUT
        // ==========================

        async function logout() {

            await supabase.auth.signOut();

            location.reload();

        }

        // ==========================
        // SESSION CHECK
        // ==========================

        async function checkSession() {

            const {
                data: {
                    session
                }
            } =
            await supabase.auth
                .getSession();

            if (session) {

                document
                    .getElementById('authBox')
                    .style.display = 'none';

                document
                    .getElementById('mainApp')
                    .style.display = 'block';

                document
                    .getElementById('dispEmail')
                    .innerText =
                    session.user.email;

                const { data } =
                    await supabase
                    .from('ContractTrack')
                    .select('*')
                    .eq(
                        'email',
                        session.user.email
                    )
                    .single();

                if (data) {

                    document
                        .getElementById('dispLimit')
                        .innerText =
                        data.limit_left;

                }

            }

        }

        // ==========================
        // START
        // ==========================

        startSecurity();

        checkSession();

        fetchIP();

    </script>

</body>

</html>
