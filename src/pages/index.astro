---
// index.astro - Final Professional Dashboard
---
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ContractTrack Pro - Smart Dashboard</title>
    <style>
        :root { 
            --gold: #d4af37; 
            --dark-bg: #121212; 
            --card-bg: #1e1e1e; 
            --border: #2d2d2d; 
            --success: #22c55e; 
            --text-main: #ffffff;
        }
        body { 
            font-family: 'Inter', system-ui, sans-serif; 
            background-color: var(--dark-bg); 
            color: var(--text-main); 
            margin: 0; 
            padding: 15px; 
        }
        .container { max-width: 850px; margin: 0 auto; }
        
        /* Header */
        .header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
        .logo { background: var(--gold); color: #000; padding: 6px 12px; border-radius: 6px; font-weight: 900; }

        /* Input Card */
        .input-card { 
            background: var(--card-bg); 
            padding: 20px; 
            border-radius: 12px; 
            border: 1px solid var(--border); 
            margin-bottom: 25px; 
        }
        label { color: var(--gold); font-size: 11px; font-weight: 800; display: block; margin-bottom: 8px; text-transform: uppercase; }
        textarea { 
            width: 100%; 
            background: #000; 
            border: 1px solid var(--border); 
            color: #fff; 
            padding: 12px; 
            border-radius: 8px; 
            box-sizing: border-box; 
            font-family: monospace;
            font-size: 14px;
        }
        .btn { 
            width: 100%; 
            background: var(--gold); 
            color: #000; 
            border: none; 
            padding: 14px; 
            border-radius: 8px; 
            font-weight: 800; 
            cursor: pointer; 
            margin-top: 12px; 
            text-transform: uppercase;
        }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }

        /* Today's Stats */
        .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 25px; }
        .stat-card { background: var(--card-bg); padding: 15px; border-radius: 12px; border: 1px solid var(--border); }
        .stat-card small { color: #888; font-size: 10px; text-transform: uppercase; display: block; }
        .stat-card div { font-size: 22px; font-weight: 800; margin-top: 5px; }

        /* Table Design */
        .table-section { 
            background: var(--card-bg); 
            border-radius: 12px; 
            border: 1px solid var(--border); 
            margin-bottom: 30px; 
            overflow: hidden;
        }
        .section-header { 
            padding: 15px; 
            background: #252525; 
            border-bottom: 1px solid var(--border); 
            font-weight: 800; 
            color: var(--gold); 
            font-size: 14px;
        }
        .table-wrapper { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; min-width: 650px; }
        th { text-align: left; padding: 12px; font-size: 11px; color: #666; text-transform: uppercase; border-bottom: 1px solid var(--border); }
        td { padding: 14px 12px; border-bottom: 1px solid #252525; font-size: 13px; }
        
        .today-row { background: rgba(34, 197, 94, 0.05); }
        .today-badge { background: var(--success); color: #000; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: 900; }
        .loading { display: none; color: var(--gold); text-align: center; padding: 15px; font-weight: bold; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { opacity: 0.5; } 50% { opacity: 1; } 100% { opacity: 0.5; } }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">CT</div>
            <h2 style="margin:0; font-size: 1.5rem;">ContractTrack Pro</h2>
        </div>

        <div class="input-card">
            <label>Contract Numbers (Ek line mein ek daalein)</label>
            <textarea id="contractsInput" rows="6" placeholder="9420000&#10;7795753&#10;8703919"></textarea>
            <button id="fetchBtn" class="btn">FETCH ALL RECEIPTS</button>
        </div>

        <div id="loader" class="loading">SABHI RECORDS FETCH HO RAHE HAIN...</div>

        <div class="summary-grid">
            <div class="stat-card"><small>Aaj ke Records</small><div id="tCount">0</div></div>
            <div class="stat-card"><small>Aaj ka Total Amount</small><div id="tAmt" style="color:var(--success);">₹0</div></div>
        </div>

        <div class="table-section" id="todaySection" style="display:none;">
            <div class="section-header">TODAY'S PAID ACCOUNTS</div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr><th>Contract</th><th>Customer Name</th><th>Receipt No</th><th>Amount</th><th>Status</th></tr>
                    </thead>
                    <tbody id="todayResults"></tbody>
                </table>
            </div>
        </div>

        <div class="table-section">
            <div class="section-header">ALL RECORDS (FULL LIST)</div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr><th>Contract</th><th>Customer Name</th><th>Date</th><th>Amount</th><th>Type</th></tr>
                    </thead>
                    <tbody id="allResults"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        const fetchBtn = document.getElementById('fetchBtn');
        const inputField = document.getElementById('contractsInput');
        const loader = document.getElementById('loader');

        fetchBtn.onclick = async () => {
            const text = inputField.value.trim();
            if(!text) return alert("Numbers daalna zaroori hai!");

            // Line breaks detect karke comma mein badalna
            const cleanList = text.split('\n').map(n => n.trim()).filter(n => n).join(',');
            
            loader.style.display = 'block';
            fetchBtn.disabled = true;
            fetchBtn.innerText = "PROCESSING...";

            try {
                const response = await fetch(`https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${cleanList}`);
                const data = await response.json();
                
                const today = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');
                
                let allRows = '', todayRows = '', tCount = 0, tAmt = 0;

                data.forEach(item => {
                    const isToday = item.date === today;
                    const amountValue = parseFloat(item.amount.toString().replace(/,/g, '')) || 0;

                    const rowHtml = `
                        <tr class="${isToday ? 'today-row' : ''}">
                            <td>${item.contract}</td>
                            <td style="font-weight:700;">${item.name}</td>
                            <td>${isToday ? '<span class="today-badge">TODAY</span>' : item.date}</td>
                            <td style="color:var(--gold); font-weight:800;">₹${item.amount}</td>
                            <td style="font-size:11px; color:#777;">${item.instr || 'N/A'}</td>
                        </tr>
                    `;

                    allRows += rowHtml;

                    if(isToday) {
                        tCount++;
                        tAmt += amountValue;
                        todayRows += rowHtml;
                    }
                });

                document.getElementById('allResults').innerHTML = allRows || '<tr><td colspan="5" style="text-align:center;">No data found.</td></tr>';
                document.getElementById('todayResults').innerHTML = todayRows;
                
                // Today section show/hide
                document.getElementById('todaySection').style.display = todayRows ? 'block' : 'none';
                
                // Summary updates
                document.getElementById('tCount').innerText = tCount;
                document.getElementById('tAmt').innerText = "₹" + tAmt.toLocaleString('en-IN');

            } catch (err) {
                alert("API Response mein error hai. Hugging Face check karein.");
            } finally {
                loader.style.display = 'none';
                fetchBtn.disabled = false;
                fetchBtn.innerText = "FETCH ALL RECEIPTS";
            }
        }
    </script>
</body>
</html>
