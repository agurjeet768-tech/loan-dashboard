<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ContractTrack Pro - Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    
    <style is:global>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; } 
        :root { --gold: #d4af37; --bg: #000; --card: #151515; --border: #222; --success: #22c55e; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: #fff; margin: 0; padding: 12px; overflow-x: hidden; }
        
        .container { max-width: 450px; margin: 40px auto; width: 100%; padding: 10px; }
        .logo-box { text-align: center; margin-bottom: 30px; }
        .logo { background: var(--gold); color: #000; padding: 10px 20px; border-radius: 6px; font-weight: 900; font-size: 26px; display: inline-block; box-shadow: 0 0 15px rgba(212, 175, 55, 0.3); }
        
        .auth-card { background: var(--card); padding: 25px; border-radius: 16px; border: 1px solid var(--gold); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .auth-title { color: var(--gold); text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 25px; text-transform: uppercase; letter-spacing: 1px; }
        
        .input-field { width: 100%; background: #080808; border: 1px solid var(--border); color: #fff; padding: 14px; border-radius: 10px; margin-bottom: 15px; font-size: 15px; transition: 0.3s; }
        .input-field:focus { outline: none; border-color: var(--gold); background: #000; }
        
        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 15px; border-radius: 10px; font-weight: 900; cursor: pointer; text-transform: uppercase; font-size: 16px; transition: 0.2s; letter-spacing: 1px; }
        .btn:active { transform: scale(0.97); }
        .btn:disabled { background: #555; cursor: not-allowed; }
        
        .switch-text { text-align: center; margin-top: 20px; font-size: 14px; color: #888; line-height: 1.5; }
        .switch-text span { color: var(--gold); font-weight: bold; cursor: pointer; text-decoration: underline; margin-left: 5px; }

        #msgBox { text-align: center; margin-bottom: 15px; padding: 10px; border-radius: 8px; font-size: 14px; display: none; background: rgba(255,255,255,0.05); }
        
        #mainApp { display: none; padding-top: 20px; }
        #authSection { display: block; }
    </style>
</head>
<body>

    <div id="authSection" class="container">
        <div class="logo-box">
            <div class="logo">CT PRO</div>
            <h2 style="margin: 15px 0 0 0; font-size: 22px; letter-spacing: -0.5px;">Premium Access</h2>
        </div>

        <div class="auth-card">
            <div id="msgBox"></div>
            
            <h3 id="formTitle" class="auth-title">Security Login</h3>
            
            <input type="email" id="emailInput" class="input-field" placeholder="Email Address" required>
            <input type="password" id="passInput" class="input-field" placeholder="Secret Password" required>
            
            <button id="authBtn" class="btn" onclick="handleAuth()">ENTER SYSTEM</button>
            
            <div class="switch-text" id="toggleMode">
                Naye user hain? <span onclick="toggleAuthMode()">Register karein</span>
            </div>
        </div>
    </div>

    <div id="mainApp" class="container">
        <div style="background: var(--card); border: 1px solid var(--gold); padding: 20px; border-radius: 15px; text-align: center;">
            <div style="font-size: 40px; margin-bottom: 10px;">🔓</div>
            <h2 style="color: var(--gold);">Access Granted!</h2>
            <p style="color: #aaa; margin-bottom: 25px;">Aapka account verify ho gaya hai.</p>
            
            <button onclick="logout()" style="background: transparent; color: #ff4d4d; border: 1px solid #ff4d4d; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; width: 100%;">LOGOUT SECURELY</button>
        </div>
        
        <p style="text-align: center; font-size: 12px; color: #444; margin-top: 30px;">
            Hugging Face & Supabase Secured Connection
        </p>
    </div>

    <script>
        // --- ⚙️ SUPABASE CONFIGURATION (AUTOMATED) ---
        const SUPABASE_URL = 'https://ihcmbsvsfwakmmmymtxq.supabase.co'; 
        const SUPABASE_ANON_KEY = 'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE';
        // --------------------------------------------

        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        
        let isLoginMode = true; 
        const msgBox = document.getElementById('msgBox');
        const authBtn = document.getElementById('authBtn');
        
        function showMsg(text, isError) {
            msgBox.style.display = 'block';
            msgBox.innerText = text;
            msgBox.style.color = isError ? '#ff4d4d' : 'var(--success)';
            msgBox.style.border = isError ? '1px solid #ff4d4d' : '1px solid var(--success)';
        }

        function toggleAuthMode() {
            isLoginMode = !isLoginMode;
            document.getElementById('formTitle').innerText = isLoginMode ? 'Security Login' : 'New Registration';
            authBtn.innerText = isLoginMode ? 'ENTER SYSTEM' : 'CREATE ACCOUNT';
            document.getElementById('toggleMode').innerHTML = isLoginMode 
                ? 'Naye user hain? <span onclick="toggleAuthMode()">Register karein</span>'
                : 'Pehle se account hai? <span onclick="toggleAuthMode()">Login karein</span>';
            msgBox.style.display = 'none';
        }

        async function handleAuth() {
            const email = document.getElementById('emailInput').value.trim();
            const password = document.getElementById('passInput').value.trim();

            if(!email || !password) {
                showMsg("Bhai, Email aur Password dono daalo!", true);
                return;
            }

            authBtn.disabled = true;
            authBtn.innerText = "VERIFYING...";
            
            if(isLoginMode) {
                // --- LOGIN ---
                const { data, error } = await supabase.auth.signInWithPassword({ email, password });
                if(error) {
                    showMsg("Galti: " + error.message, true);
                    authBtn.disabled = false;
                    authBtn.innerText = "ENTER SYSTEM";
                } else {
                    showMsg("Success! Dashboard khul raha hai...", false);
                    checkUserSession();
                }
            } else {
                // --- REGISTER ---
                const { data, error } = await supabase.auth.signUp({ email, password });
                if(error) {
                    showMsg("Galti: " + error.message, true);
                    authBtn.disabled = false;
                    authBtn.innerText = "CREATE ACCOUNT";
                } else {
                    showMsg("Account ban gaya! Ab Login kijiye.", false);
                    authBtn.disabled = false;
                    authBtn.innerText = "CREATE ACCOUNT";
                }
            }
        }

        async function logout() {
            await supabase.auth.signOut();
            checkUserSession();
            location.reload(); // Fresh start for login
        }

        async function checkUserSession() {
            const { data: { session } } = await supabase.auth.getSession();
            if (session) {
                document.getElementById('authSection').style.display = 'none';
                document.getElementById('mainApp').style.display = 'block';
                console.log("Logged In User:", session.user.email);
            } else {
                document.getElementById('authSection').style.display = 'block';
                document.getElementById('mainApp').style.display = 'none';
            }
        }

        // Initialize session check
        checkUserSession();
    </script>
</body>
</html>
