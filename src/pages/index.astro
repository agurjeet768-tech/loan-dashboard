<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CT PRO - Admin Access</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
    <script src="https://openfpcdn.io/fingerprintjs/v4"></script>

    <style>
        :root { --gold: #d4af37; --bg: #050505; --card: #121212; --green: #00ff99; --red: #ff4444; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: white; font-family: 'Segoe UI', sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 15px; }
        
        .card { width: 100%; max-width: 450px; background: var(--card); border: 1px solid var(--gold); border-radius: 20px; padding: 25px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
        .logo { color: var(--gold); font-size: 32px; font-weight: 900; margin-bottom: 20px; letter-spacing: 1px; }
        
        input { width: 100%; padding: 14px; margin-top: 10px; border-radius: 10px; border: 1px solid #333; background: black; color: white; font-size: 16px; outline: none; }
        input:focus { border-color: var(--gold); }
        
        .btn { width: 100%; padding: 15px; margin-top: 15px; border: none; border-radius: 10px; background: var(--gold); color: black; font-weight: bold; cursor: pointer; font-size: 16px; text-transform: uppercase; transition: 0.3s; }
        .btn:active { transform: scale(0.98); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .tracking { background: #000; padding: 15px; border-radius: 12px; margin: 20px 0; text-align: left; font-size: 12px; border-left: 4px solid var(--gold); line-height: 1.6; }
        .tracking b { color: var(--gold); }
        
        .msg { margin-top: 12px; padding: 10px; border-radius: 8px; font-size: 14px; display: none; }
        .msg.error { background: #2a0000; color: #ff6666; border: 1px solid #ff3333; }
        .msg.success { background: #002a10; color: #00ff99; border: 1px solid #00ff99; }
        
        #blockScreen { display: none; position: fixed; inset: 0; background: black; z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: var(--red); text-align: center; }
        
        .admin-panel { display: none; margin-top: 20px; padding: 15px; border: 1px dashed var(--gold); border-radius: 12px; background: #1a1500; }
    </style>
</head>
<body>

    <div id="blockScreen">
        <div style="font-size:100px;">🚫</div>
        <h1>ACCESS DENIED</h1>
        <p>Aapka Device ya IP block kar diya gaya hai.</p>
        <p style="font-size: 10px; color: #444;" id="blockedDevId"></p>
    </div>

    <div class="card">
        <div class="logo">CT PRO</div>

        <div id="authBox">
            <p id="authMsg" style="color: #888;">Security Verification Required</p>
            <input type="email" id="email" placeholder="Email Address">
            <input type="password" id="pass" placeholder="Password">
            <div id="authMsgBox" class="msg"></div>
            <button class="btn" id="submitBtn" onclick="handleAuth()">ENTER SYSTEM</button>
            <p style="margin-top:20px; font-size:14px;">
                <span id="toggleText">Naye user?</span>
                <span id="toggleBtn" onclick="toggleMode()" style="color:var(--gold); cursor:pointer; text-decoration:underline; font-weight:bold;">Register Karein</span>
            </p>
        </div>

        <div id="mainApp" style="display:none;">
            <div class="tracking">
                <b>WELCOME:</b> <span id="dispEmail"></span><br>
                <b>MY IP:</b> <span id="dispIP">Detecting...</span><br>
                <b>DEVICE ID:</b> <span id="dispDev">Scanning...</span><br>
                <b>SEARCH LIMIT:</b> <span id="dispLimit" style="color:var(--green); font-weight:bold;">0</span>
            </div>

            <input type="text" id="searchId" placeholder="Enter Contract No">
            <div id="searchMsgBox" class="msg"></div>
            <button class="btn" onclick="runSearch()">START SEARCH</button>

            <div id="adminPanel" class="admin-panel">
                <p style="color:var(--gold); font-weight:bold; font-size:14px; margin:0;">👑 ADMIN CONTROL</p>
                <button class="btn" style="background:white; margin-top:10px; font-size:12px;" onclick="viewLogs()">CHECK ALL SEARCH LOGS</button>
            </div>

            <button class="btn" onclick="doLogout()" style="background:var(--red); color:white; margin-top:20px; font-size:14px;">LOGOUT SECURELY</button>
        </div>
    </div>

    <script>
        // --- CONFIG ---
        const ADMIN_EMAIL = 'agurjeet768@gmail.com'; 
        const sb_client = window.supabase.createClient('https://ihcmbsvsfwakmmmymtxq.supabase.co', 'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE');

        var isLoginMode = true;
        var visitorId = "";

        // 1. Device Security Init
        function initSecurity() {
            FingerprintJS.load().then(fp => fp.get()).then(r => {
                visitorId = r.visitorId;
                document.getElementById('dispDev').innerText = visitorId;
                document.getElementById('blockedDevId').innerText = "Device: " + visitorId;
            });
        }

        // 2. IP Capture
        async function fetchIP() {
            try {
                const r = await fetch('https://api.ipify.org?format=json');
                const d = await r.json();
                document.getElementById('dispIP').innerText = d.ip;
                return d.ip;
            } catch { return "Private"; }
        }

        function toggleMode() {
            isLoginMode = !isLoginMode;
            document.getElementById('authMsg').innerText = isLoginMode ? "Security Verification Required" : "Create Professional ID";
            document.getElementById('submitBtn').innerText = isLoginMode ? "ENTER SYSTEM" : "REGISTER NOW";
            document.getElementById('toggleText').innerText = isLoginMode ? "Naye user?" : "Already user?";
            document.getElementById('toggleBtn').innerText = isLoginMode ? "Register Karein" : "Login Karein";
        }

        // 3. Auth Handler
        async function handleAuth() {
            var email = document.getElementById('email').value.trim();
            var pass = document.getElementById('pass').value.trim();
            var msgBox = document.getElementById('authMsgBox');
            var btn = document.getElementById('submitBtn');

            if (!email || !pass) {
                msgBox.innerText = "Dono details bhariye!";
                msgBox.className = "msg error";
                msgBox.style.display = "block";
                return;
            }

            btn.disabled = true;
            btn.innerText = "Processing...";

            if (isLoginMode) {
                const { data, error } = await sb_client.auth.signInWithPassword({ email, password: pass });
                if (error) {
                    msgBox.innerText = error.message;
                    msgBox.className = "msg error";
                    msgBox.style.display = "block";
                    btn.disabled = false;
                    btn.innerText = "ENTER SYSTEM";
                } else {
                    const ip = await fetchIP();
                    await sb_client.from('ContractTrack').upsert({ email, device_id: visitorId, last_ip: ip }, { onConflict: 'email' });
                    location.reload();
                }
            } else {
                const { data, error } = await sb_client.auth.signUp({ email, password: pass });
                if (error) {
                    msgBox.innerText = error.message;
                    msgBox.className = "msg error";
                    msgBox.style.display = "block";
                    btn.disabled = false;
                    btn.innerText = "REGISTER NOW";
                } else {
                    const ip = await fetchIP();
                    // Naye user ko 10 limit dena
                    await sb_client.from('ContractTrack').insert({ email, device_id: visitorId, last_ip: ip, limit_left: 10, is_blocked: false });
                    msgBox.innerText = "Success! Ab Login kijiye.";
                    msgBox.className = "msg success";
                    msgBox.style.display = "block";
                    btn.disabled = false;
                    btn.innerText = "REGISTER NOW";
                }
            }
        }

        // 4. Search & Log Logic
        async function runSearch() {
            var id = document.getElementById('searchId').value.trim();
            var sMsg = document.getElementById('searchMsgBox');
            if (!id) return;

            const { data: { session } } = await sb_client.auth.getSession();
            const { data: user } = await sb_client.from('ContractTrack').select('*').eq('email', session.user.email).single();

            if (user.is_blocked) { document.getElementById('blockScreen').style.display = 'flex'; return; }
            if (user.limit_left <= 0) { 
                sMsg.innerText = "Limit Khatam! Contact Admin.";
                sMsg.className = "msg error";
                sMsg.style.display = "block";
                return; 
            }

            // LOG SAVE KARNA
            await sb_client.from('search_logs').insert({ email: session.user.email, search_query: id, device_id: visitorId });
            
            // Limit kam karna
            var newLimit = user.limit_left - 1;
            await sb_client.from('ContractTrack').update({ limit_left: newLimit }).eq('email', session.user.email);
            
            document.getElementById('dispLimit').innerText = newLimit;
            sMsg.innerText = "Searching: " + id;
            sMsg.className = "msg success";
            sMsg.style.display = "block";
        }

        // 5. Admin View Logs
        async function viewLogs() {
            const { data } = await sb_client.from('search_logs').select('*').order('created_at', { ascending: false });
            console.table(data);
            alert("Bhai, Laptop par F12 dabao aur 'Console' tab dekho. Wahan puri list mil jayegi!");
        }

        async function checkSession() {
            const { data: { session } } = await sb_client.auth.getSession();
            if (session) {
                document.getElementById('authBox').style.display = 'none';
                document.getElementById('mainApp').style.display = 'block';
                document.getElementById('dispEmail').innerText = session.user.email;

                // Admin Check
                if (session.user.email === ADMIN_EMAIL) {
                    document.getElementById('adminPanel').style.display = 'block';
                }

                const { data: user } = await sb_client.from('ContractTrack').select('*').eq('email', session.user.email).single();
                if (user) {
                    document.getElementById('dispLimit').innerText = user.limit_left;
                    if (user.is_blocked) document.getElementById('blockScreen').style.display = 'flex';
                }
            }
        }

        function doLogout() { sb_client.auth.signOut().then(() => location.reload()); }

        initSecurity();
        fetchIP();
        checkSession();
    </script>
</body>
</html>
