---
// CT PRO - Astro Page
// Koi import nahi, koi JS nahi yahan
---
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CT PRO - Admin Access</title>
    <style>
        :root { --gold: #d4af37; --bg: #050505; --card: #121212; --green: #00ff99; --red: #ff4444; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: var(--bg); color: white; font-family: 'Segoe UI', sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 15px; }
        .card { width: 100%; max-width: 450px; background: var(--card); border: 1px solid var(--gold); border-radius: 20px; padding: 25px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
        .logo { color: var(--gold); font-size: 32px; font-weight: 900; margin-bottom: 20px; letter-spacing: 2px; }
        input { width: 100%; padding: 14px; margin-top: 10px; border-radius: 10px; border: 1px solid #333; background: black; color: white; font-size: 16px; outline: none; }
        input:focus { border-color: var(--gold); }
        .btn { width: 100%; padding: 15px; margin-top: 15px; border: none; border-radius: 10px; background: var(--gold); color: black; font-weight: bold; cursor: pointer; font-size: 16px; text-transform: uppercase; transition: 0.3s; }
        .btn:active { transform: scale(0.98); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .tracking { background: #000; padding: 15px; border-radius: 12px; margin: 20px 0; text-align: left; font-size: 12px; border-left: 4px solid var(--gold); line-height: 2; }
        .tracking b { color: var(--gold); }
        .msg { margin-top: 12px; padding: 10px; border-radius: 8px; font-size: 14px; display: none; }
        .msg.error   { background: #2a0000; color: #ff6666; border: 1px solid #ff3333; }
        .msg.success { background: #002a10; color: #00ff99; border: 1px solid #00ff99; }
        .msg.info    { background: #1a1400; color: var(--gold); border: 1px solid var(--gold); }
        #blockScreen { display: none; position: fixed; inset: 0; background: black; z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: var(--red); text-align: center; gap: 12px; }
        .admin-panel { display: none; margin-top: 20px; padding: 15px; border: 1px dashed var(--gold); border-radius: 12px; background: #1a1500; }
    </style>
</head>
<body>

<div id="blockScreen">
    <div style="font-size:100px;">🚫</div>
    <h1>ACCESS DENIED</h1>
    <p>Aapka device block kar diya gaya hai.</p>
    <p id="blockedDevId" style="font-size:10px; color:#444;"></p>
</div>

<div class="card">
    <div class="logo">CT PRO</div>

    <div id="authBox">
        <p id="authMsg" style="color:#888; margin-bottom:5px;">Security Verification Required</p>
        <input type="email"    id="email" placeholder="Email Address">
        <input type="password" id="pass"  placeholder="Password">
        <div id="authMsgBox" class="msg"></div>
        <button class="btn" id="submitBtn">ENTER SYSTEM</button>
        <p style="margin-top:20px; font-size:14px;">
            <span id="toggleText">Naye user?</span>
            <span id="toggleBtn" style="color:var(--gold); cursor:pointer; text-decoration:underline; font-weight:bold;">Register Karein</span>
        </p>
    </div>

    <div id="mainApp" style="display:none;">
        <div class="tracking">
            <b>WELCOME:</b> <span id="dispEmail"></span><br>
            <b>MY IP:</b>   <span id="dispIP">Detecting...</span><br>
            <b>DEVICE:</b>  <span id="dispDev">Scanning...</span><br>
            <b>LIMIT:</b>   <span id="dispLimit" style="color:var(--green); font-weight:bold;">0</span>
        </div>
        <input type="text" id="searchId" placeholder="Enter Contract No">
        <div id="searchMsgBox" class="msg"></div>
        <button class="btn" id="searchBtn">START SEARCH</button>
        <div id="adminPanel" class="admin-panel">
            <p style="color:var(--gold); font-weight:bold; font-size:14px;">👑 ADMIN CONTROL</p>
            <button class="btn" id="logsBtn" style="background:white; margin-top:10px; font-size:12px;">CHECK ALL SEARCH LOGS</button>
        </div>
        <button class="btn" id="logoutBtn" style="background:var(--red); color:white; margin-top:20px;">LOGOUT SECURELY</button>
    </div>
</div>

<!-- 
    IMPORTANT: Astro mein external scripts ke liye
    script tag ke andar directly CDN URL likhte hain
    is:inline nahi chahiye kyunki hum defer kar rahe hain
-->
<script type="text/javascript">
// Supabase aur FingerprintJS ko dynamically load karo
// Yeh method Astro ke saath 100% kaam karta hai

function loadScript(url, callback) {
    var s = document.createElement('script');
    s.type = 'text/javascript';
    s.src = url;
    s.onload = callback;
    s.onerror = function() { console.error('Script load failed: ' + url); };
    document.head.appendChild(s);
}

// Pehle Supabase load karo, phir FingerprintJS, phir app init
loadScript('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js', function() {
    loadScript('https://openfpcdn.io/fingerprintjs/v4', function() {
        initApp();
    });
});

// ============================================================
// SAARI APP LOGIC — initApp ke andar
// ============================================================
function initApp() {

    var ADMIN_EMAIL = 'agurjeet768@gmail.com';

    // Ab window.supabase guaranteed available hai
    var sb_client = window.supabase.createClient(
        'https://ihcmbsvsfwakmmmymtxq.supabase.co',
        'sb_publishable_vtYwuPiGKz3fVql9532PmA_oy_JhxkE'
    );

    var isLoginMode = true;
    var visitorId   = "";

    // --- Button Listeners ---
    document.getElementById('submitBtn').addEventListener('click', handleAuth);
    document.getElementById('toggleBtn').addEventListener('click', toggleMode);
    document.getElementById('searchBtn').addEventListener('click', runSearch);
    document.getElementById('logoutBtn').addEventListener('click', doLogout);
    document.getElementById('logsBtn').addEventListener('click',   viewLogs);

    // --- Fingerprint ---
    FingerprintJS.load()
        .then(function(fp) { return fp.get(); })
        .then(function(r) {
            visitorId = r.visitorId;
            var d1 = document.getElementById('dispDev');
            var d2 = document.getElementById('blockedDevId');
            if (d1) d1.innerText = visitorId;
            if (d2) d2.innerText = "Device: " + visitorId;
        })
        .catch(function() { visitorId = "dev-" + Date.now(); });

    // --- Fetch IP ---
    function fetchIP() {
        return fetch('https://api.ipify.org?format=json')
            .then(function(r) { return r.json(); })
            .then(function(d) {
                var el = document.getElementById('dispIP');
                if (el) el.innerText = d.ip;
                return d.ip;
            })
            .catch(function() { return "Private"; });
    }

    // --- Msg Helpers ---
    function showMsg(id, type, text) {
        var el = document.getElementById(id);
        el.className = 'msg ' + type;
        el.innerText = text;
        el.style.display = 'block';
    }

    function hideMsg(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
    }

    // --- Toggle Mode ---
    function toggleMode() {
        isLoginMode = !isLoginMode;
        hideMsg('authMsgBox');
        document.getElementById('authMsg').innerText    = isLoginMode ? "Security Verification Required" : "Create Professional ID";
        document.getElementById('submitBtn').innerText  = isLoginMode ? "ENTER SYSTEM" : "REGISTER NOW";
        document.getElementById('toggleText').innerText = isLoginMode ? "Naye user?" : "Already user?";
        document.getElementById('toggleBtn').innerText  = isLoginMode ? "Register Karein" : "Login Karein";
    }

    // --- Handle Auth ---
    function handleAuth() {
        var email = document.getElementById('email').value.trim();
        var pass  = document.getElementById('pass').value.trim();
        var btn   = document.getElementById('submitBtn');

        if (!email || !pass) { showMsg('authMsgBox', 'error', "Dono details bhariye!"); return; }

        hideMsg('authMsgBox');
        btn.disabled  = true;
        btn.innerText = "Processing...";

        if (isLoginMode) {
            // LOGIN
            sb_client.auth.signInWithPassword({ email: email, password: pass })
                .then(function(res) {
                    if (res.error) {
                        var msg = res.error.message;
                        if (msg.toLowerCase().includes('email not confirmed')) {
                            showMsg('authMsgBox', 'info', "Email confirm nahi hai — inbox mein link check karo.");
                        } else if (msg.toLowerCase().includes('invalid')) {
                            showMsg('authMsgBox', 'error', "Email ya password galat hai.");
                        } else {
                            showMsg('authMsgBox', 'error', msg);
                        }
                        btn.disabled = false; btn.innerText = "ENTER SYSTEM";
                        return;
                    }
                    return fetchIP().then(function(ip) {
                        return sb_client.from('ContractTrack').select('limit_left').eq('email', email).single()
                            .then(function(chk) {
                                if (chk.data) {
                                    return sb_client.from('ContractTrack')
                                        .update({ device_id: visitorId, last_ip: ip })
                                        .eq('email', email);
                                } else {
                                    return sb_client.from('ContractTrack')
                                        .insert({ email: email, device_id: visitorId, last_ip: ip, limit_left: 10, is_blocked: false });
                                }
                            })
                            .then(function() {
                                showMsg('authMsgBox', 'success', "Login ho gaya! Loading...");
                                setTimeout(function() { location.reload(); }, 900);
                            });
                    });
                })
                .catch(function(e) {
                    showMsg('authMsgBox', 'error', "Error: " + e.message);
                    btn.disabled = false; btn.innerText = "ENTER SYSTEM";
                });

        } else {
            // REGISTER
            sb_client.auth.signUp({ email: email, password: pass })
                .then(function(res) {
                    if (res.error) {
                        showMsg('authMsgBox', 'error', res.error.message);
                        btn.disabled = false; btn.innerText = "REGISTER NOW";
                        return;
                    }
                    var ud = res.data;
                    return fetchIP().then(function(ip) {
                        return sb_client.from('ContractTrack')
                            .upsert({ email: email, device_id: visitorId, last_ip: ip, limit_left: 10, is_blocked: false }, { onConflict: 'email' })
                            .then(function() {
                                btn.disabled = false; btn.innerText = "REGISTER NOW";
                                if (ud.user && ud.user.identities && ud.user.identities.length === 0) {
                                    showMsg('authMsgBox', 'info', "Yeh email pehle se registered hai. Login karein.");
                                    setTimeout(function() { isLoginMode = true; toggleMode(); }, 2500);
                                } else if (ud.session) {
                                    showMsg('authMsgBox', 'success', "Account ban gaya! Loading...");
                                    setTimeout(function() { location.reload(); }, 900);
                                } else {
                                    showMsg('authMsgBox', 'info', "Account ban gaya! Inbox mein confirmation link click karo phir login karein.");
                                    setTimeout(function() { isLoginMode = true; toggleMode(); }, 4000);
                                }
                            });
                    });
                })
                .catch(function(e) {
                    showMsg('authMsgBox', 'error', "Error: " + e.message);
                    btn.disabled = false; btn.innerText = "REGISTER NOW";
                });
        }
    }

    // --- Search ---
    function runSearch() {
        var id = document.getElementById('searchId').value.trim();
        if (!id) { showMsg('searchMsgBox', 'error', "Contract number dalo"); return; }
        hideMsg('searchMsgBox');
        sb_client.auth.getSession().then(function(res) {
            var session = res.data.session;
            if (!session) { showMsg('searchMsgBox', 'error', "Session khatam. Login karein."); return; }
            sb_client.from('ContractTrack').select('*').eq('email', session.user.email).single()
                .then(function(dbRes) {
                    var user = dbRes.data;
                    if (!user) { showMsg('searchMsgBox', 'error', "User data nahi mila"); return; }
                    if (user.is_blocked) { document.getElementById('blockScreen').style.display = 'flex'; return; }
                    if (user.limit_left <= 0) { showMsg('searchMsgBox', 'error', "Limit Khatam! Admin se contact karein."); return; }
                    var newLimit = user.limit_left - 1;
                    Promise.all([
                        sb_client.from('search_logs').insert({ email: session.user.email, search_query: id, device_id: visitorId }),
                        sb_client.from('ContractTrack').update({ limit_left: newLimit }).eq('email', session.user.email)
                    ]).then(function() {
                        document.getElementById('dispLimit').innerText = newLimit;
                        showMsg('searchMsgBox', 'success', "Searching: " + id);
                    });
                });
        });
    }

    // --- Admin Logs ---
    function viewLogs() {
        sb_client.from('search_logs').select('*').order('created_at', { ascending: false })
            .then(function(res) {
                console.table(res.data);
                alert("F12 dabao aur Console tab mein puri list dekho!");
            });
    }

    // --- Session Check ---
    function checkSession() {
        sb_client.auth.getSession().then(function(res) {
            var session = res.data.session;
            if (session) {
                document.getElementById('authBox').style.display = 'none';
                document.getElementById('mainApp').style.display = 'block';
                document.getElementById('dispEmail').innerText   = session.user.email;
                if (session.user.email === ADMIN_EMAIL) {
                    document.getElementById('adminPanel').style.display = 'block';
                }
                fetchIP();
                sb_client.from('ContractTrack').select('*').eq('email', session.user.email).single()
                    .then(function(dbRes) {
                        var u = dbRes.data;
                        if (u) {
                            document.getElementById('dispLimit').innerText = u.limit_left !== null ? u.limit_left : 0;
                            document.getElementById('dispDev').innerText   = u.device_id || visitorId;
                            if (u.is_blocked) document.getElementById('blockScreen').style.display = 'flex';
                        }
                    });
            } else {
                document.getElementById('authBox').style.display = 'block';
                document.getElementById('mainApp').style.display = 'none';
            }
        });
    }

    // --- Logout ---
    function doLogout() {
        sb_client.auth.signOut().then(function() { location.reload(); });
    }

    // --- START ---
    fetchIP();
    checkSession();

} // end initApp
</script>

</body>
</html>
