<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ContractTrack Pro</title>
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; } 

        :root { --gold: #d4af37; --bg: #000; --card: #151515; --border: #222; --success: #22c55e; }
        
        body { 
            font-family: 'Inter', sans-serif; 
            background: var(--bg); 
            color: #fff; 
            margin: 0; 
            padding: 12px; 
            overflow-x: hidden; 
        }
        
        .container { max-width: 800px; margin: 0 auto; width: 100%; }
        
        .header { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; }
        .logo { background: var(--gold); color: #000; padding: 4px 8px; border-radius: 4px; font-weight: 900; }

        .input-card { background: var(--card); padding: 12px; border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 15px; width: 100%; }
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-family: monospace; font-size: 14px; }
        textarea:focus { outline: none; border-color: var(--gold); }
        
        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 14px; border-radius: 8px; font-weight: 900; cursor: pointer; margin-top: 10px; text-transform: uppercase; font-size: 15px; touch-action: manipulation; transition: transform 0.1s; }
        .btn:active { transform: scale(0.98); }
        .btn:disabled { opacity: 0.6; }

        .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; width: 100%; }
        .s-card { background: var(--card); padding: 12px; border-radius: 10px; border: 2px solid var(--gold); text-align: center; }
        .s-card small { color: var(--gold); font-size: 10px; text-transform: uppercase; font-weight: bold; }

        .filters-container { display: grid; grid-template-columns: 2fr 1fr; gap: 10px; margin-bottom: 10px; }
        .filter-input { width: 100%; background: var(--card); border: 2px solid var(--gold); color: #fff; padding: 12px; border-radius: 8px; font-size: 14px; outline: none; transition: 0.3s; }
        .filter-input:focus { box-shadow: 0 0 5px rgba(212, 175, 55, 0.5); }
        input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; }

        .section-title { color: var(--gold); font-size: 14px; font-weight: 900; margin: 20px 0 10px 0; text-transform: uppercase; border-bottom: 1px dashed var(--gold); padding-bottom: 8px; letter-spacing: 0.5px; }

        .item-card { background: var(--card); border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 12px; width: 100%; overflow: hidden; box-shadow: 0 4px 10px rgba(212, 175, 55, 0.12); }
        
        .item-main { padding: 14px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; cursor: pointer; touch-action: manipulation; }
        .item-main:active { background: #1a1a1a; }
        
        .deep-details { padding: 15px; background: #080808; border-top: 1px dashed var(--gold); font-size: 13px; }
        .d-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid #1a1a1a; }
        .d-row:last-child { border-bottom: none; }
        .d-row b { color: var(--gold); text-align: right; }

        .today-badge { background: var(--success); color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 900; display: inline-block; }
        .date-text { color: var(--success); font-weight: bold; font-size: 13px; text-align: center; }
        
        .loader { display: none; text-align: center; color: var(--gold); padding: 20px; font-weight: bold; letter-spacing: 1px; }
        .toggle-icon { font-size: 12px; color: var(--gold); margin-left: 5px; }
        
        .share-btn { width: 100%; margin-top: 12px; background: var(--gold); color: #000; font-weight: 900; border: none; padding: 12px; border-radius: 6px; cursor: pointer; text-transform: uppercase; touch-action: manipulation; }

        @media (max-width: 480px) {
            .item-main { grid-template-columns: 1.2fr 1fr 1fr; gap: 5px; padding: 12px; }
            .header h2 { font-size: 18px; }
            .share-btn { font-size: 13px; padding: 10px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">CT</div>
            <h2 style="margin:0;">ContractTrack Pro</h2>
        </div>

        <div class="input-card">
            <textarea id="contractsInput" rows="4" placeholder="Enter Contracts (One per line)"></textarea>
            <button id="fetchBtn" class="btn">FETCH ALL RECEIPTS</button>
        </div>

        <div id="loader" class="loader">FETCHING DATA... PLEASE WAIT</div>

        <div class="stats">
            <div class="s-card">
                <small id="statLabelCount">Dikhne Wale Records</small>
                <div id="tCount" style="font-size: 20px; font-weight: bold; margin-top: 4px;">0</div>
            </div>
            <div class="s-card">
                <small id="statLabelAmt">Total Amount</small>
                <div id="tAmt" style="font-size: 20px; font-weight: bold; color:var(--success); margin-top: 4px;">₹0</div>
            </div>
        </div>

        <div class="filters-container">
            <input type="text" id="searchInput" class="filter-input" placeholder="🔍 Search Name, Contract...">
            <input type="date" id="dateFilter" class="filter-input">
        </div>

        <div id="todaySection" style="display: none;">
            <div class="section-title">⭐ Today's Paid Accounts</div>
            <div id="todayResults"></div>
        </div>

        <div id="otherSection" style="display: none;">
            <div class="section-title">📂 Previous Records</div>
            <div id="otherResults"></div>
        </div>

    </div>

    <script>
        const btn = document.getElementById('fetchBtn');
        const input = document.getElementById('contractsInput');
        const searchInput = document.getElementById('searchInput');
        const dateFilter = document.getElementById('dateFilter');
        
        window.allRecordsData = [];

        const cleanVal = (val) => {
            if (!val || String(val).toLowerCase() === 'null') return 'N/A';
            return val;
        };

        window.toggleCard = function(index) {
            const detailsDiv = document.getElementById('det-' + index);
            const iconSpan = document.getElementById('icon-' + index);
            if (detailsDiv.style.display === 'none') {
                detailsDiv.style.display = 'block'; 
                iconSpan.innerText = '▲'; 
            } else {
                detailsDiv.style.display = 'none';  
                iconSpan.innerText = '▼'; 
            }
        };

        window.shareCard = function(index) {
            const item = window.allRecordsData[index];
            const emiAmountText = item.emi_amount !== 'N/A' ? `₹${item.emi_amount}` : 'N/A';
            const overdueText = cleanVal(item.overdue) !== 'N/A' ? `₹${item.overdue}` : '0';

            const shareText = `*ContractTrack Details*\n👤 Name: ${item.name}\n📝 Contract: ${item.contract}\n📱 Mobile: ${item.mobile}\n💰 Amount Paid: ₹${item.amount}\n📅 Date: ${item.date}\n📊 EMI Amount: ${emiAmountText}\n⚠️ Over Dues: ${overdueText}\n🧾 Receipt: ${item.receipt_no}`;

            if (navigator.share) {
                navigator.share({ title: 'Contract Details', text: shareText }).catch(err => console.log('Share error:', err));
            } else {
                navigator.clipboard.writeText(shareText);
                alert("Details copied! Ab aap isko paste karke share kar sakte hain.");
            }
        };

        const formatFilterDate = (dateStr) => {
            if(!dateStr) return "";
            const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
            const parts = dateStr.split('-'); 
            return `${parts[2]}-${months[parseInt(parts[1])-1]}-${parts[0]}`;
        };

        const applyFilters = () => {
            const term = searchInput.value.toLowerCase();
            const selectedDate = formatFilterDate(dateFilter.value);
            
            let visibleCount = 0;
            let visibleAmt = 0;
            
            const cards = document.querySelectorAll('.item-card');

            requestAnimationFrame(() => {
                window.allRecordsData.forEach((item, index) => {
                    const card = document.getElementById('card-wrapper-' + index);
                    if (!card) return;

                    const matchesSearch = card.innerText.toLowerCase().includes(term);
                    const matchesDate = selectedDate === "" || item.date === selectedDate;

                    if (matchesSearch && matchesDate) {
                        card.style.display = 'block';
                        visibleCount++;
                        visibleAmt += parseFloat(item.amount.toString().replace(/,/g, '')) || 0;
                    } else {
                        card.style.display = 'none';
                    }
                });

                document.getElementById('tCount').innerText = visibleCount;
                document.getElementById('tAmt').innerText = "₹" + visibleAmt.toLocaleString('en-IN');
            });
        };

        searchInput.addEventListener('input', applyFilters);
        dateFilter.addEventListener('change', applyFilters);

        btn.onclick = async () => {
            const val = input.value.trim();
            if(!val) return;
            
            // --- DUPLICATE REMOVAL LOGIC ADDED HERE ---
            // Pehle box ka data liya, usko alag kiya, aur Set() use karke duplicates hata diye
            const rawArray = val.split('\n').map(n => n.trim()).filter(n => n);
            const uniqueArray = [...new Set(rawArray)]; 
            const list = uniqueArray.join(',');
            
            document.getElementById('loader').style.display = 'block';
            document.getElementById('todayResults').innerHTML = '';
            document.getElementById('otherResults').innerHTML = '';
            document.getElementById('todaySection').style.display = 'none';
            document.getElementById('otherSection').style.display = 'none';
            
            btn.disabled = true;
            btn.innerText = "FETCHING...";

            try {
                const r = await fetch(`https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${list}`);
                const data = await r.json();
                window.allRecordsData = data; 
                
                const today = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');
                
                let todayHtml = ''; 
                let otherHtml = '';

                data.forEach((item, i) => {
                    const isToday = item.date === today;
                    const emiAmountText = item.emi_amount !== 'N/A' ? `₹${item.emi_amount}` : 'N/A';
                    const overdueText = cleanVal(item.overdue) !== 'N/A' ? `₹${item.overdue}` : '0';
                    
                    const dateDisplay = isToday ? '<span class="today-badge">TODAY</span>' : `<div class="date-text">${item.date}</div>`;

                    const cardHTML = `
                        <div class="item-card" id="card-wrapper-${i}">
                            <div class="item-main" onclick="toggleCard(${i})">
                                <div>
                                    <div style="font-weight:bold; font-size: 15px;">${item.name}</div>
                                    <div style="color:var(--gold); font-size: 12px; margin-top: 4px; font-weight:bold;">${item.contract}</div>
                                </div>
                                <div style="text-align:center;">
                                    ${dateDisplay}
                                </div>
                                <div style="text-align:right;">
                                    <div style="color:#d4af37; font-weight:bold; font-size: 17px;">₹${item.amount}</div>
                                    <div style="font-size:11px; color:#aaa; margin-top: 6px; display:flex; align-items:center; justify-content:flex-end;">
                                        Details <span id="icon-${i}" class="toggle-icon">▼</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div id="det-${i}" class="deep-details" style="display: none;">
                                <div class="d-row"><span>Cust Mobile:</span> <b>${item.mobile}</b></div>
                                <div class="d-row"><span>EMI Amount:</span> <b style="color:var(--success);">${emiAmountText}</b></div>
                                <div class="d-row"><span>Over Dues:</span> <b style="color:#ff4d4d;">${overdueText}</b></div>
                                <div class="d-row"><span>Guarantor:</span> <b>${item.gu_name}</b></div>
                                <div class="d-row"><span>GU Mobile:</span> <b>${item.gu_mobile}</b></div>
                                <div class="d-row"><span>Co-Applicant:</span> <b>${item.co_name}</b></div>
                                <div class="d-row"><span>Co-App Mobile:</span> <b>${item.co_mobile}</b></div>
                                <div class="d-row"><span>Receipt No:</span> <b style="color:#aaa;">${item.receipt_no}</b></div>
                                <div class="d-row"><span>Type:</span> <b style="color:#aaa;">${item.instr}</b></div>
                                <button class="share-btn" onclick="shareCard(${i})">🔗 Share Details</button>
                            </div>
                        </div>
                    `;

                    if (isToday) {
                        todayHtml += cardHTML;
                    } else {
                        otherHtml += cardHTML;
                    }
                });

                if (todayHtml === '') {
                    todayHtml = `<div style="text-align:center; padding:15px; color:#aaa; font-style:italic; background: var(--card); border-radius: 10px; border: 1px dashed var(--gold); margin-bottom:12px; font-size: 14px;">⏳ Abhi tak aaj ki date mein kisi contract par payment nahi aaya hai.</div>`;
                }

                document.getElementById('todayResults').innerHTML = todayHtml;
                document.getElementById('otherResults').innerHTML = otherHtml;

                document.getElementById('todaySection').style.display = 'block';
                if (otherHtml !== '') document.getElementById('otherSection').style.display = 'block';
                
                applyFilters();

            } catch (err) {
                alert("Connection failed. Check hugging face server.");
            } finally {
                document.getElementById('loader').style.display = 'none';
                btn.disabled = false;
                btn.innerText = "FETCH ALL RECEIPTS";
            }
        }
    </script>
</body>
</html>
