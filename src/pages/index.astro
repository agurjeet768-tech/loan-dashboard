---
// CT PRO - API Based Auth
---
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ContractTrack Pro</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: system-ui, -apple-system, sans-serif; 
            background: #000; 
            color: #fff; 
            padding: 16px; 
        }
        .container { max-width: 600px; margin: 0 auto; }
        
        /* Auth Card */
        .auth-card {
            background: #111;
            border: 2px solid #d4af37;
            border-radius: 24px;
            padding: 32px 24px;
            margin-top: 80px;
            text-align: center;
        }
        .logo {
            background: #d4af37;
            color: #000;
            width: 60px;
            height: 60px;
            line-height: 60px;
            border-radius: 50%;
            margin: 0 auto 20px;
            font-size: 24px;
            font-weight: bold;
        }
        h2 { color: #d4af37; margin-bottom: 8px; }
        .sub { color: #888; margin-bottom: 24px; font-size: 14px; }
        input {
            width: 100%;
            padding: 14px;
            margin-bottom: 12px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 12px;
            color: #fff;
            font-size: 16px;
        }
        input:focus { outline: none; border-color: #d4af37; }
        button {
            width: 100%;
            padding: 14px;
            background: #d4af37;
            color: #000;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 8px;
        }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
        .toggle-btn {
            background: none;
            color: #d4af37;
            margin-top: 16px;
            font-size: 14px;
        }
        .msg {
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 16px;
            display: none;
            font-size: 14px;
        }
        .msg.error { background: #2a0000; color: #ff6666; border: 1px solid #ff3333; display: block; }
        .msg.success { background: #002a10; color: #00ff99; border: 1px solid #00ff99; display: block; }
        
        /* Main App */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #111;
            padding: 16px;
            border-radius: 16px;
            margin-bottom: 20px;
            border: 1px solid #333;
        }
        .limit { background: #002a10; color: #00ff99; padding: 4px 12px; border-radius: 20px; font-size: 12px; }
        .input-card {
            background: #111;
            border: 2px solid #d4af37;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
        }
        textarea {
            width: 100%;
            background: #000;
            border: 1px solid #333;
            color: #fff;
            padding: 12px;
            border-radius: 10px;
            font-family: monospace;
            font-size: 14px;
        }
        .stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }
        .stat-card {
            background: #111;
            border: 2px solid #d4af37;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
        }
        .stat-card small { color: #d4af37; font-size: 10px; text-transform: uppercase; }
        .stat-card .value { font-size: 24px; font-weight: bold; margin-top: 4px; }
        .filters {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 10px;
            margin-bottom: 16px;
        }
        .filter-input {
            background: #111;
            border: 2px solid #d4af37;
            color: #fff;
            padding: 12px;
            border-radius: 10px;
        }
        .section-title {
            color: #d4af37;
            font-size: 14px;
            font-weight: bold;
            margin: 20px 0 12px;
            text-transform: uppercase;
            border-bottom: 1px dashed #d4af37;
            padding-bottom: 8px;
        }
        .item-card {
            background: #111;
            border: 2px solid #d4af37;
            border-radius: 12px;
            margin-bottom: 12px;
            overflow: hidden;
        }
        .item-main {
            padding: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }
        .today-badge { background: #22c55e; color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; }
        .deep-details {
            padding: 14px;
            background: #0a0a0a;
            border-top: 1px dashed #d4af37;
            display: none;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid #1a1a1a;
            font-size: 13px;
        }
        .share-btn {
            width: 100%;
            background: #d4af37;
            color: #000;
            padding: 10px;
            border-radius: 8px;
            margin-top: 10px;
            font-weight: bold;
            cursor: pointer;
        }
        .loader {
            text-align: center;
            padding: 20px;
            color: #d4af37;
            display: none;
        }
        #blockScreen {
            display: none;
            position: fixed;
            inset: 0;
            background: #000;
            z-index: 9999;
            text-align: center;
            padding-top: 200px;
            color: red;
        }
    </style>
</head>
<body>

<div id="blockScreen"><h1>🚫 ACCESS DENIED</h1><p>Your device is blocked</p></div>

<!-- AUTH SECTION -->
<div id="authSection">
    <div class="container">
        <div class="auth-card">
            <div class="logo">CT</div>
            <h2>ContractTrack Pro</h2>
            <p class="sub" id="authModeText">Login to continue</p>
            <div id="authMsg" class="msg"></div>
            <input type="email" id="email" placeholder="Email Address">
            <input type="password" id="password" placeholder="Password">
            <button id="submitBtn">LOGIN</button>
            <button id="toggleModeBtn" class="toggle-btn">Create New Account</button>
        </div>
    </div>
</div>

<!-- MAIN APP -->
<div id="mainApp" style="display:none;">
    <div class="container">
        <div class="top-bar">
            <div><b id="userEmail"></b><br><span class="limit">Limit: <span id="userLimit">0</span></span></div>
            <button id="logoutBtn" style="background:#ff4444; color:white; padding:8px 16px; border:none; border-radius:8px;">LOGOUT</button>
        </div>
        
        <div id="adminPanel" style="display:none; background:#1a1500; padding:12px; border-radius:12px; text-align:center; margin-bottom:16px; border:1px dashed #d4af37;">
            <b style="color:#d4af37;">👑 ADMIN</b><br>
            <button id="adminBtn" style="background:white; color:black; padding:6px 12px; border:none; border-radius:6px; margin-top:6px;">Go to Admin</button>
        </div>
        
        <div class="input-card">
            <textarea id="contractsInput" rows="3" placeholder="Enter Contract Numbers (One per line)"></textarea>
            <button id="fetchBtn">🔍 FETCH DATA</button>
        </div>
        
        <div id="loader" class="loader">⏳ FETCHING DATA...</div>
        
        <div id="reportBox" style="background:#0c0c0c; padding:12px; border-radius:10px; margin-bottom:16px; display:none;">
            <div style="display:flex; justify-content:space-between;">
                <span>📊 Total: <b id="repTotal">0</b></span>
                <span>✅ Success: <b id="repSuccess" style="color:#22c55e;">0</b></span>
                <span>❌ Failed: <b id="repFailed" style="color:#ff4444;">0</b></span>
            </div>
            <div id="failedList" style="margin-top:8px;"></div>
        </div>
        
        <div class="stats">
            <div class="stat-card"><small>RECORDS</small><div class="value" id="totalCount">0</div></div>
            <div class="stat-card"><small>TOTAL AMOUNT</small><div class="value" id="totalAmount">₹0</div></div>
        </div>
        
        <div class="filters">
            <input type="text" id="searchFilter" class="filter-input" placeholder="🔍 Search...">
            <input type="date" id="dateFilter" class="filter-input">
        </div>
        
        <div id="todaySection"><div class="section-title">⭐ TODAY'S PAYMENTS</div><div id="todayList"></div></div>
        <div id="otherSection"><div class="section-title">📂 PREVIOUS RECORDS</div><div id="otherList"></div></div>
    </div>
</div>

<script>
    // State
    let isLoginMode = true;
    let currentUser = null;
    let allRecords = [];
    
    // DOM Elements
    const authSection = document.getElementById('authSection');
    const mainApp = document.getElementById('mainApp');
    const submitBtn = document.getElementById('submitBtn');
    const toggleModeBtn = document.getElementById('toggleModeBtn');
    const logoutBtn = document.getElementById('logoutBtn');
    const fetchBtn = document.getElementById('fetchBtn');
    const searchFilter = document.getElementById('searchFilter');
    const dateFilter = document.getElementById('dateFilter');
    const adminBtn = document.getElementById('adminBtn');
    
    // Helper: Show message
    function showMessage(msg, type) {
        const msgDiv = document.getElementById('authMsg');
        msgDiv.textContent = msg;
        msgDiv.className = 'msg ' + type;
        setTimeout(() => {
            msgDiv.className = 'msg';
            msgDiv.textContent = '';
        }, 3000);
    }
    
    // Helper: Get value case-insensitive
    function getValue(obj, key) {
        if (!obj) return 'N/A';
        const found = Object.keys(obj).find(k => k.toLowerCase() === key.toLowerCase());
        return found ? (obj[found] || 'N/A') : 'N/A';
    }
    
    // Check session on load
    async function checkSession() {
        try {
            const res = await fetch('/api/auth', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'session' })
            });
            const data = await res.json();
            
            if (data.id) {
                // User is logged in
                currentUser = { email: data.email, id: data.id };
                await loadUserFromDB();
                showMainApp();
            } else {
                showAuth();
            }
        } catch (err) {
            console.log('Session check failed:', err);
            showAuth();
        }
    }
    
    // Load user data from ContractTrack table
    async function loadUserFromDB() {
        try {
            const res = await fetch('/api/db', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'getUser', email: currentUser.email })
            });
            const data = await res.json();
            
            if (data && !data.error) {
                document.getElementById('userLimit').innerText = data.limit_left || 0;
                if (data.is_blocked) {
                    document.getElementById('blockScreen').style.display = 'flex';
                }
                if (currentUser.email === 'agurjeet768@gmail.com') {
                    document.getElementById('adminPanel').style.display = 'block';
                }
            } else {
                // Create new user
                await fetch('/api/db', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'createUser', email: currentUser.email })
                });
                document.getElementById('userLimit').innerText = '10';
            }
        } catch (err) {
            console.log('DB error:', err);
        }
    }
    
    // Show auth section
    function showAuth() {
        authSection.style.display = 'block';
        mainApp.style.display = 'none';
    }
    
    // Show main app
    function showMainApp() {
        authSection.style.display = 'none';
        mainApp.style.display = 'block';
        document.getElementById('userEmail').innerText = currentUser.email;
    }
    
    // Handle Auth (Login/Register)
    async function handleAuth() {
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value.trim();
        
        if (!email || !password) {
            showMessage('Please enter email and password', 'error');
            return;
        }
        
        submitBtn.disabled = true;
        submitBtn.textContent = 'Processing...';
        
        try {
            const action = isLoginMode ? 'login' : 'register';
            const res = await fetch('/api/auth', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action, email, password })
            });
            const data = await res.json();
            
            if (data.error) {
                throw new Error(data.error);
            }
            
            if (isLoginMode) {
                // Login success
                currentUser = { email: data.user?.email || email, id: data.user?.id };
                await loadUserFromDB();
                showMessage('Login successful!', 'success');
                showMainApp();
            } else {
                // Register success
                await fetch('/api/db', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'createUser', email })
                });
                showMessage('Account created! Please login.', 'success');
                // Switch to login mode
                isLoginMode = true;
                document.getElementById('submitBtn').textContent = 'LOGIN';
                document.getElementById('authModeText').textContent = 'Login to continue';
                toggleModeBtn.textContent = 'Create New Account';
                document.getElementById('email').value = '';
                document.getElementById('password').value = '';
            }
            
        } catch (err) {
            let msg = err.message;
            if (msg.includes('Invalid login')) msg = 'Wrong email or password';
            if (msg.includes('User already registered')) msg = 'Email already exists. Please login.';
            showMessage(msg, 'error');
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = isLoginMode ? 'LOGIN' : 'REGISTER';
        }
    }
    
    // Toggle mode
    function toggleMode() {
        isLoginMode = !isLoginMode;
        if (isLoginMode) {
            submitBtn.textContent = 'LOGIN';
            document.getElementById('authModeText').textContent = 'Login to continue';
            toggleModeBtn.textContent = 'Create New Account';
        } else {
            submitBtn.textContent = 'REGISTER';
            document.getElementById('authModeText').textContent = 'Create new account';
            toggleModeBtn.textContent = 'Back to Login';
        }
    }
    
    // Logout
    async function logout() {
        await fetch('/api/logout', { method: 'POST' });
        location.reload();
    }
    
    // Fetch contract data
    async function fetchData() {
        const input = document.getElementById('contractsInput').value.trim();
        if (!input) {
            alert('Please enter contract numbers');
            return;
        }
        
        const contracts = [...new Set(input.split('\n').map(c => c.trim()).filter(c => c))];
        
        // Get current limit
        const limitRes = await fetch('/api/db', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'getUser', email: currentUser.email })
        });
        const userData = await limitRes.json();
        
        if (userData.limit_left < contracts.length) {
            alert(`Limit exceeded! Need ${contracts.length}, have ${userData.limit_left}`);
            return;
        }
        
        const fetchBtn = document.getElementById('fetchBtn');
        const loader = document.getElementById('loader');
        const reportBox = document.getElementById('reportBox');
        
        fetchBtn.disabled = true;
        loader.style.display = 'block';
        reportBox.style.display = 'none';
        
        try {
            const response = await fetch(`https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${contracts.join(',')}`);
            const data = await response.json();
            allRecords = data;
            
            // Update limit
            const newLimit = userData.limit_left - contracts.length;
            await fetch('/api/db', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'updateLimit', email: currentUser.email, limit: newLimit })
            });
            document.getElementById('userLimit').innerText = newLimit;
            
            // Show report
            const fetchedIds = data.map(item => getValue(item, 'contract'));
            const failedIds = contracts.filter(id => !fetchedIds.includes(id));
            
            document.getElementById('repTotal').innerText = contracts.length;
            document.getElementById('repSuccess').innerText = data.length;
            document.getElementById('repFailed').innerText = failedIds.length;
            document.getElementById('failedList').innerHTML = failedIds.map(id => `<span style="background:rgba(255,77,77,0.1); color:#ff4d4d; padding:2px 6px; border-radius:4px; margin:2px; display:inline-block;">${id}</span>`).join('');
            reportBox.style.display = 'block';
            
            renderData();
            applyFilters();
            
        } catch (err) {
            alert('Error: ' + err.message);
        } finally {
            fetchBtn.disabled = false;
            loader.style.display = 'none';
        }
    }
    
    // Render data
    function renderData() {
        const today = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');
        let todayHtml = '', otherHtml = '';
        
        allRecords.forEach((item, idx) => {
            const name = getValue(item, 'name');
            const contract = getValue(item, 'contract');
            const amount = getValue(item, 'amount');
            const date = getValue(item, 'date');
            const mobile = getValue(item, 'mobile');
            const receipt = getValue(item, 'receipt_no');
            const isToday = date === today;
            
            const html = `
                <div class="item-card" data-date="${date}" data-name="${name.toLowerCase()}" data-contract="${contract.toLowerCase()}" data-amount="${amount}">
                    <div class="item-main" onclick="toggleCard(${idx})">
                        <div><strong>${escapeHtml(name)}</strong><br><small style="color:#d4af37;">${escapeHtml(contract)}</small></div>
                        <div>${isToday ? '<span class="today-badge">TODAY</span>' : '<span style="color:#22c55e;">' + escapeHtml(date) + '</span>'}</div>
                        <div><strong style="color:#d4af37;">₹${amount}</strong><br><small>▼</small></div>
                    </div>
                    <div id="details-${idx}" class="deep-details">
                        <div class="detail-row"><span>📱 Mobile:</span><b>${escapeHtml(mobile)}</b></div>
                        <div class="detail-row"><span>🧾 Receipt:</span><b>${escapeHtml(receipt)}</b></div>
                        <div class="detail-row"><span>💰 Amount:</span><b>₹${amount}</b></div>
                        <div class="detail-row"><span>📅 Date:</span><b>${escapeHtml(date)}</b></div>
                        <button class="share-btn" onclick="shareCard(${idx})">📤 Share Details</button>
                    </div>
                </div>
            `;
            
            if (isToday) todayHtml += html;
            else otherHtml += html;
        });
        
        document.getElementById('todayList').innerHTML = todayHtml || '<div style="text-align:center; padding:20px; color:#888;">No payments today</div>';
        document.getElementById('otherList').innerHTML = otherHtml || '<div style="text-align:center; padding:20px; color:#888;">No previous records</div>';
        document.getElementById('todaySection').style.display = 'block';
        document.getElementById('otherSection').style.display = 'block';
    }
    
    function escapeHtml(str) {
        if (!str) return 'N/A';
        return String(str).replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }
    
    // Toggle card details
    window.toggleCard = function(idx) {
        const el = document.getElementById(`details-${idx}`);
        if (el) {
            el.style.display = el.style.display === 'none' || el.style.display === '' ? 'block' : 'none';
        }
    };
    
    // Share card
    window.shareCard = function(idx) {
        const item = allRecords[idx];
        const text = `📋 CONTRACT DETAILS\n\n👤 Name: ${getValue(item, 'name')}\n📝 Contract: ${getValue(item, 'contract')}\n📱 Mobile: ${getValue(item, 'mobile')}\n💰 Amount: ₹${getValue(item, 'amount')}\n📅 Date: ${getValue(item, 'date')}`;
        if (navigator.share) navigator.share({ title: 'Contract Details', text: text });
        else { navigator.clipboard.writeText(text); alert('Copied!'); }
    };
    
    // Apply filters
    function applyFilters() {
        const term = document.getElementById('searchFilter').value.toLowerCase();
        const dateVal = document.getElementById('dateFilter').value;
        let count = 0, total = 0;
        
        document.querySelectorAll('.item-card').forEach(card => {
            const date = card.getAttribute('data-date');
            const name = card.getAttribute('data-name');
            const contract = card.getAttribute('data-contract');
            const amount = parseFloat(card.getAttribute('data-amount')) || 0;
            
            let show = true;
            if (term && !name.includes(term) && !contract.includes(term)) show = false;
            if (dateVal) {
                const formatted = dateVal.split('-').reverse().join('-');
                if (date !== formatted) show = false;
            }
            
            card.style.display = show ? 'block' : 'none';
            if (show) { count++; total += amount; }
        });
        
        document.getElementById('totalCount').innerText = count;
        document.getElementById('totalAmount').innerHTML = '₹' + total.toLocaleString('en-IN');
    }
    
    // Event listeners
    submitBtn.onclick = handleAuth;
    toggleModeBtn.onclick = toggleMode;
    logoutBtn.onclick = logout;
    fetchBtn.onclick = fetchData;
    if (searchFilter) searchFilter.oninput = applyFilters;
    if (dateFilter) dateFilter.onchange = applyFilters;
    if (adminBtn) adminBtn.onclick = () => window.location.href = '/admin';
    
    // Start
    checkSession();
</script>
</body>
</html>
