---
// index.astro
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ContractTrack Pro - Smart Dashboard</title>
    <style>
        :root { --gold: #d4af37; --dark-bg: #121212; --card-bg: #1e1e1e; --border: #2d2d2d; --success: #22c55e; }
        body { font-family: 'Inter', sans-serif; background: var(--dark-bg); color: #fff; margin: 0; padding: 15px; }
        .container { max-width: 850px; margin: 0 auto; }
        
        /* Header & Input */
        .header { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
        .logo { background: var(--gold); color: #000; padding: 5px 10px; border-radius: 5px; font-weight: bold; }
        .input-card { background: var(--card-bg); padding: 15px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 20px; }
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; box-sizing: border-box; }
        .btn { width: 100%; background: var(--gold); color: #000; border: none; padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px; }

        /* Stats & Tables */
        .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .stat-card { background: var(--card-bg); padding: 15px; border-radius: 10px; border: 1px solid var(--border); }
        .stat-card small { color: var(--gold); font-size: 10px; text-transform: uppercase; }
        .stat-card div { font-size: 20px; font-weight: bold; }

        .table-section { background: var(--card-bg); border-radius: 12px; border: 1px solid var(--border); margin-bottom: 30px; overflow-x: auto; }
        .section-header { padding: 15px; background: #252525; border-bottom: 1px solid var(--border); font-weight: bold; color: var(--gold); }
        table { width: 100%; border-collapse: collapse; min-width: 600px; }
        th { text-align: left; padding: 12px; font-size: 11px; color: #888; border-bottom: 1px solid var(--border); }
        td { padding: 12px; border-bottom: 1px solid #252525; font-size: 13px; }
        .today-tag { background: var(--success); color: #000; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; }
        .loading { display: none; color: var(--gold); text-align: center; padding: 10px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header"><div class="logo">CT</div><h2>ContractTrack Pro</h2></div>

        <div class="input-card">
            <label style="color:var(--gold); font-size:12px; display:block; margin-bottom:5px;">PASTE NUMBERS (ONE PER LINE):</label>
            <textarea id="contractsInput" rows="5" placeholder="9420000&#10;7795753"></textarea>
            <button id="fetchBtn" class="btn">FETCH ALL DATA</button>
        </div>

        <div id="loader" class="loading">Fetching Records...</div>

        <div class="summary-grid">
            <div class="stat-card"><small>Today's Count</small><div id="tCount">0</div></div>
            <div class="stat-card"><small>Today's Total</small><div id="tAmt" style="color:var(--success);">₹0</div></div>
        </div>

        <div class="table-section" id="todaySection" style="display:none;">
            <div class="section-header">TODAY'S PAID RECEIPTS</div>
            <table>
                <thead><tr><th>Contract</th><th>Name</th><th>Receipt No</th><th>Amount</th><th>Status</th></tr></thead>
                <tbody id="todayResults"></tbody>
            </table>
        </div>

        <div class="table-section">
            <div class="section-header">ALL PROCESSED RECORDS</div>
            <table>
                <thead><tr><th>Contract</th><th>Name</th><th>Date</th><th>Amount</th><th>Type</th></tr></thead>
                <tbody id="allResults"></tbody>
            </table>
        </div>
    </div>

    <script>
        const btn = document.getElementById('fetchBtn');
        const input = document.getElementById('contractsInput');
        const loader = document.getElementById('loader');

        btn.onclick = async () => {
            const rawText = input.value.trim();
            if(!rawText) return alert("Please enter numbers");

            // Line breaks ko commas mein badalna (Yahi trick hai!)
            const cleanList = rawText.split('\n').map(n => n.trim()).filter(n => n).join(',');
            
            loader.style.display = 'block';
            btn.disabled = true;

            try {
                const r = await fetch(`https://gauravkumar80500-loandataapi.hf.space/scrape_custom?contracts=${cleanList}`);
                const data = await r.json();
                
                const today = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}).toUpperCase().replace(/ /g, '-');
                
                let allHtml = '', todayHtml = '', tCount = 0, tAmt = 0;

                data.forEach(item => {
                    const row = `<tr>
                        <td>${item.contract}</td>
                        <td style="font-weight:600;">${item.name}</td>
                        <td>${item.date === today ? '<span class="today-tag">TODAY</span>' : item.date}</td>
                        <td style="color:var(--gold); font-weight:bold;">₹${item.amount}</td>
                        <td>${item.instr}</td>
                    </tr>`;

                    allHtml += row;

                    if(item.date === today) {
                        tCount++;
                        tAmt += parseFloat(item.amount.toString().replace(/,/g, '')) || 0;
                        todayHtml += row;
                    }
                });

                document.getElementById('allResults').innerHTML = allHtml;
                document.getElementById('todayResults').innerHTML = todayHtml;
                document.getElementById('todaySection').style.display = todayHtml ? 'block' : 'none';
                document.getElementById('tCount').innerText = tCount;
                document.getElementById('tAmt').innerText = "₹" + tAmt.toLocaleString('en-IN');

            } catch (err) {
                alert("Error fetching data!");
            } finally {
                loader.style.display = 'none';
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
